---
interface Props {
  title: string;
  subtitle?: string;
  overline?: string;
  showStats?: boolean;
  showButtons?: boolean;
  primaryButton?: { text: string; href: string };
  secondaryButton?: { text: string; href: string };
  compact?: boolean;
}

const {
  title,
  subtitle,
  overline,
  showStats = false,
  showButtons = false,
  primaryButton,
  secondaryButton,
  compact = false
} = Astro.props;

const heroClass = compact ? 'hero hero-compact' : 'hero';
---

<section class={heroClass} aria-label="Hero section">
  <div class="hero-bg-grid" aria-hidden="true"></div>
  <canvas id="particle-canvas" aria-hidden="true"></canvas>
  <div class="container hero-content">
    {overline && <div class="hero-overline">{overline}</div>}
    <h1 set:html={title}></h1>
    {subtitle && <p class="subtitle" set:html={subtitle}></p>}
    {showButtons && (primaryButton || secondaryButton) && (
      <div class="hero-buttons">
        {primaryButton && <a href={primaryButton.href} class="btn-primary">{primaryButton.text}</a>}
        {secondaryButton && <a href={secondaryButton.href} class="btn-secondary">{secondaryButton.text}</a>}
      </div>
    )}
    {showStats && (
      <div class="hero-stats">
        <div class="hero-stat">
          <span class="hero-stat-number">20+</span>
          <span class="hero-stat-label">Years Experience</span>
        </div>
        <div class="hero-stat">
          <span class="hero-stat-number">TS/SCI</span>
          <span class="hero-stat-label">Clearances</span>
        </div>
        <div class="hero-stat">
          <span class="hero-stat-number">100%</span>
          <span class="hero-stat-label">Operator-Led</span>
        </div>
        <div class="hero-stat">
          <span class="hero-stat-number">1000+</span>
          <span class="hero-stat-label">Real-World Operations</span>
        </div>
      </div>
    )}
  </div>
</section>
