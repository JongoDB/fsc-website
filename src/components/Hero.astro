---
interface Props {
  title: string;
  subtitle?: string;
  overline?: string;
  showStats?: boolean;
  showButtons?: boolean;
  primaryButton?: { text: string; href: string };
  secondaryButton?: { text: string; href: string };
  compact?: boolean;
}

const {
  title,
  subtitle,
  overline,
  showStats = false,
  showButtons = false,
  primaryButton,
  secondaryButton,
  compact = false
} = Astro.props;

const heroClass = compact ? 'hero hero-compact' : 'hero';
---

<section class={heroClass} aria-label="Hero section">
  <!-- Animated gradient mesh background -->
  <div class="hero-gradient-mesh" aria-hidden="true">
    <div class="gradient-blob blob-1"></div>
    <div class="gradient-blob blob-2"></div>
    <div class="gradient-blob blob-3"></div>
  </div>

  <!-- Floating geometric shapes -->
  <div class="hero-shapes" aria-hidden="true">
    <svg class="shape shape-hex" viewBox="0 0 100 100" fill="none">
      <polygon points="50,2 93,25 93,75 50,98 7,75 7,25" stroke="rgba(0,168,255,0.12)" stroke-width="1"/>
    </svg>
    <svg class="shape shape-circle" viewBox="0 0 100 100" fill="none">
      <circle cx="50" cy="50" r="40" stroke="rgba(0,212,255,0.08)" stroke-width="1"/>
    </svg>
    <svg class="shape shape-diamond" viewBox="0 0 100 100" fill="none">
      <rect x="20" y="20" width="60" height="60" rx="4" stroke="rgba(0,168,255,0.1)" stroke-width="1" transform="rotate(45 50 50)"/>
    </svg>
    <svg class="shape shape-ring" viewBox="0 0 100 100" fill="none">
      <circle cx="50" cy="50" r="30" stroke="rgba(0,212,255,0.06)" stroke-width="0.5"/>
      <circle cx="50" cy="50" r="45" stroke="rgba(0,168,255,0.04)" stroke-width="0.5"/>
    </svg>
    <svg class="shape shape-nodes" viewBox="0 0 200 200" fill="none">
      <circle cx="40" cy="40" r="3" fill="rgba(0,168,255,0.2)"/>
      <circle cx="160" cy="60" r="2" fill="rgba(0,212,255,0.15)"/>
      <circle cx="100" cy="150" r="2.5" fill="rgba(0,168,255,0.18)"/>
      <line x1="40" y1="40" x2="160" y2="60" stroke="rgba(0,168,255,0.06)" stroke-width="0.5"/>
      <line x1="160" y1="60" x2="100" y2="150" stroke="rgba(0,212,255,0.05)" stroke-width="0.5"/>
      <line x1="100" y1="150" x2="40" y2="40" stroke="rgba(0,168,255,0.04)" stroke-width="0.5"/>
    </svg>
  </div>

  <div class="hero-bg-grid" aria-hidden="true"></div>
  <div class="container hero-content">
    {overline && <div class="hero-overline">{overline}</div>}
    <h1 set:html={title}></h1>
    {subtitle && <p class="subtitle" set:html={subtitle}></p>}
    {showButtons && (primaryButton || secondaryButton) && (
      <div class="hero-buttons">
        {primaryButton && <a href={primaryButton.href} class="btn-primary">{primaryButton.text}</a>}
        {secondaryButton && <a href={secondaryButton.href} class="btn-secondary">{secondaryButton.text}</a>}
      </div>
    )}
    {showStats && (
      <div class="hero-stats">
        <div class="hero-stat">
          <span class="hero-stat-number">20+</span>
          <span class="hero-stat-label">Years Experience</span>
        </div>
        <div class="hero-stat">
          <span class="hero-stat-number">TS/SCI</span>
          <span class="hero-stat-label">Clearances</span>
        </div>
        <div class="hero-stat">
          <span class="hero-stat-number">100%</span>
          <span class="hero-stat-label">Operator-Led</span>
        </div>
        <div class="hero-stat">
          <span class="hero-stat-number">1000+</span>
          <span class="hero-stat-label">Real-World Operations</span>
        </div>
      </div>
    )}
  </div>
</section>
