---
// Radar-style capability map with FSC logo center
// Words highlight when the sweep line passes through their sector
---
<div class="section-illustration illustration-large">
  <svg viewBox="0 0 440 380" fill="none" xmlns="http://www.w3.org/2000/svg">
    <!-- Concentric radar rings -->
    <circle cx="220" cy="190" r="160" stroke="rgba(0,168,255,0.06)" stroke-width="0.5"/>
    <circle cx="220" cy="190" r="120" stroke="rgba(0,168,255,0.08)" stroke-width="0.5"/>
    <circle cx="220" cy="190" r="80" stroke="rgba(0,168,255,0.1)" stroke-width="0.5"/>
    <circle cx="220" cy="190" r="40" stroke="rgba(0,168,255,0.12)" stroke-width="0.5"/>

    <!-- Sector divider lines (crosshair) -->
    <line x1="220" y1="28" x2="220" y2="352" stroke="rgba(0,168,255,0.04)" stroke-width="0.5"/>
    <line x1="58" y1="190" x2="382" y2="190" stroke="rgba(0,168,255,0.04)" stroke-width="0.5"/>

    <!-- Sweep line with glow trail -->
    <g class="radar-sweep">
      <!-- Cone/trail behind the sweep -->
      <path d="M220 190 L220 28 A162 162 0 0 1 350 100 Z" fill="url(#sweepCone)" opacity="0.5"/>
      <!-- Main sweep line -->
      <line x1="220" y1="190" x2="220" y2="28" stroke="url(#sweepLine)" stroke-width="1.5"/>
    </g>

    <!-- Capability markers on the middle ring -->
    <!-- TRAIN - top (12 o'clock) -->
    <g class="radar-word radar-word-train">
      <circle cx="220" cy="70" r="10" fill="rgba(0,168,255,0.06)" stroke="rgba(0,168,255,0.15)" stroke-width="1"/>
      <text x="220" y="50" text-anchor="middle" class="radar-label" font-size="11" font-weight="700" font-family="Inter, sans-serif">TRAIN</text>
    </g>

    <!-- DEPLOY - right (3 o'clock) -->
    <g class="radar-word radar-word-deploy">
      <circle cx="340" cy="190" r="10" fill="rgba(0,168,255,0.06)" stroke="rgba(0,168,255,0.15)" stroke-width="1"/>
      <text x="365" y="194" text-anchor="start" class="radar-label" font-size="11" font-weight="700" font-family="Inter, sans-serif">DEPLOY</text>
    </g>

    <!-- DEFEND - bottom (6 o'clock) -->
    <g class="radar-word radar-word-defend">
      <circle cx="220" cy="310" r="10" fill="rgba(0,168,255,0.06)" stroke="rgba(0,168,255,0.15)" stroke-width="1"/>
      <text x="220" y="336" text-anchor="middle" class="radar-label" font-size="11" font-weight="700" font-family="Inter, sans-serif">DEFEND</text>
    </g>

    <!-- ADVISE - left (9 o'clock) -->
    <g class="radar-word radar-word-advise">
      <circle cx="100" cy="190" r="10" fill="rgba(0,168,255,0.06)" stroke="rgba(0,168,255,0.15)" stroke-width="1"/>
      <text x="75" y="194" text-anchor="end" class="radar-label" font-size="11" font-weight="700" font-family="Inter, sans-serif">ADVISE</text>
    </g>

    <!-- Scatter dots on rings for texture -->
    <circle cx="270" cy="85" r="2.5" fill="rgba(0,168,255,0.2)"/>
    <circle cx="325" cy="130" r="2" fill="rgba(0,212,255,0.18)"/>
    <circle cx="340" cy="250" r="2.5" fill="rgba(0,168,255,0.15)"/>
    <circle cx="280" cy="300" r="2" fill="rgba(0,212,255,0.18)"/>
    <circle cx="160" cy="295" r="2.5" fill="rgba(0,168,255,0.15)"/>
    <circle cx="110" cy="130" r="2" fill="rgba(0,212,255,0.18)"/>
    <circle cx="165" cy="80" r="2" fill="rgba(0,168,255,0.2)"/>
    <circle cx="115" cy="245" r="2" fill="rgba(0,212,255,0.15)"/>

    <!-- Connection arcs between capabilities -->
    <path d="M230 70 Q 310 100 340 180" stroke="rgba(0,168,255,0.06)" stroke-width="0.6" fill="none"/>
    <path d="M340 200 Q 310 280 230 310" stroke="rgba(0,212,255,0.05)" stroke-width="0.6" fill="none"/>
    <path d="M210 310 Q 130 280 100 200" stroke="rgba(0,168,255,0.06)" stroke-width="0.6" fill="none"/>
    <path d="M100 180 Q 130 100 210 70" stroke="rgba(0,212,255,0.05)" stroke-width="0.6" fill="none"/>

    <!-- Center: FSC logo -->
    <circle cx="220" cy="190" r="32" fill="rgba(0,10,20,0.6)" stroke="rgba(0,168,255,0.25)" stroke-width="1.5"/>
    <image href="/images/brand/white.png" x="194" y="175" width="52" height="30" opacity="0.85"/>

    <!-- Pulsing ring around center -->
    <circle cx="220" cy="190" r="36" fill="none" stroke="rgba(0,168,255,0.2)" stroke-width="0.5">
      <animate attributeName="r" values="36;42;36" dur="3s" repeatCount="indefinite"/>
      <animate attributeName="opacity" values="0.3;0;0.3" dur="3s" repeatCount="indefinite"/>
    </circle>

    <defs>
      <linearGradient id="sweepLine" x1="220" y1="190" x2="220" y2="28" gradientUnits="userSpaceOnUse">
        <stop offset="0%" stop-color="#00a8ff" stop-opacity="0"/>
        <stop offset="100%" stop-color="#00a8ff" stop-opacity="0.6"/>
      </linearGradient>
      <radialGradient id="sweepCone" cx="220" cy="190" r="162" gradientUnits="userSpaceOnUse">
        <stop offset="0%" stop-color="#00a8ff" stop-opacity="0"/>
        <stop offset="70%" stop-color="#00a8ff" stop-opacity="0.06"/>
        <stop offset="100%" stop-color="#00a8ff" stop-opacity="0.03"/>
      </radialGradient>
    </defs>
  </svg>
</div>

<style>
  /* Sweep rotation - 8s full revolution */
  .radar-sweep {
    transform-origin: 220px 190px;
    animation: radarSweep 8s linear infinite;
  }

  @keyframes radarSweep {
    from { transform: rotate(0deg); }
    to { transform: rotate(360deg); }
  }

  /* Base state: all words dim */
  .radar-label {
    fill: rgba(0, 168, 255, 0.25);
    transition: fill 0.3s ease;
  }

  .radar-word circle {
    transition: all 0.3s ease;
  }

  /* Highlight animation for each word - synced to 8s sweep */
  /* TRAIN at 12 o'clock = sweep at 0°, highlighted ~0-2s of 8s cycle */
  .radar-word-train .radar-label {
    animation: highlightTrain 8s linear infinite;
  }
  .radar-word-train circle {
    animation: glowTrain 8s linear infinite;
  }

  /* DEPLOY at 3 o'clock = sweep at 90°, highlighted ~2-4s */
  .radar-word-deploy .radar-label {
    animation: highlightDeploy 8s linear infinite;
  }
  .radar-word-deploy circle {
    animation: glowDeploy 8s linear infinite;
  }

  /* DEFEND at 6 o'clock = sweep at 180°, highlighted ~4-6s */
  .radar-word-defend .radar-label {
    animation: highlightDefend 8s linear infinite;
  }
  .radar-word-defend circle {
    animation: glowDefend 8s linear infinite;
  }

  /* ADVISE at 9 o'clock = sweep at 270°, highlighted ~6-8s */
  .radar-word-advise .radar-label {
    animation: highlightAdvise 8s linear infinite;
  }
  .radar-word-advise circle {
    animation: glowAdvise 8s linear infinite;
  }

  /* TRAIN: peaks at 0% (0s) */
  @keyframes highlightTrain {
    0%, 3%   { fill: rgba(0, 168, 255, 0.9); }
    15%, 90% { fill: rgba(0, 168, 255, 0.25); }
    97%      { fill: rgba(0, 168, 255, 0.5); }
  }
  @keyframes glowTrain {
    0%, 3%   { stroke: rgba(0, 168, 255, 0.6); fill: rgba(0, 168, 255, 0.15); }
    15%, 90% { stroke: rgba(0, 168, 255, 0.15); fill: rgba(0, 168, 255, 0.06); }
    97%      { stroke: rgba(0, 168, 255, 0.3); fill: rgba(0, 168, 255, 0.1); }
  }

  /* DEPLOY: peaks at 25% (2s) */
  @keyframes highlightDeploy {
    0%, 15%  { fill: rgba(0, 168, 255, 0.25); }
    22%, 28% { fill: rgba(0, 168, 255, 0.9); }
    40%,100% { fill: rgba(0, 168, 255, 0.25); }
  }
  @keyframes glowDeploy {
    0%, 15%  { stroke: rgba(0, 168, 255, 0.15); fill: rgba(0, 168, 255, 0.06); }
    22%, 28% { stroke: rgba(0, 168, 255, 0.6); fill: rgba(0, 168, 255, 0.15); }
    40%,100% { stroke: rgba(0, 168, 255, 0.15); fill: rgba(0, 168, 255, 0.06); }
  }

  /* DEFEND: peaks at 50% (4s) */
  @keyframes highlightDefend {
    0%, 40%  { fill: rgba(0, 168, 255, 0.25); }
    47%, 53% { fill: rgba(0, 168, 255, 0.9); }
    65%,100% { fill: rgba(0, 168, 255, 0.25); }
  }
  @keyframes glowDefend {
    0%, 40%  { stroke: rgba(0, 168, 255, 0.15); fill: rgba(0, 168, 255, 0.06); }
    47%, 53% { stroke: rgba(0, 168, 255, 0.6); fill: rgba(0, 168, 255, 0.15); }
    65%,100% { stroke: rgba(0, 168, 255, 0.15); fill: rgba(0, 168, 255, 0.06); }
  }

  /* ADVISE: peaks at 75% (6s) */
  @keyframes highlightAdvise {
    0%, 65%  { fill: rgba(0, 168, 255, 0.25); }
    72%, 78% { fill: rgba(0, 168, 255, 0.9); }
    90%,100% { fill: rgba(0, 168, 255, 0.25); }
  }
  @keyframes glowAdvise {
    0%, 65%  { stroke: rgba(0, 168, 255, 0.15); fill: rgba(0, 168, 255, 0.06); }
    72%, 78% { stroke: rgba(0, 168, 255, 0.6); fill: rgba(0, 168, 255, 0.15); }
    90%,100% { stroke: rgba(0, 168, 255, 0.15); fill: rgba(0, 168, 255, 0.06); }
  }

  @media (prefers-reduced-motion: reduce) {
    .radar-sweep,
    .radar-word-train .radar-label,
    .radar-word-deploy .radar-label,
    .radar-word-defend .radar-label,
    .radar-word-advise .radar-label,
    .radar-word-train circle,
    .radar-word-deploy circle,
    .radar-word-defend circle,
    .radar-word-advise circle {
      animation: none !important;
    }
    .radar-label {
      fill: rgba(0, 168, 255, 0.6) !important;
    }
  }
</style>
