---
// Radar-style capability map with FSC logo center
// Words highlight when the sweep line passes through their sector
---
<div class="section-illustration illustration-large">
  <svg viewBox="0 0 440 380" fill="none" xmlns="http://www.w3.org/2000/svg">
    <!-- Outer glow -->
    <circle cx="220" cy="190" r="170" fill="url(#radarGlow)" opacity="0.12"/>

    <!-- Concentric radar rings - more visible -->
    <circle cx="220" cy="190" r="160" stroke="rgba(0,168,255,0.1)" stroke-width="1"/>
    <circle cx="220" cy="190" r="120" stroke="rgba(0,168,255,0.14)" stroke-width="1"/>
    <circle cx="220" cy="190" r="80" stroke="rgba(0,168,255,0.18)" stroke-width="1"/>
    <circle cx="220" cy="190" r="40" stroke="rgba(0,168,255,0.22)" stroke-width="1"/>

    <!-- Sector divider lines (crosshair) - brighter -->
    <line x1="220" y1="28" x2="220" y2="352" stroke="rgba(0,168,255,0.08)" stroke-width="0.8"/>
    <line x1="58" y1="190" x2="382" y2="190" stroke="rgba(0,168,255,0.08)" stroke-width="0.8"/>
    <!-- Diagonal crosshairs for extra detail -->
    <line x1="107" y1="77" x2="333" y2="303" stroke="rgba(0,168,255,0.04)" stroke-width="0.5"/>
    <line x1="333" y1="77" x2="107" y2="303" stroke="rgba(0,168,255,0.04)" stroke-width="0.5"/>

    <!-- Tick marks on rings -->
    <g stroke="rgba(0,168,255,0.15)" stroke-width="1">
      <!-- Outer ring ticks -->
      <line x1="220" y1="28" x2="220" y2="38"/>
      <line x1="220" y1="342" x2="220" y2="352"/>
      <line x1="58" y1="190" x2="68" y2="190"/>
      <line x1="372" y1="190" x2="382" y2="190"/>
    </g>

    <!-- Sweep line with bright glow trail -->
    <g class="radar-sweep">
      <!-- Wide glow cone behind the sweep -->
      <path d="M220 190 L220 28 A162 162 0 0 1 380 140 Z" fill="url(#sweepConeWide)" opacity="0.3"/>
      <!-- Tight bright cone -->
      <path d="M220 190 L220 28 A162 162 0 0 1 320 80 Z" fill="url(#sweepConeTight)" opacity="0.5"/>
      <!-- Main sweep line - brighter -->
      <line x1="220" y1="190" x2="220" y2="28" stroke="url(#sweepLine)" stroke-width="2"/>
      <!-- Sweep tip glow -->
      <circle cx="220" cy="28" r="4" fill="#00a8ff" opacity="0.6"/>
    </g>

    <!-- Capability markers - larger, more prominent -->
    <!-- TRAIN - top (12 o'clock) -->
    <g class="radar-word radar-word-train">
      <circle cx="220" cy="70" r="14" fill="rgba(0,168,255,0.08)" stroke="rgba(0,168,255,0.2)" stroke-width="1.5"/>
      <circle cx="220" cy="70" r="3" class="radar-dot" fill="#00a8ff" opacity="0.5"/>
      <text x="220" y="44" text-anchor="middle" class="radar-label" font-size="12" font-weight="800" font-family="Inter, sans-serif" letter-spacing="1.5">TRAIN</text>
    </g>

    <!-- DEPLOY - right (3 o'clock) -->
    <g class="radar-word radar-word-deploy">
      <circle cx="340" cy="190" r="14" fill="rgba(0,168,255,0.08)" stroke="rgba(0,168,255,0.2)" stroke-width="1.5"/>
      <circle cx="340" cy="190" r="3" class="radar-dot" fill="#00a8ff" opacity="0.5"/>
      <text x="368" y="194" text-anchor="start" class="radar-label" font-size="12" font-weight="800" font-family="Inter, sans-serif" letter-spacing="1.5">DEPLOY</text>
    </g>

    <!-- DEFEND - bottom (6 o'clock) -->
    <g class="radar-word radar-word-defend">
      <circle cx="220" cy="310" r="14" fill="rgba(0,168,255,0.08)" stroke="rgba(0,168,255,0.2)" stroke-width="1.5"/>
      <circle cx="220" cy="310" r="3" class="radar-dot" fill="#00a8ff" opacity="0.5"/>
      <text x="220" y="340" text-anchor="middle" class="radar-label" font-size="12" font-weight="800" font-family="Inter, sans-serif" letter-spacing="1.5">DEFEND</text>
    </g>

    <!-- ADVISE - left (9 o'clock) -->
    <g class="radar-word radar-word-advise">
      <circle cx="100" cy="190" r="14" fill="rgba(0,168,255,0.08)" stroke="rgba(0,168,255,0.2)" stroke-width="1.5"/>
      <circle cx="100" cy="190" r="3" class="radar-dot" fill="#00a8ff" opacity="0.5"/>
      <text x="72" y="194" text-anchor="end" class="radar-label" font-size="12" font-weight="800" font-family="Inter, sans-serif" letter-spacing="1.5">ADVISE</text>
    </g>

    <!-- Scatter dots on rings - brighter, more of them -->
    <circle cx="270" cy="85" r="3" fill="rgba(0,168,255,0.3)"/>
    <circle cx="325" cy="130" r="2.5" fill="rgba(0,212,255,0.25)"/>
    <circle cx="348" cy="245" r="2" fill="rgba(0,168,255,0.2)"/>
    <circle cx="290" cy="305" r="3" fill="rgba(0,212,255,0.25)"/>
    <circle cx="150" cy="300" r="2.5" fill="rgba(0,168,255,0.2)"/>
    <circle cx="95" cy="135" r="2" fill="rgba(0,212,255,0.25)"/>
    <circle cx="165" cy="75" r="2.5" fill="rgba(0,168,255,0.3)"/>
    <circle cx="110" cy="250" r="2" fill="rgba(0,212,255,0.2)"/>
    <circle cx="305" cy="85" r="2" fill="rgba(0,168,255,0.2)"/>
    <circle cx="160" cy="130" r="1.5" fill="rgba(0,212,255,0.15)"/>
    <circle cx="280" cy="260" r="1.5" fill="rgba(0,168,255,0.15)"/>
    <circle cx="140" cy="240" r="2" fill="rgba(0,212,255,0.18)"/>

    <!-- Animated ping dots that ripple outward from random positions -->
    <circle cx="270" cy="85" r="3" fill="none" stroke="rgba(0,168,255,0.3)" stroke-width="0.8">
      <animate attributeName="r" values="3;12;3" dur="4s" repeatCount="indefinite"/>
      <animate attributeName="opacity" values="0.4;0;0.4" dur="4s" repeatCount="indefinite"/>
    </circle>
    <circle cx="150" cy="300" r="3" fill="none" stroke="rgba(0,212,255,0.25)" stroke-width="0.8">
      <animate attributeName="r" values="3;10;3" dur="5s" begin="1.5s" repeatCount="indefinite"/>
      <animate attributeName="opacity" values="0.3;0;0.3" dur="5s" begin="1.5s" repeatCount="indefinite"/>
    </circle>
    <circle cx="325" cy="130" r="2" fill="none" stroke="rgba(0,168,255,0.2)" stroke-width="0.5">
      <animate attributeName="r" values="2;8;2" dur="3.5s" begin="3s" repeatCount="indefinite"/>
      <animate attributeName="opacity" values="0.3;0;0.3" dur="3.5s" begin="3s" repeatCount="indefinite"/>
    </circle>

    <!-- Connection arcs between capabilities - brighter -->
    <path d="M230 70 Q 310 100 340 180" stroke="rgba(0,168,255,0.1)" stroke-width="1" fill="none"/>
    <path d="M340 200 Q 310 280 230 310" stroke="rgba(0,212,255,0.08)" stroke-width="1" fill="none"/>
    <path d="M210 310 Q 130 280 100 200" stroke="rgba(0,168,255,0.1)" stroke-width="1" fill="none"/>
    <path d="M100 180 Q 130 100 210 70" stroke="rgba(0,212,255,0.08)" stroke-width="1" fill="none"/>

    <!-- Data flow dots moving along arcs -->
    <circle r="2" fill="#00a8ff" opacity="0.6">
      <animateMotion dur="6s" repeatCount="indefinite" path="M230 70 Q 310 100 340 180"/>
    </circle>
    <circle r="2" fill="#00d4ff" opacity="0.5">
      <animateMotion dur="7s" repeatCount="indefinite" begin="2s" path="M340 200 Q 310 280 230 310"/>
    </circle>
    <circle r="1.5" fill="#00a8ff" opacity="0.5">
      <animateMotion dur="8s" repeatCount="indefinite" begin="4s" path="M100 180 Q 130 100 210 70"/>
    </circle>

    <!-- Center: FSC logo with enhanced ring -->
    <circle cx="220" cy="190" r="36" fill="rgba(0,10,20,0.8)" stroke="rgba(0,168,255,0.35)" stroke-width="2"/>
    <circle cx="220" cy="190" r="32" fill="none" stroke="rgba(0,168,255,0.12)" stroke-width="0.5"/>
    <image href="/images/brand/white.png" x="194" y="175" width="52" height="30" opacity="0.9"/>

    <!-- Pulsing rings around center - double ring -->
    <circle cx="220" cy="190" r="36" fill="none" stroke="rgba(0,168,255,0.25)" stroke-width="1">
      <animate attributeName="r" values="36;48;36" dur="3s" repeatCount="indefinite"/>
      <animate attributeName="opacity" values="0.3;0;0.3" dur="3s" repeatCount="indefinite"/>
    </circle>
    <circle cx="220" cy="190" r="36" fill="none" stroke="rgba(0,212,255,0.15)" stroke-width="0.5">
      <animate attributeName="r" values="36;56;36" dur="3s" begin="0.5s" repeatCount="indefinite"/>
      <animate attributeName="opacity" values="0.2;0;0.2" dur="3s" begin="0.5s" repeatCount="indefinite"/>
    </circle>

    <!-- Corner coordinate labels for military feel -->
    <text x="66" y="46" fill="rgba(0,168,255,0.2)" font-size="7" font-family="monospace">00:00</text>
    <text x="354" y="46" fill="rgba(0,168,255,0.2)" font-size="7" font-family="monospace">23:59</text>
    <text x="66" y="365" fill="rgba(0,168,255,0.15)" font-size="7" font-family="monospace">GRID:04</text>
    <text x="345" y="365" fill="rgba(0,168,255,0.15)" font-size="7" font-family="monospace">SEC:HIGH</text>

    <defs>
      <linearGradient id="sweepLine" x1="220" y1="190" x2="220" y2="28" gradientUnits="userSpaceOnUse">
        <stop offset="0%" stop-color="#00a8ff" stop-opacity="0"/>
        <stop offset="30%" stop-color="#00a8ff" stop-opacity="0.3"/>
        <stop offset="100%" stop-color="#00d4ff" stop-opacity="0.8"/>
      </linearGradient>
      <radialGradient id="sweepConeWide" cx="220" cy="190" r="162" gradientUnits="userSpaceOnUse">
        <stop offset="0%" stop-color="#00a8ff" stop-opacity="0"/>
        <stop offset="60%" stop-color="#00a8ff" stop-opacity="0.06"/>
        <stop offset="100%" stop-color="#00a8ff" stop-opacity="0.02"/>
      </radialGradient>
      <radialGradient id="sweepConeTight" cx="220" cy="190" r="162" gradientUnits="userSpaceOnUse">
        <stop offset="0%" stop-color="#00d4ff" stop-opacity="0"/>
        <stop offset="50%" stop-color="#00a8ff" stop-opacity="0.1"/>
        <stop offset="100%" stop-color="#00d4ff" stop-opacity="0.04"/>
      </radialGradient>
      <radialGradient id="radarGlow">
        <stop offset="0%" stop-color="#00a8ff" stop-opacity="0.15"/>
        <stop offset="100%" stop-color="#00a8ff" stop-opacity="0"/>
      </radialGradient>
    </defs>
  </svg>
</div>

<style>
  /* Sweep rotation - 8s full revolution */
  .radar-sweep {
    transform-origin: 220px 190px;
    animation: radarSweep 8s linear infinite;
  }

  @keyframes radarSweep {
    from { transform: rotate(0deg); }
    to { transform: rotate(360deg); }
  }

  /* Base state: all words dim but more visible than before */
  .radar-label {
    fill: rgba(0, 168, 255, 0.3);
    transition: fill 0.3s ease;
  }

  .radar-dot {
    transition: opacity 0.3s ease;
  }

  .radar-word circle {
    transition: all 0.3s ease;
  }

  /* TRAIN: peaks at 0% (0s) */
  .radar-word-train .radar-label {
    animation: highlightTrain 8s linear infinite;
  }
  .radar-word-train circle:first-of-type {
    animation: glowTrain 8s linear infinite;
  }
  .radar-word-train .radar-dot {
    animation: dotTrain 8s linear infinite;
  }

  /* DEPLOY: peaks at 25% (2s) */
  .radar-word-deploy .radar-label {
    animation: highlightDeploy 8s linear infinite;
  }
  .radar-word-deploy circle:first-of-type {
    animation: glowDeploy 8s linear infinite;
  }
  .radar-word-deploy .radar-dot {
    animation: dotDeploy 8s linear infinite;
  }

  /* DEFEND: peaks at 50% (4s) */
  .radar-word-defend .radar-label {
    animation: highlightDefend 8s linear infinite;
  }
  .radar-word-defend circle:first-of-type {
    animation: glowDefend 8s linear infinite;
  }
  .radar-word-defend .radar-dot {
    animation: dotDefend 8s linear infinite;
  }

  /* ADVISE: peaks at 75% (6s) */
  .radar-word-advise .radar-label {
    animation: highlightAdvise 8s linear infinite;
  }
  .radar-word-advise circle:first-of-type {
    animation: glowAdvise 8s linear infinite;
  }
  .radar-word-advise .radar-dot {
    animation: dotAdvise 8s linear infinite;
  }

  /* TRAIN: peaks at 0% */
  @keyframes highlightTrain {
    0%, 3%   { fill: #00d4ff; }
    15%, 90% { fill: rgba(0, 168, 255, 0.3); }
    97%      { fill: rgba(0, 168, 255, 0.6); }
  }
  @keyframes glowTrain {
    0%, 3%   { stroke: #00d4ff; stroke-width: 2; fill: rgba(0, 168, 255, 0.2); }
    15%, 90% { stroke: rgba(0, 168, 255, 0.2); stroke-width: 1.5; fill: rgba(0, 168, 255, 0.08); }
    97%      { stroke: rgba(0, 168, 255, 0.4); fill: rgba(0, 168, 255, 0.12); }
  }
  @keyframes dotTrain {
    0%, 3%   { opacity: 1; }
    15%, 90% { opacity: 0.5; }
    97%      { opacity: 0.7; }
  }

  /* DEPLOY: peaks at 25% */
  @keyframes highlightDeploy {
    0%, 15%  { fill: rgba(0, 168, 255, 0.3); }
    22%, 28% { fill: #00d4ff; }
    40%,100% { fill: rgba(0, 168, 255, 0.3); }
  }
  @keyframes glowDeploy {
    0%, 15%  { stroke: rgba(0, 168, 255, 0.2); stroke-width: 1.5; fill: rgba(0, 168, 255, 0.08); }
    22%, 28% { stroke: #00d4ff; stroke-width: 2; fill: rgba(0, 168, 255, 0.2); }
    40%,100% { stroke: rgba(0, 168, 255, 0.2); stroke-width: 1.5; fill: rgba(0, 168, 255, 0.08); }
  }
  @keyframes dotDeploy {
    0%, 15%  { opacity: 0.5; }
    22%, 28% { opacity: 1; }
    40%,100% { opacity: 0.5; }
  }

  /* DEFEND: peaks at 50% */
  @keyframes highlightDefend {
    0%, 40%  { fill: rgba(0, 168, 255, 0.3); }
    47%, 53% { fill: #00d4ff; }
    65%,100% { fill: rgba(0, 168, 255, 0.3); }
  }
  @keyframes glowDefend {
    0%, 40%  { stroke: rgba(0, 168, 255, 0.2); stroke-width: 1.5; fill: rgba(0, 168, 255, 0.08); }
    47%, 53% { stroke: #00d4ff; stroke-width: 2; fill: rgba(0, 168, 255, 0.2); }
    65%,100% { stroke: rgba(0, 168, 255, 0.2); stroke-width: 1.5; fill: rgba(0, 168, 255, 0.08); }
  }
  @keyframes dotDefend {
    0%, 40%  { opacity: 0.5; }
    47%, 53% { opacity: 1; }
    65%,100% { opacity: 0.5; }
  }

  /* ADVISE: peaks at 75% */
  @keyframes highlightAdvise {
    0%, 65%  { fill: rgba(0, 168, 255, 0.3); }
    72%, 78% { fill: #00d4ff; }
    90%,100% { fill: rgba(0, 168, 255, 0.3); }
  }
  @keyframes glowAdvise {
    0%, 65%  { stroke: rgba(0, 168, 255, 0.2); stroke-width: 1.5; fill: rgba(0, 168, 255, 0.08); }
    72%, 78% { stroke: #00d4ff; stroke-width: 2; fill: rgba(0, 168, 255, 0.2); }
    90%,100% { stroke: rgba(0, 168, 255, 0.2); stroke-width: 1.5; fill: rgba(0, 168, 255, 0.08); }
  }
  @keyframes dotAdvise {
    0%, 65%  { opacity: 0.5; }
    72%, 78% { opacity: 1; }
    90%,100% { opacity: 0.5; }
  }

  @media (prefers-reduced-motion: reduce) {
    .radar-sweep,
    .radar-word-train .radar-label,
    .radar-word-deploy .radar-label,
    .radar-word-defend .radar-label,
    .radar-word-advise .radar-label,
    .radar-word-train circle,
    .radar-word-deploy circle,
    .radar-word-defend circle,
    .radar-word-advise circle,
    .radar-word-train .radar-dot,
    .radar-word-deploy .radar-dot,
    .radar-word-defend .radar-dot,
    .radar-word-advise .radar-dot {
      animation: none !important;
    }
    .radar-label {
      fill: rgba(0, 168, 255, 0.7) !important;
    }
    .radar-dot {
      opacity: 0.8 !important;
    }
  }
</style>
