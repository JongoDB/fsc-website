---
// Network topology / operator command graph - represents expertise and reach
---
<div class="section-illustration illustration-network">
  <svg viewBox="0 0 400 360" fill="none" xmlns="http://www.w3.org/2000/svg">
    <!-- Background subtle grid -->
    <pattern id="gridPattern" x="0" y="0" width="40" height="40" patternUnits="userSpaceOnUse">
      <line x1="0" y1="0" x2="40" y2="0" stroke="rgba(0,168,255,0.03)" stroke-width="0.5"/>
      <line x1="0" y1="0" x2="0" y2="40" stroke="rgba(0,168,255,0.03)" stroke-width="0.5"/>
    </pattern>
    <rect width="400" height="360" fill="url(#gridPattern)" rx="16"/>

    <!-- Connection lines (drawn first, behind nodes) -->
    <line x1="200" y1="80" x2="100" y2="160" stroke="url(#lineGrad)" stroke-width="1.5"/>
    <line x1="200" y1="80" x2="300" y2="160" stroke="url(#lineGrad)" stroke-width="1.5"/>
    <line x1="100" y1="160" x2="60" y2="260" stroke="url(#lineGrad)" stroke-width="1"/>
    <line x1="100" y1="160" x2="160" y2="260" stroke="url(#lineGrad)" stroke-width="1"/>
    <line x1="300" y1="160" x2="240" y2="260" stroke="url(#lineGrad)" stroke-width="1"/>
    <line x1="300" y1="160" x2="340" y2="260" stroke="url(#lineGrad)" stroke-width="1"/>
    <!-- Cross connections -->
    <line x1="100" y1="160" x2="240" y2="260" stroke="rgba(0,168,255,0.06)" stroke-width="0.5" stroke-dasharray="4 4"/>
    <line x1="300" y1="160" x2="160" y2="260" stroke="rgba(0,212,255,0.06)" stroke-width="0.5" stroke-dasharray="4 4"/>

    <!-- Central command node -->
    <circle cx="200" cy="80" r="24" fill="rgba(0,168,255,0.1)" stroke="#00a8ff" stroke-width="2"/>
    <circle cx="200" cy="80" r="16" fill="rgba(0,168,255,0.15)"/>
    <text x="200" y="84" text-anchor="middle" fill="#00a8ff" font-size="12" font-weight="700" font-family="Inter, sans-serif">C2</text>

    <!-- Tier 2 nodes -->
    <circle cx="100" cy="160" r="18" fill="rgba(0,168,255,0.08)" stroke="rgba(0,168,255,0.4)" stroke-width="1.5"/>
    <text x="100" y="164" text-anchor="middle" fill="rgba(0,168,255,0.8)" font-size="9" font-weight="600" font-family="Inter, sans-serif">OPS</text>

    <circle cx="300" cy="160" r="18" fill="rgba(0,212,255,0.08)" stroke="rgba(0,212,255,0.4)" stroke-width="1.5"/>
    <text x="300" y="164" text-anchor="middle" fill="rgba(0,212,255,0.8)" font-size="9" font-weight="600" font-family="Inter, sans-serif">DEF</text>

    <!-- Tier 3 nodes (operational endpoints) -->
    <circle class="node-pulse" cx="60" cy="260" r="4" fill="#00a8ff"/>
    <circle class="node-pulse" cx="160" cy="260" r="4" fill="#00a8ff"/>
    <circle class="node-pulse" cx="240" cy="260" r="4" fill="#00d4ff"/>
    <circle class="node-pulse" cx="340" cy="260" r="4" fill="#00d4ff"/>

    <!-- Labels -->
    <text x="60" y="285" text-anchor="middle" fill="rgba(255,255,255,0.35)" font-size="8" font-family="Inter, sans-serif">SIEM</text>
    <text x="160" y="285" text-anchor="middle" fill="rgba(255,255,255,0.35)" font-size="8" font-family="Inter, sans-serif">EDR</text>
    <text x="240" y="285" text-anchor="middle" fill="rgba(255,255,255,0.35)" font-size="8" font-family="Inter, sans-serif">RANGE</text>
    <text x="340" y="285" text-anchor="middle" fill="rgba(255,255,255,0.35)" font-size="8" font-family="Inter, sans-serif">SOC</text>

    <!-- Status indicator dots -->
    <circle cx="60" cy="260" r="8" fill="none" stroke="rgba(0,168,255,0.15)" stroke-width="0.5">
      <animate attributeName="r" values="8;14;8" dur="3s" repeatCount="indefinite"/>
      <animate attributeName="opacity" values="0.4;0;0.4" dur="3s" repeatCount="indefinite"/>
    </circle>
    <circle cx="340" cy="260" r="8" fill="none" stroke="rgba(0,212,255,0.15)" stroke-width="0.5">
      <animate attributeName="r" values="8;14;8" dur="3s" begin="1s" repeatCount="indefinite"/>
      <animate attributeName="opacity" values="0.4;0;0.4" dur="3s" begin="1s" repeatCount="indefinite"/>
    </circle>

    <defs>
      <linearGradient id="lineGrad" x1="0%" y1="0%" x2="100%" y2="100%">
        <stop offset="0%" stop-color="#00a8ff" stop-opacity="0.3"/>
        <stop offset="100%" stop-color="#00d4ff" stop-opacity="0.15"/>
      </linearGradient>
    </defs>
  </svg>
</div>
