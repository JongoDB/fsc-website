---
// Animated cyber shield with DOTMLPF-P words orbiting around it
---
<div class="section-illustration illustration-shield">
  <svg viewBox="0 0 440 440" fill="none" xmlns="http://www.w3.org/2000/svg">
    <!-- Background glow -->
    <circle class="shield-glow" cx="220" cy="220" r="200" fill="url(#shieldGradient)" opacity="0.15"/>

    <!-- Outer orbit ring -->
    <circle cx="220" cy="220" r="190" stroke="rgba(0,168,255,0.06)" stroke-width="0.5" stroke-dasharray="4 6"/>

    <!-- Inner orbit ring -->
    <circle cx="220" cy="220" r="155" stroke="rgba(0,212,255,0.05)" stroke-width="0.5"/>

    <!-- DOTMLPF-P orbiting words - using animateTransform for rotation -->
    <!-- Orbit group that rotates -->
    <g>
      <animateTransform attributeName="transform" type="rotate" from="0 220 220" to="360 220 220" dur="60s" repeatCount="indefinite"/>

      <!-- D - Doctrine (top) -->
      <g transform="translate(220, 30)">
        <circle r="4" fill="rgba(0,168,255,0.3)"/>
        <text y="-10" text-anchor="middle" fill="rgba(0,168,255,0.7)" font-size="9" font-weight="600" font-family="Inter, sans-serif"
              transform="rotate(0)">Doctrine</text>
      </g>

      <!-- O - Organization (top-right) -->
      <g transform="translate(354, 86)">
        <circle r="3.5" fill="rgba(0,212,255,0.3)"/>
        <text y="-10" text-anchor="middle" fill="rgba(0,212,255,0.65)" font-size="9" font-weight="600" font-family="Inter, sans-serif">Organization</text>
      </g>

      <!-- T - Training (right) -->
      <g transform="translate(410, 220)">
        <circle r="4" fill="rgba(0,168,255,0.3)"/>
        <text y="-10" text-anchor="middle" fill="rgba(0,168,255,0.7)" font-size="9" font-weight="600" font-family="Inter, sans-serif">Training</text>
      </g>

      <!-- M - Materiel (bottom-right) -->
      <g transform="translate(354, 354)">
        <circle r="3.5" fill="rgba(0,212,255,0.3)"/>
        <text y="18" text-anchor="middle" fill="rgba(0,212,255,0.65)" font-size="9" font-weight="600" font-family="Inter, sans-serif">Materiel</text>
      </g>

      <!-- L - Leadership (bottom) -->
      <g transform="translate(220, 410)">
        <circle r="4" fill="rgba(0,168,255,0.3)"/>
        <text y="18" text-anchor="middle" fill="rgba(0,168,255,0.7)" font-size="9" font-weight="600" font-family="Inter, sans-serif">Leadership</text>
      </g>

      <!-- P - Personnel (bottom-left) -->
      <g transform="translate(86, 354)">
        <circle r="3.5" fill="rgba(0,212,255,0.3)"/>
        <text y="18" text-anchor="middle" fill="rgba(0,212,255,0.65)" font-size="9" font-weight="600" font-family="Inter, sans-serif">Personnel</text>
      </g>

      <!-- F - Facilities (left) -->
      <g transform="translate(30, 220)">
        <circle r="4" fill="rgba(0,168,255,0.3)"/>
        <text y="-10" text-anchor="middle" fill="rgba(0,168,255,0.7)" font-size="9" font-weight="600" font-family="Inter, sans-serif">Facilities</text>
      </g>

      <!-- P - Policy (top-left) -->
      <g transform="translate(86, 86)">
        <circle r="3.5" fill="rgba(0,212,255,0.3)"/>
        <text y="-10" text-anchor="middle" fill="rgba(0,212,255,0.65)" font-size="9" font-weight="600" font-family="Inter, sans-serif">Policy</text>
      </g>
    </g>

    <!-- Connection lines from orbit to shield (static, behind shield) -->
    <line x1="220" y1="40" x2="220" y2="100" stroke="rgba(0,168,255,0.08)" stroke-width="0.5"/>
    <line x1="347" y1="93" x2="295" y2="140" stroke="rgba(0,168,255,0.06)" stroke-width="0.5"/>
    <line x1="400" y1="220" x2="320" y2="220" stroke="rgba(0,168,255,0.08)" stroke-width="0.5"/>
    <line x1="347" y1="347" x2="295" y2="300" stroke="rgba(0,168,255,0.06)" stroke-width="0.5"/>
    <line x1="220" y1="400" x2="220" y2="340" stroke="rgba(0,168,255,0.08)" stroke-width="0.5"/>
    <line x1="93" y1="347" x2="145" y2="300" stroke="rgba(0,168,255,0.06)" stroke-width="0.5"/>
    <line x1="40" y1="220" x2="120" y2="220" stroke="rgba(0,168,255,0.08)" stroke-width="0.5"/>
    <line x1="93" y1="93" x2="145" y2="140" stroke="rgba(0,168,255,0.06)" stroke-width="0.5"/>

    <!-- Shield shape (centered) -->
    <path d="M220 100 L310 145 L310 250 C310 305 220 355 220 355 C220 355 130 305 130 250 L130 145 Z"
          fill="url(#shieldFill)" stroke="url(#shieldStroke)" stroke-width="2"/>

    <!-- Shield inner border -->
    <path d="M220 125 L290 160 L290 245 C290 288 220 330 220 330 C220 330 150 288 150 245 L150 160 Z"
          fill="none" stroke="rgba(0,168,255,0.12)" stroke-width="1"/>

    <!-- Checkmark inside shield -->
    <path d="M185 225 L210 250 L260 195" stroke="#00a8ff" stroke-width="4" stroke-linecap="round" stroke-linejoin="round" fill="none"/>

    <defs>
      <radialGradient id="shieldGradient">
        <stop offset="0%" stop-color="#00a8ff" stop-opacity="0.3"/>
        <stop offset="100%" stop-color="#00a8ff" stop-opacity="0"/>
      </radialGradient>
      <linearGradient id="shieldFill" x1="220" y1="100" x2="220" y2="355" gradientUnits="userSpaceOnUse">
        <stop offset="0%" stop-color="rgba(0,168,255,0.08)"/>
        <stop offset="100%" stop-color="rgba(0,168,255,0.02)"/>
      </linearGradient>
      <linearGradient id="shieldStroke" x1="130" y1="100" x2="310" y2="355" gradientUnits="userSpaceOnUse">
        <stop offset="0%" stop-color="#00a8ff" stop-opacity="0.5"/>
        <stop offset="50%" stop-color="#00d4ff" stop-opacity="0.3"/>
        <stop offset="100%" stop-color="#00a8ff" stop-opacity="0.5"/>
      </linearGradient>
    </defs>
  </svg>
</div>
