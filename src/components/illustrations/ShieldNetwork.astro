---
// Cyber shield with DOTMLPF-P words orbiting in a 3D Saturn-ring style
// Words pass behind the shield (clipped) and emerge on the other side
---
<div class="section-illustration illustration-shield">
  <svg viewBox="0 0 480 440" fill="none" xmlns="http://www.w3.org/2000/svg">
    <!-- Background glow -->
    <circle class="shield-glow" cx="240" cy="220" r="200" fill="url(#shieldGlow)" opacity="0.12"/>

    <!-- Faint concentric rings for depth -->
    <ellipse cx="240" cy="220" rx="210" ry="80" stroke="rgba(0,168,255,0.04)" stroke-width="0.5"/>
    <ellipse cx="240" cy="220" rx="180" ry="68" stroke="rgba(0,212,255,0.03)" stroke-width="0.5"/>

    <!-- === BACK ORBIT HALF (behind shield) === -->
    <!-- Orbit ellipse path for reference - tilted ring -->
    <ellipse cx="240" cy="230" rx="220" ry="85" stroke="rgba(0,168,255,0.06)" stroke-width="0.5" stroke-dasharray="3 5" transform="rotate(-8 240 230)"/>

    <!-- Back-half orbit words (clipped to only show behind shield area) -->
    <g clip-path="url(#behindShieldClip)">
      <g>
        <animateTransform attributeName="transform" type="rotate" from="0 240 230" to="360 240 230" dur="45s" repeatCount="indefinite"/>
        <!-- 8 words distributed around an elliptical path -->
        <!-- Using transform to place on ellipse: x = cx + rx*cos(angle), y = cy + ry*sin(angle) -->
        <!-- Rotated -8deg to match the orbit tilt -->
        <g transform="rotate(-8 240 230)">
          <text x="460" y="234" text-anchor="middle" fill="rgba(0,168,255,0.55)" font-size="10" font-weight="700" font-family="Inter, sans-serif">Doctrine</text>
          <text x="395" y="165" text-anchor="middle" fill="rgba(0,212,255,0.5)" font-size="10" font-weight="700" font-family="Inter, sans-serif">Organization</text>
          <text x="240" y="145" text-anchor="middle" fill="rgba(0,168,255,0.55)" font-size="10" font-weight="700" font-family="Inter, sans-serif">Training</text>
          <text x="85" y="165" text-anchor="middle" fill="rgba(0,212,255,0.5)" font-size="10" font-weight="700" font-family="Inter, sans-serif">Materiel</text>
          <text x="20" y="234" text-anchor="middle" fill="rgba(0,168,255,0.55)" font-size="10" font-weight="700" font-family="Inter, sans-serif">Leadership</text>
          <text x="85" y="299" text-anchor="middle" fill="rgba(0,212,255,0.5)" font-size="10" font-weight="700" font-family="Inter, sans-serif">Personnel</text>
          <text x="240" y="319" text-anchor="middle" fill="rgba(0,168,255,0.55)" font-size="10" font-weight="700" font-family="Inter, sans-serif">Facilities</text>
          <text x="395" y="299" text-anchor="middle" fill="rgba(0,212,255,0.5)" font-size="10" font-weight="700" font-family="Inter, sans-serif">Policy</text>
        </g>
      </g>
    </g>

    <!-- === SHIELD (middle layer) === -->

    <!-- Shield outer glow/halo -->
    <path d="M240 75 L345 125 L345 250 C345 315 240 375 240 375 C240 375 135 315 135 250 L135 125 Z"
          fill="none" stroke="rgba(0,168,255,0.06)" stroke-width="8" filter="url(#shieldBlur)"/>

    <!-- Shield main body -->
    <path d="M240 80 L340 128 L340 248 C340 310 240 368 240 368 C240 368 140 310 140 248 L140 128 Z"
          fill="url(#shieldBodyFill)" stroke="url(#shieldBodyStroke)" stroke-width="2"/>

    <!-- Shield inner border -->
    <path d="M240 105 L318 143 L318 242 C318 293 240 342 240 342 C240 342 162 293 162 242 L162 143 Z"
          fill="none" stroke="rgba(0,168,255,0.1)" stroke-width="1"/>

    <!-- Shield surface detail - horizontal scan lines -->
    <line x1="165" y1="170" x2="315" y2="170" stroke="rgba(0,168,255,0.04)" stroke-width="0.5"/>
    <line x1="158" y1="200" x2="322" y2="200" stroke="rgba(0,168,255,0.05)" stroke-width="0.5"/>
    <line x1="152" y1="230" x2="328" y2="230" stroke="rgba(0,168,255,0.04)" stroke-width="0.5"/>
    <line x1="160" y1="260" x2="320" y2="260" stroke="rgba(0,168,255,0.03)" stroke-width="0.5"/>
    <line x1="175" y1="290" x2="305" y2="290" stroke="rgba(0,168,255,0.03)" stroke-width="0.5"/>

    <!-- Shield circuit/tech pattern -->
    <path d="M200 160 L200 180 L220 180" stroke="rgba(0,168,255,0.12)" stroke-width="1" stroke-linecap="round"/>
    <path d="M280 160 L280 175 L260 175" stroke="rgba(0,212,255,0.1)" stroke-width="1" stroke-linecap="round"/>
    <path d="M190 240 L210 240 L210 260" stroke="rgba(0,168,255,0.1)" stroke-width="1" stroke-linecap="round"/>
    <path d="M290 240 L270 240 L270 260" stroke="rgba(0,212,255,0.08)" stroke-width="1" stroke-linecap="round"/>
    <circle cx="200" cy="160" r="2" fill="rgba(0,168,255,0.2)"/>
    <circle cx="280" cy="160" r="2" fill="rgba(0,212,255,0.18)"/>
    <circle cx="210" cy="260" r="1.5" fill="rgba(0,168,255,0.15)"/>
    <circle cx="270" cy="260" r="1.5" fill="rgba(0,212,255,0.13)"/>

    <!-- Inner hexagonal detail -->
    <polygon points="240,155 268,170 268,200 240,215 212,200 212,170"
             stroke="rgba(0,168,255,0.1)" stroke-width="0.8" fill="none"/>

    <!-- Checkmark with glow -->
    <path d="M215 215 L235 238 L272 192" stroke="rgba(0,168,255,0.15)" stroke-width="6" stroke-linecap="round" stroke-linejoin="round" fill="none"/>
    <path d="M215 215 L235 238 L272 192" stroke="#00a8ff" stroke-width="3" stroke-linecap="round" stroke-linejoin="round" fill="none"/>

    <!-- Shield top accent -->
    <path d="M200 105 L240 88 L280 105" stroke="rgba(0,212,255,0.2)" stroke-width="1.5" fill="none" stroke-linecap="round"/>

    <!-- Corner accent nodes -->
    <circle cx="240" cy="80" r="3" fill="rgba(0,168,255,0.3)"/>
    <circle cx="340" cy="128" r="2.5" fill="rgba(0,168,255,0.2)"/>
    <circle cx="140" cy="128" r="2.5" fill="rgba(0,212,255,0.2)"/>

    <!-- Animated pulse ring around shield -->
    <path d="M240 80 L340 128 L340 248 C340 310 240 368 240 368 C240 368 140 310 140 248 L140 128 Z"
          fill="none" stroke="rgba(0,168,255,0.15)" stroke-width="1">
      <animate attributeName="stroke-opacity" values="0.15;0.02;0.15" dur="4s" repeatCount="indefinite"/>
    </path>

    <!-- === FRONT ORBIT HALF (in front of shield) === -->
    <g clip-path="url(#frontShieldClip)">
      <g>
        <animateTransform attributeName="transform" type="rotate" from="0 240 230" to="360 240 230" dur="45s" repeatCount="indefinite"/>
        <g transform="rotate(-8 240 230)">
          <text x="460" y="234" text-anchor="middle" fill="rgba(0,168,255,0.8)" font-size="10" font-weight="700" font-family="Inter, sans-serif">Doctrine</text>
          <text x="395" y="165" text-anchor="middle" fill="rgba(0,212,255,0.75)" font-size="10" font-weight="700" font-family="Inter, sans-serif">Organization</text>
          <text x="240" y="145" text-anchor="middle" fill="rgba(0,168,255,0.8)" font-size="10" font-weight="700" font-family="Inter, sans-serif">Training</text>
          <text x="85" y="165" text-anchor="middle" fill="rgba(0,212,255,0.75)" font-size="10" font-weight="700" font-family="Inter, sans-serif">Materiel</text>
          <text x="20" y="234" text-anchor="middle" fill="rgba(0,168,255,0.8)" font-size="10" font-weight="700" font-family="Inter, sans-serif">Leadership</text>
          <text x="85" y="299" text-anchor="middle" fill="rgba(0,212,255,0.75)" font-size="10" font-weight="700" font-family="Inter, sans-serif">Personnel</text>
          <text x="240" y="319" text-anchor="middle" fill="rgba(0,168,255,0.8)" font-size="10" font-weight="700" font-family="Inter, sans-serif">Facilities</text>
          <text x="395" y="299" text-anchor="middle" fill="rgba(0,212,255,0.75)" font-size="10" font-weight="700" font-family="Inter, sans-serif">Policy</text>
        </g>
      </g>
    </g>

    <!-- Defs -->
    <defs>
      <radialGradient id="shieldGlow">
        <stop offset="0%" stop-color="#00a8ff" stop-opacity="0.25"/>
        <stop offset="100%" stop-color="#00a8ff" stop-opacity="0"/>
      </radialGradient>

      <linearGradient id="shieldBodyFill" x1="240" y1="80" x2="240" y2="368" gradientUnits="userSpaceOnUse">
        <stop offset="0%" stop-color="rgba(0,168,255,0.1)"/>
        <stop offset="40%" stop-color="rgba(0,168,255,0.05)"/>
        <stop offset="100%" stop-color="rgba(10,37,64,0.15)"/>
      </linearGradient>

      <linearGradient id="shieldBodyStroke" x1="140" y1="80" x2="340" y2="368" gradientUnits="userSpaceOnUse">
        <stop offset="0%" stop-color="#00d4ff" stop-opacity="0.5"/>
        <stop offset="30%" stop-color="#00a8ff" stop-opacity="0.35"/>
        <stop offset="70%" stop-color="#00d4ff" stop-opacity="0.25"/>
        <stop offset="100%" stop-color="#00a8ff" stop-opacity="0.4"/>
      </linearGradient>

      <filter id="shieldBlur">
        <feGaussianBlur stdDeviation="4"/>
      </filter>

      <!-- Clip: area BEHIND the shield (everything outside the shield path) -->
      <!-- We invert by using a full rect minus the shield -->
      <clipPath id="behindShieldClip">
        <path d="M0 0 H480 V440 H0 Z M240 80 L140 128 L140 248 C140 310 240 368 240 368 C240 368 340 310 340 248 L340 128 Z" fill-rule="evenodd"/>
      </clipPath>

      <!-- Clip: area IN FRONT of the shield (inside the shield path only) -->
      <!-- Actually we want the sides - words visible on left/right outside shield, hidden when behind -->
      <!-- For a Saturn ring effect: front = bottom half of the orbit, back = top half -->
      <!-- Front clip: below the shield's equator line -->
      <clipPath id="frontShieldClip">
        <rect x="0" y="230" width="480" height="210"/>
      </clipPath>
    </defs>
  </svg>
</div>
