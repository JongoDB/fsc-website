---
import { footerSolutions, footerCompany, footerLegal, siteConfig } from '../data/navigation';

const currentYear = new Date().getFullYear();
---

<footer>
  <div class="container">
    <div class="footer-content">
      <div class="footer-section footer-brand">
        <img src="/images/brand/white.png" alt="Fighting Smart Cyber" class="footer-logo" />
        <p>{siteConfig.description}</p>
      </div>
      <div class="footer-section">
        <h4>Solutions</h4>
        <ul>
          {footerSolutions.map((item) => (
            <li><a href={item.href}>{item.title}</a></li>
          ))}
        </ul>
      </div>
      <div class="footer-section">
        <h4>Company</h4>
        <ul>
          {footerCompany.map((item) => (
            <li><a href={item.href}>{item.title}</a></li>
          ))}
        </ul>
      </div>
      <div class="footer-section">
        <h4>Contact</h4>
        <p>Email: <a href={`mailto:${siteConfig.email}`}>{siteConfig.email}</a></p>
        <p>Ready to discuss your mission? Let's talk.</p>
      </div>
    </div>
    <div class="footer-bottom">
      <p>&copy; {currentYear} {siteConfig.name}. All rights reserved. | {siteConfig.tagline}</p>
      <p class="footer-legal-links">
        {footerLegal.map((item, idx) => (
          <>
            {idx > 0 && <span class="footer-legal-sep">·</span>}
            <a href={item.href}>{item.title}</a>
          </>
        ))}
      </p>
    </div>
  </div>
</footer>
