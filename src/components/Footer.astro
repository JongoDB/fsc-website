---
import { footerSolutions, footerCompany, siteConfig } from '../data/navigation';

const currentYear = new Date().getFullYear();
---

<footer>
  <div class="container">
    <div class="footer-content">
      <div class="footer-section footer-brand">
        <img src="/images/brand/white.png" alt="Fighting Smart Cyber" class="footer-logo" />
        <p>{siteConfig.description}</p>
      </div>
      <div class="footer-section">
        <h4>Solutions</h4>
        <ul>
          {footerSolutions.map((item) => (
            <li><a href={item.href}>{item.title}</a></li>
          ))}
        </ul>
      </div>
      <div class="footer-section">
        <h4>Company</h4>
        <ul>
          {footerCompany.map((item) => (
            <li><a href={item.href}>{item.title}</a></li>
          ))}
        </ul>
      </div>
      <div class="footer-section">
        <h4>Contact</h4>
        <p>Email: <a href={`mailto:${siteConfig.email}`}>{siteConfig.email}</a></p>
        <p>Ready to discuss your mission? Let's talk.</p>
      </div>
    </div>
    <div class="footer-bottom">
      <p><a href="/admin/submissions" style="color: inherit; text-decoration: none;" aria-label="Admin access">&copy;</a> {currentYear} {siteConfig.name}. All rights reserved. | {siteConfig.tagline}</p>
    </div>
  </div>
</footer>
