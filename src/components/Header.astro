---
import { navigation, isDropdown, siteConfig } from '../data/navigation';
---

<header>
  <nav class="container" role="navigation" aria-label="Main navigation">
    <div class="logo-container">
      <a href="/" class="logo" aria-label="Fighting Smart Cyber Home">
        <img src="/images/brand/white.png" alt="FSC" class="logo-image" />
        <span class="logo-text">{siteConfig.name}</span>
      </a>
      <div class="tagline">{siteConfig.tagline}</div>
    </div>
    <button class="menu-toggle" onclick="toggleMenu()" aria-label="Toggle navigation menu" aria-expanded="false">
      <svg class="hamburger-icon" width="28" height="28" viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg">
        <path class="hamburger-line top" d="M3 6h18" stroke="currentColor" stroke-width="2" stroke-linecap="round"/>
        <path class="hamburger-line middle" d="M3 12h18" stroke="currentColor" stroke-width="2" stroke-linecap="round"/>
        <path class="hamburger-line bottom" d="M3 18h18" stroke="currentColor" stroke-width="2" stroke-linecap="round"/>
      </svg>
    </button>
    <ul class="nav-links" id="navLinks" role="menubar">
      {navigation.map((entry) => (
        isDropdown(entry) ? (
          <li class="dropdown" role="none">
            <div class="dropdown-header">
              <a href={entry.href} role="menuitem">{entry.title}</a>
              <button class="dropdown-toggle" aria-haspopup="true" aria-expanded="false" aria-label={`Toggle ${entry.title} submenu`}>
                <span class="dropdown-caret"></span>
              </button>
            </div>
            <ul class="dropdown-menu" role="menu" aria-label={`${entry.title} submenu`}>
              {entry.items.map((item) => (
                <li role="none"><a href={item.href} role="menuitem">{item.title}</a></li>
              ))}
            </ul>
          </li>
        ) : (
          <li role="none"><a href={entry.href} role="menuitem">{entry.title}</a></li>
        )
      ))}
      <li role="none"><a href="/contact" class="nav-cta" role="menuitem">Contact</a></li>
    </ul>
  </nav>
</header>
