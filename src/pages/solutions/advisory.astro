---
import ContentPageLayout from '../../layouts/ContentPageLayout.astro';
import SectionHeader from '../../components/SectionHeader.astro';
import FeatureItem from '../../components/FeatureItem.astro';
---

<ContentPageLayout
  title="Advisory & Strategy | Fighting Smart Cyber"
  description="Strategic cybersecurity advisory from proven operators. Capability development, organizational design, and executive advisory."
  heroTitle='Advisory & <span class="highlight">Strategy</span>'
  heroSubtitle="Strategic guidance from leaders who've built and operated at scale"
  ctaTitle="Ready for Strategic Guidance?"
  ctaDescription="Let's discuss how our advisory services can help strengthen your cybersecurity strategy and capabilities."
  ctaPrimaryButton={{ text: 'Schedule Advisory Consultation', href: '/contact' }}
  ctaSecondaryButton={{ text: 'View All Solutions', href: '/solutions' }}
>
  <section class="content-section">
    <div class="container">
      <div class="content-grid">
        <div class="content-text">
          <h2>Strategic Cybersecurity Advisory</h2>
          <p>Our advisory services help organizations develop comprehensive cybersecurity capabilities, design effective organizational structures, and navigate complex acquisition and compliance requirements.</p>
          <p>We bring the perspective of leaders who've commanded cyber operations, built security operations centers, and navigated government acquisition processes. We understand what works in the real world.</p>
          <h3>Our Advisory Services</h3>
          <ul>
            <li><strong>Capability Development</strong> - Design and implement <span class="tooltip-trigger">SOC<span class="tooltip-inline">Security Operations Center</span></span>, <span class="tooltip-trigger">C2<span class="tooltip-inline">Command and Control</span></span>, and cyber range capabilities</li>
            <li><strong>Organizational Design</strong> - Structure security teams for maximum effectiveness</li>
            <li><strong>Acquisition Strategy</strong> - Navigate government procurement and vendor selection</li>
            <li><strong>Zero Trust Roadmaps</strong> - Design and implement Zero Trust architectures</li>
            <li><strong>Cloud Modernization</strong> - Strategic guidance for cloud security transformation</li>
            <li><strong>Executive Advisory</strong> - C-level coaching and strategic planning</li>
          </ul>
        </div>
        <div class="content-text">
          <h2>Why Our Advisory is Different</h2>
          <p>Most cybersecurity advisors are career consultants. Our team includes:</p>
          <ul>
            <li><strong>A retired three-star general</strong> with strategic command experience</li>
            <li><strong>Operational leaders</strong> who've built and run capabilities in production</li>
            <li><strong>Acquisition experts</strong> who understand government procurement</li>
            <li><strong>Technical specialists</strong> who can bridge strategy and execution</li>
          </ul>
          <p style="margin-top: 30px;">We don't just provide recommendations—we help you implement them. Our advisory services often lead to platform deployments, training programs, or capability development projects.</p>
        </div>
      </div>
    </div>
  </section>

  <section class="content-section-alt">
    <div class="container">
      <SectionHeader title="Advisory Focus Areas" />
      <div class="feature-grid">
        <FeatureItem
          title="Capability Development"
          description="Design and implement security operations centers, command and control capabilities, and cyber ranges from the ground up."
        />
        <FeatureItem
          title="Organizational Design"
          description="Structure security teams, define roles and responsibilities, and design workflows for maximum operational effectiveness."
        />
        <FeatureItem
          title="Acquisition Strategy"
          description="Navigate government procurement processes, vendor selection, and contract negotiation with deep acquisition expertise."
        />
        <FeatureItem
          title="Zero Trust Roadmaps"
          description="Design and implement Zero Trust architectures with clear roadmaps and implementation guidance."
        />
        <FeatureItem
          title="Cloud Modernization"
          description="Strategic guidance for migrating to cloud environments while maintaining security and compliance."
        />
        <FeatureItem
          title="Executive Advisory"
          description="C-level coaching, strategic planning, and board-level cybersecurity risk management guidance."
        />
      </div>
    </div>
  </section>
</ContentPageLayout>
