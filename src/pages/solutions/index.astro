---
import ContentPageLayout from '../../layouts/ContentPageLayout.astro';
import SectionHeader from '../../components/SectionHeader.astro';
import MissionCard from '../../components/MissionCard.astro';

const solutions = [
  {
    icon: 'target',
    title: 'Consulting & Advisory',
    description: 'Comprehensive cyber readiness assessments using the <span class="tooltip-trigger">DOTMLPF-P<span class="tooltip-inline">Doctrine, Organization, Training, Materiel, Leadership, Personnel, Facilities, Policy</span></span> framework. Gap analysis, capability development, strategic advisory, and acquisition strategy from operators who\'ve been there.',
    href: '/solutions/consulting',
    linkText: 'Learn More'
  },
  {
    icon: 'graduation',
    title: 'Training Services',
    description: 'Operator-led training programs covering <span class="tooltip-trigger">DCO<span class="tooltip-inline">Defensive Cyber Operations</span></span>, incident response, threat hunting, Kubernetes security, and more. Hands-on labs with real-world scenarios and cyber range environments.',
    href: '/solutions/training',
    linkText: 'View Training'
  },
  {
    icon: 'layers',
    title: 'Custom SaaS Development',
    description: 'Purpose-built cloud applications tailored to your mission. From workflow automation to specialized security operations tools, we design, build, and deploy secure solutions.',
    href: '/solutions/custom-saas',
    linkText: 'Start a Project'
  },
  {
    icon: 'radar',
    title: 'Security Assessments',
    description: 'Operator-led penetration testing, vulnerability assessments, and red team exercises. Find your weaknesses before adversaries do.',
    href: '/solutions/security-assessments',
    linkText: 'Learn More'
  },
  {
    icon: 'shield',
    title: 'Platform Deployment',
    description: 'Production-ready cybersecurity platforms: SOC-in-a-Box, Secure Kubernetes Core, and <span class="tooltip-trigger">CYROID<span class="tooltip-inline">Cyber Range Orchestration in Docker</span></span> Cyber Range. Deploy operational capabilities in hours.',
    href: '/platforms',
    linkText: 'View Platforms'
  },
  {
    icon: 'grid',
    title: 'App Bundles & Catalog',
    description: 'Pre-curated software stacks for any environment. SOC bundles, <span class="tooltip-trigger">DFIR<span class="tooltip-inline">Digital Forensics & Incident Response</span></span> tools, productivity suites, and DevSecOps stacks ready for rapid deployment.',
    href: '/bundles',
    linkText: 'Browse Catalog'
  }
];
---

<ContentPageLayout
  title="Solutions"
  description="Operator-led offensive and defensive cyber solutions: consulting, training, advisory, and custom development."
  heroTitle='Our <span class="highlight">Solutions</span>'
  heroSubtitle="Comprehensive cybersecurity services from proven operators"
  ctaTitle="Ready to Get Started?"
  ctaDescription="Let's discuss how our solutions can address your cybersecurity challenges."
  ctaPrimaryButton={{ text: 'Contact Us', href: '/contact' }}
  ctaSecondaryButton={{ text: 'View Platforms', href: '/platforms' }}
>
  <section class="content-section-alt">
    <div class="container">
      <SectionHeader
        title="What We Offer"
        description="From assessments to custom development, we deliver operator-tested solutions"
      />
      <div class="cards-grid">
        {solutions.map((solution) => (
          <MissionCard
            icon={solution.icon}
            title={solution.title}
            description={solution.description}
            href={solution.href}
            linkText={solution.linkText}
          />
        ))}
      </div>
    </div>
  </section>
</ContentPageLayout>
