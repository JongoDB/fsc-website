---
import ContentPageLayout from '../../layouts/ContentPageLayout.astro';
import SectionHeader from '../../components/SectionHeader.astro';
import FeatureItem from '../../components/FeatureItem.astro';
---

<ContentPageLayout
  title="DFIR Bundle"
  description="Digital forensics and incident response tools: malware analysis, memory forensics, disk imaging, and investigation platforms."
  heroTitle='DFIR <span class="highlight">Bundle</span>'
  heroSubtitle="Digital forensics and incident response tools for comprehensive investigations"
  ctaTitle="Ready to Deploy the DFIR Bundle?"
  ctaDescription="Request bundle specifications or discuss your use case with our team."
  ctaPrimaryButton={{ text: 'Request Bundle Spec', href: '/contact' }}
  ctaSecondaryButton={{ text: 'View All Bundles', href: '/bundles' }}
>
  <section class="content-section">
    <div class="container">
      <div class="content-grid">
        <div class="content-text">
          <h2>Complete <span class="tooltip-trigger">DFIR<span class="tooltip-inline">Digital Forensics and Incident Response</span></span> Toolkit</h2>
          <p>The DFIR Bundle includes everything you need for digital forensics and incident response: malware analysis, memory forensics, disk imaging, and investigation platforms.</p>
          <p>All tools are pre-configured and ready for deployment. Perfect for incident response teams, forensics analysts, and security investigators.</p>
          <h3>What's Included</h3>
          <ul>
            <li><strong>Malware Analysis</strong> - Static and dynamic analysis tools</li>
            <li><strong>Memory Forensics</strong> - Volatile memory analysis and extraction</li>
            <li><strong>Disk Imaging</strong> - Disk acquisition and imaging tools</li>
            <li><strong>Network Forensics</strong> - Packet capture and analysis</li>
            <li><strong>Timeline Analysis</strong> - Event timeline reconstruction</li>
            <li><strong>Reporting Tools</strong> - Investigation documentation and reporting</li>
          </ul>
        </div>
        <div class="content-text">
          <h2>Use Cases</h2>
          <p>The DFIR Bundle supports a wide range of investigation scenarios:</p>
          <ul>
            <li><strong>Malware Incidents</strong> - Analyze and understand malware behavior</li>
            <li><strong>Data Breaches</strong> - Investigate unauthorized access and data exfiltration</li>
            <li><strong>Insider Threats</strong> - Investigate suspicious user activity</li>
            <li><strong>Compliance Investigations</strong> - Support regulatory and legal requirements</li>
            <li><strong>Threat Intelligence</strong> - Extract indicators of compromise</li>
          </ul>
          <h3 style="margin-top: 40px;">Who It's For</h3>
          <p>Incident response teams, digital forensics analysts, security investigators, and organizations that need comprehensive DFIR capabilities.</p>
        </div>
      </div>
    </div>
  </section>

  <section class="content-section-alt">
    <div class="container">
      <SectionHeader title="Bundle Components" />
      <div class="feature-grid">
        <FeatureItem
          title="Malware Analysis Platform"
          description="Static and dynamic malware analysis with sandboxing and behavioral analysis capabilities."
        />
        <FeatureItem
          title="Memory Forensics Tools"
          description="Volatile memory acquisition and analysis tools for investigating running processes and artifacts."
        />
        <FeatureItem
          title="Disk Imaging Suite"
          description="Disk acquisition, imaging, and analysis tools for forensic investigations."
        />
        <FeatureItem
          title="Investigation Platform"
          description="Centralized platform for managing investigations, evidence, and reporting."
        />
      </div>
    </div>
  </section>
</ContentPageLayout>
