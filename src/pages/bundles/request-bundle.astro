---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Hero from '../../components/Hero.astro';
import SectionHeader from '../../components/SectionHeader.astro';
import FeatureItem from '../../components/FeatureItem.astro';
import CTASection from '../../components/CTASection.astro';
---

<BaseLayout
  title="Request a Custom Bundle"
  description="Don't see what you need? We can create a custom bundle for your specific use case. Describe your requirements and we'll design a solution."
  includeSupabase={true}
  includeAnimations={false}
>
  <Hero
    title='Request a <span class="highlight">Custom Bundle</span>'
    subtitle="Tell us about your use case and we'll create a curated stack that fits"
    compact={true}
  />

  <section class="content-section">
    <div class="container">
      <div class="content-text" style="max-width: 800px; margin: 0 auto;">
        <h2 style="text-align: center; margin-bottom: 30px;">Custom Bundle Request</h2>
        <p>If you have a unique set of requirements, we can design and build a custom bundle tailored to your needs. Tell us about your use case, and we'll create a curated stack that fits.</p>
        <p style="margin-top: 30px;">Our team will work with you to understand your requirements and design a bundle that includes the right tools, configurations, and documentation for your specific mission.</p>
      </div>
    </div>
  </section>

  <section class="content-section-alt">
    <div class="container">
      <div class="contact-form">
        <h2 style="text-align: center; margin-bottom: 40px; color: var(--primary-blue);">Describe Your Use Case</h2>
        <form id="bundleRequestForm">
          <div class="form-row">
            <div class="form-group">
              <label for="name">Name *</label>
              <input type="text" id="name" name="name" required>
            </div>
            <div class="form-group">
              <label for="email">Email *</label>
              <input type="email" id="email" name="email" required>
            </div>
          </div>

          <div class="form-row">
            <div class="form-group">
              <label for="organization">Organization *</label>
              <input type="text" id="organization" name="organization" required>
            </div>
            <div class="form-group">
              <label for="role">Role/Title</label>
              <input type="text" id="role" name="role">
            </div>
          </div>

          <div class="form-group">
            <label for="useCase">Describe Your Use Case *</label>
            <textarea id="useCase" name="useCase" required placeholder="Tell us about your mission, requirements, and what you're trying to accomplish..." style="min-height: 150px;"></textarea>
          </div>

          <div class="form-group">
            <label for="requirements">Specific Requirements</label>
            <textarea id="requirements" name="requirements" placeholder="List any specific tools, capabilities, or constraints you have..." style="min-height: 120px;"></textarea>
          </div>

          <div class="form-group">
            <label for="environment">Deployment Environment</label>
            <select id="environment" name="environment">
              <option value="">Select an option</option>
              <option value="cloud">Cloud (AWS/Azure/GCP)</option>
              <option value="on-prem">On-Premises</option>
              <option value="hybrid">Hybrid</option>
              <option value="air-gapped">Air-Gapped</option>
              <option value="other">Other</option>
            </select>
          </div>

          <div class="form-group">
            <label for="timeframe">Timeframe</label>
            <select id="timeframe" name="timeframe">
              <option value="">Select an option</option>
              <option value="asap">ASAP</option>
              <option value="30-days">Within 30 days</option>
              <option value="60-90-days">60-90 days</option>
              <option value="exploring">Exploring options</option>
            </select>
          </div>

          <button type="submit" class="btn-primary" style="width: 100%; margin-top: 20px;">Submit Request</button>
        </form>
      </div>
    </div>
  </section>

  <section class="content-section">
    <div class="container">
      <SectionHeader title="What Happens Next?" />
      <div class="feature-grid">
        <FeatureItem
          title="1. Review"
          description="Our team reviews your use case and requirements to understand your needs."
        />
        <FeatureItem
          title="2. Design"
          description="We design a custom bundle with the right tools and configurations for your mission."
        />
        <FeatureItem
          title="3. Proposal"
          description="We provide a detailed proposal with bundle specifications, deployment approach, and timeline."
        />
        <FeatureItem
          title="4. Build"
          description="Once approved, we build, test, and document your custom bundle."
        />
      </div>
    </div>
  </section>

  <CTASection
    title="Have Questions?"
    description="Contact us directly to discuss your custom bundle requirements."
    primaryButton={{ text: 'Contact Us', href: '/contact' }}
    secondaryButton={{ text: 'View Standard Bundles', href: '/bundles' }}
  />
</BaseLayout>

<script is:inline>
  document.getElementById('bundleRequestForm').addEventListener('submit', async function(e) {
    e.preventDefault();

    const formData = {
      name: document.getElementById('name').value,
      email: document.getElementById('email').value,
      organization: document.getElementById('organization').value,
      role: document.getElementById('role').value,
      useCase: document.getElementById('useCase').value,
      requirements: document.getElementById('requirements').value,
      environment: document.getElementById('environment').value,
      timeframe: document.getElementById('timeframe').value,
      formType: 'bundle-request'
    };

    const submitBtn = e.target.querySelector('button[type="submit"]');
    const originalText = submitBtn.textContent;
    submitBtn.disabled = true;
    submitBtn.textContent = 'Sending...';

    try {
      await submitContactForm(formData);
      showSuccessMessage();
      document.getElementById('bundleRequestForm').reset();
    } catch (error) {
      console.error('Error:', error);
      alert('Sorry, there was an error sending your request. Please try again or email us directly at info@fightingsmartcyber.com');
      submitBtn.disabled = false;
      submitBtn.textContent = originalText;
    }
  });

  function showSuccessMessage() {
    // Remove existing banner if present
    const existingBanner = document.getElementById('successBanner');
    if (existingBanner) existingBanner.remove();

    // Create banner using safe DOM methods
    const banner = document.createElement('div');
    banner.id = 'successBanner';
    banner.style.cssText = 'position:fixed;top:0;left:0;right:0;background:linear-gradient(135deg,#00a8ff 0%,#00d4ff 100%);color:#000;padding:20px;text-align:center;z-index:10000;box-shadow:0 4px 20px rgba(0,0,0,0.3);animation:slideDown 0.3s ease-out;';

    const container = document.createElement('div');
    container.style.cssText = 'max-width:1200px;margin:0 auto;';

    const heading = document.createElement('h3');
    heading.style.cssText = 'margin:0 0 10px 0;font-size:24px;font-weight:700;';
    heading.textContent = '\u2713 Request Submitted Successfully!';

    const message = document.createElement('p');
    message.style.cssText = 'margin:0;font-size:16px;opacity:0.9;';
    message.textContent = 'Thank you for your bundle request! Our team will review your requirements and get back to you soon.';

    container.appendChild(heading);
    container.appendChild(message);
    banner.appendChild(container);

    // Add animation styles if not present
    if (!document.getElementById('successBannerStyle')) {
      const style = document.createElement('style');
      style.id = 'successBannerStyle';
      style.textContent = '@keyframes slideDown{from{transform:translateY(-100%);opacity:0}to{transform:translateY(0);opacity:1}}';
      document.head.appendChild(style);
    }

    document.body.appendChild(banner);

    setTimeout(function() {
      banner.style.animation = 'slideDown 0.3s ease-out reverse';
      setTimeout(function() {
        if (banner.parentNode) banner.parentNode.removeChild(banner);
      }, 300);
    }, 8000);

    window.scrollTo({ top: 0, behavior: 'smooth' });
  }
</script>
