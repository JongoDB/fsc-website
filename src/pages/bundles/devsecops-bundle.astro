---
import ContentPageLayout from '../../layouts/ContentPageLayout.astro';
import SectionHeader from '../../components/SectionHeader.astro';
import FeatureItem from '../../components/FeatureItem.astro';
---

<ContentPageLayout
  title="DevSecOps Bundle"
  description="Complete DevSecOps stack: CI/CD pipelines, security scanning, dependency management, and compliance automation."
  heroTitle='DevSecOps <span class="highlight">Bundle</span>'
  heroSubtitle="Complete DevSecOps stack for secure software delivery"
  ctaTitle="Ready to Deploy the DevSecOps Bundle?"
  ctaDescription="Request bundle specifications or discuss your use case with our team."
  ctaPrimaryButton={{ text: 'Request Bundle Spec', href: '/contact' }}
  ctaSecondaryButton={{ text: 'View All Bundles', href: '/bundles' }}
>
  <section class="content-section">
    <div class="container">
      <div class="content-with-illustration">
        <div class="content-text">
          <h2>Complete DevSecOps Stack</h2>
          <p>The DevSecOps Bundle includes everything you need for secure software delivery: <span class="tooltip-trigger">CI/CD<span class="tooltip-inline">Continuous Integration / Continuous Deployment</span></span> pipelines, security scanning, dependency management, and compliance automation.</p>
          <p>All tools are pre-configured, integrated, and ready for deployment. Secure software delivery from code to production.</p>
          <h3>What's Included</h3>
          <ul>
            <li><strong>CI/CD Platform</strong> - Continuous integration and deployment pipelines</li>
            <li><strong>Security Scanning</strong> - Static and dynamic application security testing</li>
            <li><strong>Dependency Management</strong> - Vulnerability scanning for dependencies</li>
            <li><strong>Container Security</strong> - Image scanning and runtime security</li>
            <li><strong>Compliance Automation</strong> - Automated compliance checking and reporting</li>
            <li><strong>Secret Management</strong> - Secure secret storage and rotation</li>
          </ul>
        </div>
        <div class="section-image-wrapper">
          <img src="/images/site/devsecops-pipeline.jpg" alt="DevSecOps CI/CD pipeline visualization" class="section-image" loading="lazy" />
        </div>
      </div>
    </div>
  </section>

  <section class="content-section-alt">
    <div class="container">
      <div class="content-with-illustration reverse">
        <div class="content-text">
          <h2>Security Throughout the Pipeline</h2>
          <p>The DevSecOps Bundle integrates security at every stage:</p>
          <ul>
            <li><strong>Code</strong> - Static analysis and code quality checks</li>
            <li><strong>Build</strong> - Dependency scanning and container image analysis</li>
            <li><strong>Test</strong> - Dynamic security testing and vulnerability assessment</li>
            <li><strong>Deploy</strong> - Security policy enforcement and compliance checking</li>
            <li><strong>Runtime</strong> - Runtime security monitoring and threat detection</li>
          </ul>
          <h3 style="margin-top: 40px;">Who It's For</h3>
          <p>Development teams, DevOps engineers, and organizations that need to integrate security into their software delivery pipeline. Perfect for teams building secure applications in cloud-native environments.</p>
        </div>
      </div>
    </div>
  </section>

  <section class="content-section-alt">
    <div class="container">
      <SectionHeader title="Bundle Components" />
      <div class="feature-grid">
        <FeatureItem
          title="CI/CD Platform"
          description="Continuous integration and deployment with security gates and policy enforcement."
        />
        <FeatureItem
          title={`<span class="tooltip-trigger">SAST<span class="tooltip-inline">Static Application Security Testing</span></span>/<span class="tooltip-trigger">DAST<span class="tooltip-inline">Dynamic Application Security Testing</span></span> Tools`}
          description="Static and dynamic application security testing integrated into the pipeline."
        />
        <FeatureItem
          title="Dependency Scanner"
          description="Automated vulnerability scanning for dependencies and containers."
        />
        <FeatureItem
          title="Compliance Automation"
          description="Automated compliance checking and reporting for security frameworks."
        />
      </div>
    </div>
  </section>
</ContentPageLayout>
