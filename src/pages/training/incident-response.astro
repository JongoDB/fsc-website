---
import ContentPageLayout from '../../layouts/ContentPageLayout.astro';
import SectionHeader from '../../components/SectionHeader.astro';
import MissionCard from '../../components/MissionCard.astro';
import FeatureItem from '../../components/FeatureItem.astro';
---

<ContentPageLayout
  title="Incident Response Training | Fighting Smart Cyber"
  description="Foundational training in cyber incident response methodologies, playbooks, and procedures. Technical and executive tracks available."
  heroTitle='Incident <span class="highlight">Response</span> Training'
  heroSubtitle="Foundational training in cyber incident response methodologies and procedures"
  ctaTitle="Ready to Master Incident Response?"
  ctaDescription="Request a syllabus or schedule a discovery call to learn more about this course."
  ctaPrimaryButton={{ text: 'Request Syllabus', href: '/contact' }}
  ctaSecondaryButton={{ text: 'View All Courses', href: '/training' }}
>
  <section class="content-section">
    <div class="container">
      <div class="content-grid">
        <div class="content-text">
          <h2>Course Overview</h2>
          <p>Foundational training in cyber incident response methodologies, playbooks, and procedures. Covers preparation, detection, analysis, containment, eradication, and recovery.</p>
          <p>Includes tabletop exercises simulating ransomware, data breaches, and insider threats based on real incidents. Available in both technical and executive tracks.</p>
          <h3>Course Details</h3>
          <ul>
            <li><strong>Duration:</strong> 3-4 days</li>
            <li><strong>Format:</strong> Classroom & tabletop exercises</li>
            <li><strong>Audience:</strong> <span class="tooltip-trigger">IT<span class="tooltip-inline">Information Technology</span></span> professionals, security teams, executives</li>
            <li><strong>Prerequisites:</strong> Basic understanding of <span class="tooltip-trigger">IT<span class="tooltip-inline">Information Technology</span></span> systems and security concepts</li>
          </ul>
        </div>
        <div class="content-text">
          <h2>What You'll Learn</h2>
          <ul>
            <li><strong>Preparation</strong> - Building incident response capabilities and playbooks</li>
            <li><strong>Detection</strong> - Identifying security incidents and understanding severity</li>
            <li><strong>Analysis</strong> - Investigating incidents and determining scope</li>
            <li><strong>Containment</strong> - Isolating threats and preventing further damage</li>
            <li><strong>Eradication</strong> - Removing threats and closing security gaps</li>
            <li><strong>Recovery</strong> - Restoring systems and returning to normal operations</li>
            <li><strong>Lessons Learned</strong> - Post-incident review and improvement</li>
          </ul>
        </div>
      </div>
    </div>
  </section>

  <section class="content-section-alt">
    <div class="container">
      <SectionHeader title="Training Tracks" />
      <div class="cards-grid" style="max-width: 800px; margin: 0 auto;">
        <MissionCard
          icon="target"
          title="Technical Track"
          description="Hands-on technical training for security analysts and incident responders. Deep dive into tools, techniques, and procedures for investigating and responding to cyber incidents."
          href="/contact"
          linkText="Request Info"
        />
        <MissionCard
          icon="briefcase"
          title="Executive Track"
          description="Strategic overview for executives and leadership. Focus on decision-making, resource allocation, and communication during incidents. Includes tabletop exercises."
          href="/contact"
          linkText="Request Info"
        />
      </div>
    </div>
  </section>

  <section class="content-section">
    <div class="container">
      <SectionHeader
        title="Tabletop Exercises"
        description="Real-world scenarios based on actual incidents"
      />
      <div class="feature-grid">
        <FeatureItem
          title="Exercise 1: Ransomware Response"
          description="Respond to a ransomware attack affecting critical systems. Practice containment, communication, and recovery procedures."
        />
        <FeatureItem
          title="Exercise 2: Data Breach Investigation"
          description="Investigate a suspected data breach, determine scope, and implement containment measures."
        />
        <FeatureItem
          title="Exercise 3: Insider Threat Response"
          description="Respond to an insider threat scenario, balancing security needs with operational requirements."
        />
        <FeatureItem
          title="Exercise 4: Supply Chain Compromise"
          description="Address a supply chain compromise affecting multiple systems and vendors."
        />
      </div>
    </div>
  </section>
</ContentPageLayout>
