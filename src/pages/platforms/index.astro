---
import ContentPageLayout from '../../layouts/ContentPageLayout.astro';
import SectionHeader from '../../components/SectionHeader.astro';
import MissionCard from '../../components/MissionCard.astro';
import FeatureItem from '../../components/FeatureItem.astro';

const platforms = [
  {
    icon: 'shield',
    title: 'SOC-in-a-Box',
    description: 'Turnkey, accreditation-ready security operations center platform. Kubernetes-based, production-ready, with integrated <span class="tooltip-trigger">SIEM<span class="tooltip-inline">Security Information and Event Management</span></span>, <span class="tooltip-trigger">EDR<span class="tooltip-inline">Endpoint Detection and Response</span></span>, threat intel, and vulnerability management.',
    href: '/platforms/soc-in-a-box',
    linkText: 'Explore SOC-in-a-Box'
  },
  {
    icon: 'kubernetes',
    title: 'Secure Kubernetes Core',
    description: 'Opinionated, secure <span class="tooltip-trigger">K8s<span class="tooltip-inline">Kubernetes</span></span> baseline for business applications. Built with Zero Trust principles, comprehensive observability, and GitOps integration.',
    href: '/platforms/secure-kubernetes',
    linkText: 'Explore Secure K8s'
  },
  {
    icon: 'monitor',
    title: 'CYROID Cyber Range',
    description: 'Enterprise cyber range orchestration platform. Deploy isolated, networked training environments in minutes with visual range builder, <span class="tooltip-trigger">MSEL<span class="tooltip-inline">Master Scenario Events List</span></span> automation, and web-based <span class="tooltip-trigger">VM<span class="tooltip-inline">Virtual Machine</span></span> console access.',
    href: '/platforms/cyroid',
    linkText: 'Explore CYROID'
  }
];

const features = [
  {
    title: 'Operator-Tested',
    description: 'All platforms are based on real operational experience and tested in production environments.'
  },
  {
    title: 'Production-Ready',
    description: 'Deploy immediately. Our platforms are ready for production use, not proof-of-concepts.'
  },
  {
    title: 'Accreditation-Ready',
    description: 'Designed with compliance in mind, supporting <span class="tooltip-trigger">NIST<span class="tooltip-inline">National Institute of Standards and Technology</span></span>, <span class="tooltip-trigger">CMMC<span class="tooltip-inline">Cybersecurity Maturity Model Certification</span></span>, <span class="tooltip-trigger">FedRAMP<span class="tooltip-inline">Federal Risk and Authorization Management Program</span></span>, and other frameworks.'
  },
  {
    title: 'Multi-Environment',
    description: 'Works across cloud, on-premises, hybrid, and air-gapped environments.'
  },
  {
    title: 'Scalable',
    description: 'Kubernetes-native design scales from SMB to enterprise without redesign.'
  },
  {
    title: 'Comprehensive Documentation',
    description: 'Full documentation, training, and support to ensure your team can operate and maintain the platform.'
  },
  {
    title: 'Open Source Foundation',
    description: 'Built on proven open-source technologies. No vendor lock-in, full transparency, and community-backed reliability.'
  },
  {
    title: 'Rapid Deployment',
    description: 'Pre-configured and tested. Deploy production-ready platforms in hours, not months.'
  }
];
---

<ContentPageLayout
  title="Platforms"
  description="Production-ready cybersecurity platforms from Fighting Smart Cyber. SOC-in-a-Box, Secure Kubernetes Core, and CYROID Cyber Range."
  heroTitle='Our <span class="highlight">Platforms</span>'
  heroSubtitle="Production-ready cybersecurity platforms built by operators, for operators"
  ctaTitle="Ready to Deploy a Platform?"
  ctaDescription="Let's discuss which platform best fits your mission and requirements."
  ctaPrimaryButton={{ text: 'Schedule a Demo', href: '/contact' }}
  ctaSecondaryButton={{ text: 'View App Bundles', href: '/bundles' }}
>
  <section class="content-section-alt">
    <div class="container">
      <div class="cards-grid">
        {platforms.map((platform) => (
          <MissionCard
            icon={platform.icon}
            title={platform.title}
            description={platform.description}
            href={platform.href}
            linkText={platform.linkText}
          />
        ))}
      </div>
    </div>
  </section>

  <section class="content-section">
    <div class="container">
      <SectionHeader
        title="Why Our Platforms Work"
        description="Every platform is designed with real-world operations in mind"
      />
      <div class="feature-grid">
        {features.map((feature) => (
          <FeatureItem
            title={feature.title}
            description={feature.description}
          />
        ))}
      </div>
    </div>
  </section>
</ContentPageLayout>
