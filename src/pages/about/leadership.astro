---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Hero from '../../components/Hero.astro';
import SectionHeader from '../../components/SectionHeader.astro';
import CTASection from '../../components/CTASection.astro';

const ceo = {
  name: 'Matthew "Jerry" Glavy',
  role: 'Chief Executive Officer',
  rank: 'Lieutenant General, U.S. Marine Corps (Retired)',
  photo: '/images/leadership/lgen-glavy.jpg',
  bio: [
    'Lieutenant General Glavy brings over 39 years of experience operating in the most challenging domains of air, sea, space, and cyberspace. From numerous deployments with Marine Expeditionary Units around the world to strategic operations at the highest levels of national security, his career represents an unmatched combination of operational credibility and technical expertise.',
    'As Commanding Officer of Marine Helicopter Squadron One (HMX-1), he served as the President\'s helicopter pilot, ensuring safe and timely movement of the Commander-in-Chief aboard Marine One. As Commander of U.S. Marine Corps Forces Cyberspace Command, he led the transformation of global network operations, commanded Joint Task Force ARES executing offensive cyber operations, oversaw construction of a $200M cyberspace operations facility, and grew the command to a 3,000-person fighting force. He then stood up and led U.S. Marine Corps Forces Space Command, bringing the Marine Corps into the space domain.',
    'His final assignment as Deputy Commandant for Information gave him responsibility for modernizing the Marine Corps Enterprise Network with hybrid cloud infrastructure integrating AI and machine learning capabilities, transforming the ISR enterprise, and managing a $3 billion annual budget. Today, he brings this wealth of operational experience to help organizations fight smarter against evolving cyber threats.'
  ],
  highlights: [
    'Deputy Commandant for Information — $3B budget, AI/ML integration',
    'Commander, MARFORCYBER & Joint Task Force ARES (offensive cyber ops)',
    'Commander, U.S. Marine Corps Forces Space Command',
    'Commanding Officer, HMX-1 — Marine One pilot for the President',
    'Commanding General, 2nd MAW — 14,000 Marines, 500 aircraft',
    'Deputy Director of Operations, U.S. Cyber Command'
  ],
  credentials: ['TS/SCI Clearance', 'Cyber Operations', 'Space Operations'],
  linkedin: 'https://www.linkedin.com/in/fighting-smart/'
};

const executives = [
  {
    name: '[Name]',
    role: 'Chief Technology Officer',
    rank: '[Rank], [Branch]',
    photo: null,
    bio: '[1-2 paragraph bio covering technical expertise, operational experience in DCO/OCO, engineering background, and specific accomplishments. Include DOTMLPF-P expertise, network architecture experience, and hands-on cyber operations.]',
    highlights: [
      'Offensive and defensive cyber operations',
      'Network engineering and secure architecture',
      'Government acquisition and procurement',
      'DOTMLPF-P framework implementation'
    ],
    credentials: ['[Certifications]', '[Clearance]'],
    linkedin: null
  },
  {
    name: 'Jon Rannabargar',
    role: 'Chief Operating Officer',
    rank: 'U.S. Marine Corps',
    photo: '/images/leadership/jon-rannabargar.jpg',
    bio: 'Jon brings 10 years of Department of Defense experience across DCO, SIGINT, and secure system architecture, operating in roles spanning Product Manager, Product Owner, Scrum Master, Cryptologic Linguist, and Host Analyst on a Cyber Protection Team. He has architected enterprise networks and global VPN infrastructure supporting remote operations, developed and deployed cyber capabilities across classified and unclassified enclaves, and built cyber ranges for training, certification, and mission rehearsal. His experience includes planning and orchestrating service and joint exercises in support of CJADC2 initiatives, and operating in austere environments for both SIGINT collection and cyber operations.',
    highlights: [
      'Enterprise network & VPN architecture — enabled global remote ops',
      'DCO capability development — DevSecOps delivery at tactical edge',
      'Cyber range engineering — 50+ environments for training & rehearsal',
      'Joint exercises & experimentation — CJADC2 integration validation'
    ],
    credentials: ['TS/SCI w/ CI Poly', 'SAFe Practitioner', 'Kubernetes'],
    linkedin: 'https://www.linkedin.com/in/jpranna'
  }
];

const advisors = [
  // Placeholder for future advisors
  // {
  //   name: '[Advisor Name]',
  //   title: '[Current Role / Former Role]',
  //   organization: '[Company/Organization]',
  //   photo: null,
  //   bio: '[Brief 1-2 sentence bio]',
  //   linkedin: null
  // }
];
---

<BaseLayout
  title="Leadership"
  description="Meet the leadership team at Fighting Smart Cyber - proven operators with unmatched experience in cyber operations, command, and capability development."
  includeAnimations={true}
>
  <Hero
    title='Our <span class="highlight">Leadership</span>'
    subtitle="Proven operators with decades of experience at the highest levels of cyber operations"
    compact={true}
  />

  <!-- CEO Feature Section -->
  <section class="dark-section">
    <div class="container">
      <div class="ceo-card">
        <div class="ceo-photo-column">
          {ceo.photo ? (
            <img src={ceo.photo} alt={ceo.name} class="leader-photo ceo-photo" />
          ) : (
            <div class="photo-placeholder ceo-photo">
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5">
                <path d="M20 21v-2a4 4 0 0 0-4-4H8a4 4 0 0 0-4 4v2" />
                <circle cx="12" cy="7" r="4" />
              </svg>
            </div>
          )}
          {ceo.linkedin && (
            <a href={ceo.linkedin} class="linkedin-link" target="_blank" rel="noopener noreferrer">
              <svg viewBox="0 0 24 24" fill="currentColor" width="20" height="20">
                <path d="M20.447 20.452h-3.554v-5.569c0-1.328-.027-3.037-1.852-3.037-1.853 0-2.136 1.445-2.136 2.939v5.667H9.351V9h3.414v1.561h.046c.477-.9 1.637-1.85 3.37-1.85 3.601 0 4.267 2.37 4.267 5.455v6.286zM5.337 7.433c-1.144 0-2.063-.926-2.063-2.065 0-1.138.92-2.063 2.063-2.063 1.14 0 2.064.925 2.064 2.063 0 1.139-.925 2.065-2.064 2.065zm1.782 13.019H3.555V9h3.564v11.452zM22.225 0H1.771C.792 0 0 .774 0 1.729v20.542C0 23.227.792 24 1.771 24h20.451C23.2 24 24 23.227 24 22.271V1.729C24 .774 23.2 0 22.222 0h.003z"/>
              </svg>
              View LinkedIn Profile
            </a>
          )}
        </div>
        <div class="ceo-content">
          <div class="leader-header">
            <h2 class="leader-name">{ceo.name}</h2>
            <p class="leader-role">{ceo.role}</p>
            <p class="leader-rank">{ceo.rank}</p>
          </div>
          <div class="leader-bio">
            {ceo.bio.map((paragraph) => (
              <p>{paragraph}</p>
            ))}
          </div>
          <div class="leader-highlights">
            <h4>Key Experience</h4>
            <ul>
              {ceo.highlights.map((item) => (
                <li>{item}</li>
              ))}
            </ul>
          </div>
          {ceo.credentials && ceo.credentials.length > 0 && (
            <div class="leader-credentials">
              {ceo.credentials.map((cred) => (
                <span class="credential-badge">{cred}</span>
              ))}
            </div>
          )}
        </div>
      </div>
    </div>
  </section>

  <!-- Executive Team -->
  <section class="content-section">
    <div class="container">
      <SectionHeader
        title="Executive Team"
        description="Technical and operational leadership with hands-on cyber experience"
      />
      <div class="executives-grid">
        {executives.map((exec) => (
          <div class="executive-card">
            <div class="executive-photo-wrapper">
              {exec.photo ? (
                <img src={exec.photo} alt={exec.name} class="leader-photo exec-photo" />
              ) : (
                <div class="photo-placeholder exec-photo">
                  <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5">
                    <path d="M20 21v-2a4 4 0 0 0-4-4H8a4 4 0 0 0-4 4v2" />
                    <circle cx="12" cy="7" r="4" />
                  </svg>
                </div>
              )}
            </div>
            <div class="executive-content">
              <div class="leader-header">
                <h3 class="leader-name">{exec.name}</h3>
                <p class="leader-role">{exec.role}</p>
                <p class="leader-rank">{exec.rank}</p>
              </div>
              <p class="leader-bio-short" set:html={exec.bio}></p>
              <div class="leader-highlights compact">
                <h4>Key Experience</h4>
                <ul>
                  {exec.highlights.map((item) => (
                    <li set:html={item}></li>
                  ))}
                </ul>
              </div>
              {exec.credentials && exec.credentials.length > 0 && (
                <div class="leader-credentials">
                  {exec.credentials.map((cred) => (
                    <span class="credential-badge">{cred}</span>
                  ))}
                </div>
              )}
              {exec.linkedin && (
                <a href={exec.linkedin} class="linkedin-link small" target="_blank" rel="noopener noreferrer">
                  <svg viewBox="0 0 24 24" fill="currentColor" width="16" height="16">
                    <path d="M20.447 20.452h-3.554v-5.569c0-1.328-.027-3.037-1.852-3.037-1.853 0-2.136 1.445-2.136 2.939v5.667H9.351V9h3.414v1.561h.046c.477-.9 1.637-1.85 3.37-1.85 3.601 0 4.267 2.37 4.267 5.455v6.286zM5.337 7.433c-1.144 0-2.063-.926-2.063-2.065 0-1.138.92-2.063 2.063-2.063 1.14 0 2.064.925 2.064 2.063 0 1.139-.925 2.065-2.064 2.065zm1.782 13.019H3.555V9h3.564v11.452zM22.225 0H1.771C.792 0 0 .774 0 1.729v20.542C0 23.227.792 24 1.771 24h20.451C23.2 24 24 23.227 24 22.271V1.729C24 .774 23.2 0 22.222 0h.003z"/>
                  </svg>
                  LinkedIn
                </a>
              )}
            </div>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- Board of Advisors (Hidden until populated) -->
  {advisors.length > 0 && (
    <section class="content-section-alt">
      <div class="container">
        <SectionHeader
          title="Board of Advisors"
          description="Industry leaders and experts guiding our strategic direction"
        />
        <div class="advisors-grid">
          {advisors.map((advisor) => (
            <div class="advisor-card">
              {advisor.photo ? (
                <img src={advisor.photo} alt={advisor.name} class="advisor-photo" />
              ) : (
                <div class="photo-placeholder advisor-photo">
                  <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5">
                    <path d="M20 21v-2a4 4 0 0 0-4-4H8a4 4 0 0 0-4 4v2" />
                    <circle cx="12" cy="7" r="4" />
                  </svg>
                </div>
              )}
              <h4 class="advisor-name">{advisor.name}</h4>
              <p class="advisor-title">{advisor.title}</p>
              <p class="advisor-org">{advisor.organization}</p>
              <p class="advisor-bio">{advisor.bio}</p>
            </div>
          ))}
        </div>
      </div>
    </section>
  )}

  <!-- Why Our Leadership Section -->
  <section class="dark-section">
    <div class="container">
      <SectionHeader
        title="Why Our Leadership Matters"
        description="Our founding team brings a unique combination of strategic vision, operational experience, and technical expertise"
      />
      <div class="value-grid">
        <div class="value-card">
          <div class="value-icon">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
              <path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z" />
              <path d="M9 12l2 2 4-4" />
            </svg>
          </div>
          <h3>Operational Credibility</h3>
          <p>Our leaders have commanded, planned, and executed cyber operations at the highest levels. They understand what works in the real world, not just in theory.</p>
        </div>
        <div class="value-card">
          <div class="value-icon">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
              <rect x="2" y="3" width="20" height="14" rx="2" />
              <path d="M8 21h8M12 17v4" />
            </svg>
          </div>
          <h3>Technical Depth</h3>
          <p>Hands-on experience designing, building, and operating secure architectures, cyber ranges, and defensive capabilities from the ground up.</p>
        </div>
        <div class="value-card">
          <div class="value-icon">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
              <path d="M17 21v-2a4 4 0 0 0-4-4H5a4 4 0 0 0-4 4v2" />
              <circle cx="9" cy="7" r="4" />
              <path d="M23 21v-2a4 4 0 0 0-3-3.87M16 3.13a4 4 0 0 1 0 7.75" />
            </svg>
          </div>
          <h3>Government Expertise</h3>
          <p>Deep understanding of government acquisition processes, security frameworks, compliance requirements, and how to navigate complex procurement environments.</p>
        </div>
        <div class="value-card">
          <div class="value-icon">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
              <circle cx="12" cy="12" r="10" />
              <path d="M2 12h20M12 2a15.3 15.3 0 0 1 4 10 15.3 15.3 0 0 1-4 10 15.3 15.3 0 0 1-4-10 15.3 15.3 0 0 1 4-10z" />
            </svg>
          </div>
          <h3>Holistic Thinking</h3>
          <p>Ability to think across the entire <span class="tooltip-trigger">DOTMLPF-P<span class="tooltip-inline">Doctrine, Organization, Training, Materiel, Leadership, Personnel, Facilities, Policy</span></span> spectrum, ensuring solutions address all aspects of organizational cybersecurity.</p>
        </div>
      </div>
    </div>
  </section>

  <CTASection
    title="Work with Proven Operators"
    description="Our leadership team is ready to help you fight smarter. Let's discuss your mission."
    primaryButton={{ text: 'Contact Us', href: '/contact' }}
    secondaryButton={{ text: 'Learn More About Us', href: '/about/who-we-are' }}
  />
</BaseLayout>

<style>
  /* CEO Feature Card */
  .ceo-card {
    display: grid;
    grid-template-columns: 280px 1fr;
    gap: 50px;
    background: rgba(255,255,255,0.03);
    border: 1px solid rgba(255,255,255,0.1);
    border-radius: 20px;
    padding: 50px;
    margin-top: 40px;
  }

  .ceo-photo-column {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 20px;
  }

  .leader-photo {
    width: 100%;
    border-radius: 12px;
    object-fit: cover;
  }

  .ceo-photo {
    aspect-ratio: 3/4;
    max-width: 250px;
  }

  .photo-placeholder {
    background: linear-gradient(135deg, rgba(0,168,255,0.2), rgba(0,168,255,0.05));
    border: 2px dashed rgba(0,168,255,0.3);
    border-radius: 12px;
    display: flex;
    align-items: center;
    justify-content: center;
    color: rgba(0,168,255,0.5);
  }

  .photo-placeholder svg {
    width: 40%;
    height: auto;
  }

  .photo-placeholder.ceo-photo {
    width: 250px;
    aspect-ratio: 3/4;
  }

  .linkedin-link {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    color: var(--bright-blue);
    text-decoration: none;
    font-size: 14px;
    font-weight: 500;
    padding: 10px 16px;
    border: 1px solid rgba(0,168,255,0.3);
    border-radius: 8px;
    transition: all 0.3s ease;
  }

  .linkedin-link:hover {
    background: rgba(0,168,255,0.1);
    border-color: var(--bright-blue);
  }

  .linkedin-link.small {
    font-size: 13px;
    padding: 8px 12px;
  }

  .ceo-content {
    display: flex;
    flex-direction: column;
    gap: 25px;
  }

  .leader-header {
    border-bottom: 1px solid rgba(255,255,255,0.1);
    padding-bottom: 20px;
  }

  .leader-name {
    font-size: 32px;
    color: var(--white);
    margin: 0 0 8px 0;
    font-weight: 700;
  }

  .leader-role {
    font-size: 20px;
    color: var(--bright-blue);
    margin: 0 0 5px 0;
    font-weight: 600;
  }

  .leader-rank {
    font-size: 16px;
    color: rgba(255,255,255,0.7);
    margin: 0;
    font-style: italic;
  }

  .leader-bio p {
    color: rgba(255,255,255,0.9);
    line-height: 1.8;
    margin: 0 0 15px 0;
  }

  .leader-bio p:last-child {
    margin-bottom: 0;
  }

  .leader-highlights h4 {
    color: var(--white);
    font-size: 16px;
    margin: 0 0 12px 0;
    text-transform: uppercase;
    letter-spacing: 1px;
  }

  .leader-highlights ul {
    margin: 0;
    padding-left: 20px;
    color: rgba(255,255,255,0.85);
    line-height: 1.8;
  }

  .leader-highlights.compact ul {
    font-size: 14px;
  }

  .leader-credentials {
    display: flex;
    flex-wrap: wrap;
    gap: 10px;
    margin-top: 10px;
  }

  .credential-badge {
    background: rgba(0,168,255,0.15);
    color: var(--bright-blue);
    padding: 6px 14px;
    border-radius: 20px;
    font-size: 13px;
    font-weight: 500;
    border: 1px solid rgba(0,168,255,0.3);
  }

  /* Executive Cards */
  .executives-grid {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 40px;
    margin-top: 50px;
  }

  .executive-card {
    background: var(--white);
    border-radius: 16px;
    padding: 40px;
    box-shadow: 0 4px 20px rgba(0,0,0,0.08);
    display: flex;
    flex-direction: column;
    gap: 20px;
  }

  .executive-photo-wrapper {
    display: flex;
    justify-content: center;
  }

  .exec-photo {
    width: 180px;
    aspect-ratio: 1;
    border-radius: 50%;
  }

  .photo-placeholder.exec-photo {
    background: linear-gradient(135deg, rgba(0,119,204,0.15), rgba(0,119,204,0.05));
    border-color: rgba(0,119,204,0.2);
    color: rgba(0,119,204,0.4);
  }

  .executive-card .leader-header {
    text-align: center;
    border-bottom: 1px solid rgba(0,0,0,0.08);
  }

  .executive-card .leader-name {
    color: var(--dark);
    font-size: 26px;
  }

  .executive-card .leader-role {
    color: #0077cc;
    font-size: 18px;
  }

  .executive-card .leader-rank {
    color: rgba(0,0,0,0.6);
  }

  .leader-bio-short {
    color: var(--text);
    line-height: 1.8;
    font-size: 15px;
    margin-top: 20px;
  }

  .executive-card .leader-highlights {
    margin-top: 20px;
  }

  .executive-card .leader-highlights h4 {
    color: var(--dark);
    font-size: 14px;
  }

  .executive-card .leader-highlights ul {
    color: var(--text);
    font-size: 14px;
  }

  .executive-card .credential-badge {
    background: rgba(0,119,204,0.1);
    color: #0077cc;
    border-color: rgba(0,119,204,0.2);
  }

  .executive-card .linkedin-link {
    align-self: flex-start;
    color: #0077cc;
    border-color: rgba(0,119,204,0.3);
    margin-top: 15px;
  }

  .executive-card .linkedin-link:hover {
    background: rgba(0,119,204,0.08);
    border-color: #0077cc;
  }

  /* Advisors Grid */
  .advisors-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(250px, 1fr));
    gap: 30px;
    margin-top: 50px;
  }

  .advisor-card {
    background: var(--white);
    padding: 30px;
    border-radius: 12px;
    text-align: center;
    box-shadow: 0 4px 15px rgba(0,0,0,0.08);
  }

  .advisor-photo {
    width: 120px;
    height: 120px;
    border-radius: 50%;
    margin: 0 auto 20px;
    object-fit: cover;
  }

  .photo-placeholder.advisor-photo {
    background: linear-gradient(135deg, rgba(0,119,204,0.15), rgba(0,119,204,0.05));
    border-color: rgba(0,119,204,0.2);
    color: rgba(0,119,204,0.4);
  }

  .advisor-name {
    font-size: 20px;
    color: var(--dark);
    margin: 0 0 5px 0;
  }

  .advisor-title {
    font-size: 14px;
    color: #0077cc;
    margin: 0 0 3px 0;
    font-weight: 500;
  }

  .advisor-org {
    font-size: 13px;
    color: rgba(0,0,0,0.6);
    margin: 0 0 15px 0;
  }

  .advisor-bio {
    font-size: 14px;
    color: var(--text);
    line-height: 1.6;
  }

  /* Value Cards */
  .value-grid {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 30px;
    margin-top: 50px;
  }

  .value-card {
    background: rgba(255,255,255,0.05);
    border: 1px solid rgba(255,255,255,0.1);
    border-radius: 16px;
    padding: 30px;
    text-align: center;
  }

  .value-icon {
    width: 60px;
    height: 60px;
    margin: 0 auto 20px;
    background: rgba(0,168,255,0.15);
    border-radius: 50%;
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .value-icon svg {
    width: 28px;
    height: 28px;
    color: var(--bright-blue);
  }

  .value-card h3 {
    color: var(--white);
    font-size: 20px;
    margin: 0 0 15px 0;
  }

  .value-card p {
    color: rgba(255,255,255,0.8);
    font-size: 15px;
    line-height: 1.7;
    margin: 0;
  }

  /* Responsive */
  @media (max-width: 1100px) {
    .value-grid {
      grid-template-columns: repeat(2, 1fr);
    }
  }

  @media (max-width: 900px) {
    .ceo-card {
      grid-template-columns: 1fr;
      text-align: center;
      padding: 40px 30px;
    }

    .ceo-photo-column {
      order: -1;
    }

    .photo-placeholder.ceo-photo {
      width: 200px;
    }

    .leader-header {
      text-align: center;
    }

    .leader-highlights {
      text-align: left;
    }

    .leader-credentials {
      justify-content: center;
    }

    .executives-grid {
      grid-template-columns: 1fr;
    }
  }

  @media (max-width: 768px) {
    .ceo-card {
      padding: 30px 20px;
      gap: 30px;
    }

    .leader-name {
      font-size: 26px;
    }

    .leader-role {
      font-size: 18px;
    }

    .value-grid {
      grid-template-columns: 1fr;
      gap: 20px;
    }

    .executive-card {
      padding: 30px 25px;
    }

    .exec-photo {
      width: 150px;
    }
  }
</style>
