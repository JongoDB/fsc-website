---
import BaseLayout from '../layouts/BaseLayout.astro';
import Hero from '../components/Hero.astro';
import MissionCard from '../components/MissionCard.astro';
import SectionHeader from '../components/SectionHeader.astro';
import LeadershipCard from '../components/LeadershipCard.astro';
import CTASection from '../components/CTASection.astro';
import MissionMap from '../components/illustrations/MissionMap.astro';
import { homepageTiles } from '../data/navigation';

const leaders = [
  {
    role: 'CEO',
    title: 'Retired Three-Star General | Cyber Domain Leader',
    bio: 'Former elite cyber unit commander and pilot with extensive experience leading cyber operations at the strategic level. Brings unparalleled leadership, government relationships, and vision for next-generation cyber defense.'
  },
  {
    role: 'CTO',
    title: 'Senior Officer | Cyber Operations Technician',
    bio: 'Hands-on experience conducting offensive and defensive cyber operations. Subject matter expert in operational execution, network engineering, and government acquisition processes. Deep expertise in DOTMLPF-P frameworks.'
  },
  {
    role: 'COO',
    title: 'Senior Enlisted | Defense Architecture Specialist',
    bio: 'Experienced in building secure networks, implementing defense architectures, and developing operational capabilities. Deep technical knowledge in network security, infrastructure hardening, and defensive cyber operations.'
  }
];

const trustBadges = [
  { icon: 'lock', label: 'TS/SCI Cleared' },
  { icon: 'target', label: 'Operator-Tested' },
  { icon: 'shield', label: 'Accreditation-Ready' },
  { icon: 'globe', label: 'Multi-Environment' }
];

const trustIcons: Record<string, string> = {
  lock: `<rect x="5" y="11" width="14" height="11" rx="2" stroke="currentColor" stroke-width="2" fill="none"/><path d="M8 11V7a4 4 0 118 0v4" stroke="currentColor" stroke-width="2" stroke-linecap="round" fill="none"/>`,
  target: `<circle cx="12" cy="12" r="10" stroke="currentColor" stroke-width="2" fill="none"/><circle cx="12" cy="12" r="6" stroke="currentColor" stroke-width="2" fill="none"/><circle cx="12" cy="12" r="2" fill="currentColor"/>`,
  shield: `<path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z" stroke="currentColor" stroke-width="2" fill="none"/><path d="M9 12l2 2 4-4" stroke="currentColor" stroke-width="2" stroke-linecap="round" fill="none"/>`,
  globe: `<circle cx="12" cy="12" r="10" stroke="currentColor" stroke-width="2" fill="none"/><path d="M2 12h20" stroke="currentColor" stroke-width="2" fill="none"/><path d="M12 2a15.3 15.3 0 014 10 15.3 15.3 0 01-4 10 15.3 15.3 0 01-4-10 15.3 15.3 0 014-10z" stroke="currentColor" stroke-width="2" fill="none"/>`,
};
---

<BaseLayout title="Fighting Smart Cyber | Operator-Led Offensive and Defensive Cyber Solutions">
  <Hero
    overline="Operator-Led Cyber Solutions"
    title='Fight <span class="highlight">Smarter</span>.<br>Think Like an <span class="highlight">Operator</span>.'
    subtitle="Offensive and defensive cyber solutions from proven operations leaders with TS/SCI-level experience. We build, deploy, and operate — not just advise."
    showStats={true}
    showButtons={true}
    primaryButton={{ text: 'Explore Solutions', href: '/solutions' }}
    secondaryButton={{ text: 'Talk to an Operator', href: '/contact' }}
  />

  <section class="content-section-alt mission-section">
    <div class="container">
      <SectionHeader
        title="Choose Your Mission"
        description="Select the capability that matches your cybersecurity needs. From training to turnkey platforms, every solution is operator-tested."
      />
      <div class="cards-grid stagger-children scroll-animate">
        {homepageTiles.map((tile) => (
          <MissionCard
            icon={tile.icon}
            title={tile.title}
            description={tile.description}
            href={tile.href}
            linkText={tile.linkText}
          />
        ))}
      </div>
    </div>
  </section>

  <section class="bg-image-section overlay-left">
    <img src="/images/site/operator-silhouette.jpg" alt="" class="bg-image" loading="lazy" />
    <div class="bg-image-overlay"></div>
    <div class="container">
      <div class="bg-content scroll-animate-left">
        <h2>Operator-Led.<br>Practitioner-First.</h2>
        <p>Fighting Smart Cyber was founded by three proven cyber operations leaders with decades of combined experience conducting offensive and defensive cyber operations at the highest classification levels.</p>
        <p>We're not career theorists. We're operators who've designed, built, and run cyber capabilities in production. Our team includes a retired three-star general with cyber command experience, a senior officer with deep <span class="tooltip-trigger">DCO<span class="tooltip-inline">Defensive Cyber Operations</span></span>/<span class="tooltip-trigger">OCO<span class="tooltip-inline">Offensive Cyber Operations</span></span> expertise, and a senior enlisted leader who's built secure architectures from the ground up.</p>
        <p>We think holistically in <strong><span class="tooltip-trigger">DOTMLPF-P<span class="tooltip-inline">Doctrine, Organization, Training, Materiel, Leadership, Personnel, Facilities, Policy</span></span></strong> terms — understanding that effective cybersecurity requires alignment across all organizational dimensions.</p>
        <a href="/about/who-we-are" class="btn-primary">Learn More About Us</a>
      </div>
    </div>
  </section>

  <section class="content-section-alt">
    <div class="container">
      <div class="content-with-illustration reverse">
        <div class="content-text scroll-animate-right">
          <h2>Why Fighting Smart?</h2>
          <p>Most cybersecurity companies are led by sales teams or career consultants. We're different. Our founders have:</p>
          <ul>
            <li><strong>Commanded cyber operations</strong> at the highest levels</li>
            <li><strong>Conducted real offensive and defensive ops</strong> in classified environments</li>
            <li><strong>Designed and built</strong> secure architectures and cyber ranges</li>
            <li><strong>Navigated government acquisition</strong> and compliance frameworks</li>
            <li><strong>Deployed full stacks</strong> that are production-ready and exercise-tested</li>
          </ul>
          <p class="quote-text">"We bridge the gap between policy, acquisition, technology, and hands-on execution. That's what makes us different."</p>
        </div>
        <div class="scroll-animate-left">
          <MissionMap />
        </div>
      </div>
    </div>
  </section>

  <section class="dark-section">
    <div class="container">
      <SectionHeader
        title="Leadership Team"
        description="Proven operators with unmatched experience in cyber operations, command, and capability development"
      />
      <div class="leadership-grid stagger-children scroll-animate">
        {leaders.map((leader) => (
          <LeadershipCard role={leader.role} title={leader.title} bio={leader.bio} />
        ))}
      </div>
      <div class="leadership-cta">
        <a href="/about/leadership" class="btn-primary">View Full Leadership Profiles</a>
      </div>
    </div>
  </section>

  <section class="trust-section-modern" aria-label="Trusted credentials">
    <div class="trust-marquee-wrapper">
      <div class="trust-marquee-track">
        {[...trustBadges, ...trustBadges, ...trustBadges, ...trustBadges].map((badge) => (
          <div class="trust-marquee-item">
            <svg width="24" height="24" viewBox="0 0 24 24" fill="none" aria-hidden="true" set:html={trustIcons[badge.icon]}></svg>
            <span>{badge.label}</span>
          </div>
        ))}
      </div>
    </div>
  </section>

  <CTASection
    title="Ready to Fight Smarter?"
    description="Let's discuss how Fighting Smart Cyber can strengthen your cybersecurity posture. Training, platforms, or strategic advisory — we're here to help."
    primaryButton={{ text: 'Schedule a Call', href: '/contact' }}
    secondaryButton={{ text: 'Request Information', href: '/contact' }}
  />
</BaseLayout>
