---
// Admin page - standalone layout without header/footer
---

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Form Submissions - Fighting Smart Cyber</title>
    <style>
        * {
            margin: 0;
            padding: 0;
            box-sizing: border-box;
        }
        body {
            font-family: 'Inter', -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, sans-serif;
            background: linear-gradient(135deg, #000000 0%, #0a2540 50%, #000000 100%);
            background-attachment: fixed;
            min-height: 100vh;
            color: #fff;
        }
        .admin-container {
            max-width: 1400px;
            margin: 0 auto;
            padding: 40px 20px;
        }

        .admin-header {
            display: flex;
            justify-content: space-between;
            align-items: center;
            margin-bottom: 30px;
            padding-bottom: 20px;
            border-bottom: 2px solid rgba(0, 168, 255, 0.3);
            flex-wrap: wrap;
            gap: 15px;
        }

        .admin-header h1 {
            color: #00a8ff;
            margin: 0;
        }

        .header-actions {
            display: flex;
            gap: 10px;
            align-items: center;
            flex-wrap: wrap;
        }

        .btn {
            padding: 10px 20px;
            border-radius: 6px;
            font-weight: 700;
            cursor: pointer;
            transition: all 0.2s;
            border: none;
            font-size: 14px;
        }

        .btn-primary {
            background: linear-gradient(135deg, #00a8ff 0%, #00d4ff 100%);
            color: #000;
        }

        .btn-primary:hover {
            transform: translateY(-2px);
        }

        .btn-danger {
            background: linear-gradient(135deg, #ff4444 0%, #ff6666 100%);
            color: #fff;
        }

        .btn-danger:hover {
            transform: translateY(-2px);
        }

        .btn-danger:disabled {
            opacity: 0.5;
            cursor: not-allowed;
        }

        .btn-secondary {
            background: transparent;
            color: #888;
            border: 1px solid rgba(0, 168, 255, 0.3);
        }

        .btn-secondary:hover {
            color: #00a8ff;
            border-color: #00a8ff;
        }

        .filters {
            background: rgba(0, 0, 0, 0.6);
            padding: 20px;
            border-radius: 8px;
            border: 1px solid rgba(0, 168, 255, 0.2);
            margin-bottom: 30px;
        }

        .filter-row {
            display: grid;
            grid-template-columns: repeat(auto-fit, minmax(200px, 1fr));
            gap: 15px;
            margin-bottom: 15px;
        }

        .filter-group {
            display: flex;
            flex-direction: column;
        }

        .filter-group label {
            color: #00a8ff;
            font-size: 12px;
            text-transform: uppercase;
            letter-spacing: 1px;
            margin-bottom: 8px;
        }

        .filter-group input,
        .filter-group select {
            padding: 10px;
            background: rgba(255, 255, 255, 0.1);
            border: 1px solid rgba(0, 168, 255, 0.3);
            border-radius: 6px;
            color: #fff;
            font-size: 14px;
        }

        .filter-group input:focus,
        .filter-group select:focus {
            outline: none;
            border-color: #00a8ff;
        }

        .filter-group select option {
            background: #0a2540;
            color: #fff;
        }

        .filter-actions {
            display: flex;
            gap: 10px;
            justify-content: flex-end;
            margin-top: 15px;
        }

        .stats {
            display: grid;
            grid-template-columns: repeat(auto-fit, minmax(200px, 1fr));
            gap: 20px;
            margin-bottom: 30px;
        }

        .stat-card {
            background: rgba(0, 0, 0, 0.6);
            padding: 20px;
            border-radius: 8px;
            border: 1px solid rgba(0, 168, 255, 0.2);
        }

        .stat-card h3 {
            color: #00a8ff;
            margin: 0 0 10px 0;
            font-size: 14px;
            text-transform: uppercase;
            letter-spacing: 1px;
        }

        .stat-card .value {
            font-size: 32px;
            font-weight: 700;
            color: #fff;
        }

        .bulk-actions {
            background: rgba(0, 0, 0, 0.6);
            padding: 15px 20px;
            border-radius: 8px;
            border: 1px solid rgba(0, 168, 255, 0.2);
            margin-bottom: 20px;
            display: none;
            align-items: center;
            justify-content: space-between;
        }

        .bulk-actions.active {
            display: flex;
        }

        .bulk-actions-left {
            display: flex;
            gap: 15px;
            align-items: center;
        }

        /* Table Layout */
        .submissions-table-wrap {
            background: rgba(0, 0, 0, 0.6);
            border: 1px solid rgba(0, 168, 255, 0.2);
            border-radius: 12px;
            overflow: hidden;
        }

        .submissions-table {
            width: 100%;
            border-collapse: collapse;
            font-size: 14px;
        }

        .submissions-table thead {
            background: rgba(0, 168, 255, 0.1);
            border-bottom: 1px solid rgba(0, 168, 255, 0.2);
        }

        .submissions-table th {
            padding: 14px 16px;
            text-align: left;
            font-size: 11px;
            text-transform: uppercase;
            letter-spacing: 1px;
            color: #00a8ff;
            font-weight: 600;
            white-space: nowrap;
            cursor: pointer;
            user-select: none;
        }

        .submissions-table th:hover {
            color: #00d4ff;
        }

        .submissions-table th.th-checkbox {
            width: 40px;
            cursor: default;
        }

        .submissions-table th.th-expand {
            width: 40px;
            cursor: default;
        }

        .submissions-table td {
            padding: 12px 16px;
            color: #ccc;
            border-top: 1px solid rgba(255, 255, 255, 0.05);
            vertical-align: middle;
        }

        .submissions-table tbody tr {
            transition: background 0.15s;
        }

        .submissions-table tbody tr:hover {
            background: rgba(0, 168, 255, 0.05);
        }

        .submissions-table tbody tr.selected {
            background: rgba(0, 168, 255, 0.08);
        }

        .submissions-table tbody tr.selected td {
            border-top-color: rgba(0, 168, 255, 0.15);
        }

        .submissions-table input[type="checkbox"] {
            width: 18px;
            height: 18px;
            cursor: pointer;
            accent-color: #00a8ff;
        }

        .td-name {
            font-weight: 600;
            color: #fff;
        }

        .td-email a {
            color: #00a8ff;
            text-decoration: none;
        }

        .td-email a:hover {
            text-decoration: underline;
        }

        .td-date {
            white-space: nowrap;
            color: #888;
            font-size: 13px;
        }

        .submission-badge {
            display: inline-block;
            padding: 3px 10px;
            border-radius: 20px;
            font-size: 10px;
            font-weight: 600;
            text-transform: uppercase;
            letter-spacing: 0.5px;
            white-space: nowrap;
        }

        .submission-badge.contact {
            background: rgba(0, 168, 255, 0.15);
            color: #00a8ff;
            border: 1px solid rgba(0, 168, 255, 0.3);
        }

        .submission-badge.bundle {
            background: rgba(0, 212, 255, 0.15);
            color: #00d4ff;
            border: 1px solid rgba(0, 212, 255, 0.3);
        }

        .expand-btn {
            background: none;
            border: 1px solid rgba(0, 168, 255, 0.3);
            color: #00a8ff;
            width: 28px;
            height: 28px;
            border-radius: 6px;
            cursor: pointer;
            font-size: 14px;
            display: flex;
            align-items: center;
            justify-content: center;
            transition: all 0.2s;
        }

        .expand-btn:hover {
            background: rgba(0, 168, 255, 0.15);
            border-color: #00a8ff;
        }

        .expand-btn.open {
            background: rgba(0, 168, 255, 0.15);
            transform: rotate(90deg);
        }

        .detail-row td {
            padding: 0;
            border-top: none;
        }

        .detail-content {
            padding: 16px 16px 20px 56px;
            display: none;
            border-top: 1px solid rgba(0, 168, 255, 0.1);
            background: rgba(0, 0, 0, 0.3);
        }

        .detail-content.open {
            display: block;
        }

        .detail-grid {
            display: grid;
            grid-template-columns: repeat(auto-fit, minmax(180px, 1fr));
            gap: 14px 28px;
            margin-bottom: 16px;
        }

        .detail-field label {
            display: block;
            color: #00a8ff;
            font-size: 10px;
            text-transform: uppercase;
            letter-spacing: 1px;
            margin-bottom: 3px;
            opacity: 0.7;
        }

        .detail-field .detail-value {
            color: #ddd;
            font-size: 14px;
        }

        .detail-message {
            background: rgba(0, 168, 255, 0.06);
            padding: 14px 16px;
            border-radius: 8px;
            border-left: 3px solid rgba(0, 168, 255, 0.4);
            color: #ccc;
            font-size: 14px;
            line-height: 1.6;
            white-space: pre-wrap;
        }

        .detail-message-label {
            color: #00a8ff;
            font-size: 10px;
            text-transform: uppercase;
            letter-spacing: 1px;
            margin-bottom: 8px;
            opacity: 0.7;
        }

        .loading {
            text-align: center;
            padding: 60px 20px;
            color: #00a8ff;
        }

        .empty-state {
            text-align: center;
            padding: 60px 20px;
            color: #888;
        }

        .modal {
            display: none;
            position: fixed;
            top: 0;
            left: 0;
            width: 100%;
            height: 100%;
            background: rgba(0, 0, 0, 0.8);
            z-index: 1000;
            align-items: center;
            justify-content: center;
        }

        .modal.active {
            display: flex;
        }

        .modal-content {
            background: #0a2540;
            padding: 30px;
            border-radius: 12px;
            border: 1px solid rgba(0, 168, 255, 0.3);
            max-width: 500px;
            width: 90%;
        }

        .modal-content h2 {
            color: #00a8ff;
            margin: 0 0 15px 0;
        }

        .modal-content p {
            color: #fff;
            margin-bottom: 20px;
        }

        .modal-actions {
            display: flex;
            gap: 10px;
            justify-content: flex-end;
        }

        /* Mobile Optimizations */
        @media (max-width: 768px) {
            .admin-container {
                padding: 20px 15px;
            }

            .admin-header {
                flex-direction: column;
                align-items: flex-start;
                gap: 15px;
            }

            .header-actions {
                width: 100%;
                justify-content: stretch;
            }

            .header-actions .btn {
                flex: 1;
                min-height: 48px;
            }

            .filter-row {
                grid-template-columns: 1fr !important;
            }

            .filter-group input,
            .filter-group select {
                padding: 14px;
                font-size: 16px;
                min-height: 48px;
            }

            .filter-group label {
                font-size: 14px;
            }

            .stats {
                grid-template-columns: repeat(2, 1fr);
            }

            .stat-card .value {
                font-size: 24px;
            }

            .submissions-table-wrap {
                overflow-x: auto;
                -webkit-overflow-scrolling: touch;
            }

            .submissions-table {
                min-width: 700px;
            }

            .detail-grid {
                grid-template-columns: 1fr;
            }

            .detail-content {
                padding-left: 16px;
            }

            .bulk-actions {
                flex-direction: column;
                align-items: stretch;
            }

            .bulk-actions-left {
                justify-content: space-between;
            }

            .btn-danger {
                width: 100%;
                min-height: 48px;
            }
        }

        @media (max-width: 480px) {
            .stats {
                grid-template-columns: 1fr;
            }

            .filter-actions {
                flex-direction: column;
            }

            .filter-actions .btn {
                width: 100%;
            }
        }
    </style>
</head>
<body>
    <div class="admin-container">
        <!-- Login Form (shown when not authenticated) -->
        <div id="loginContainer" style="display: none;">
            <div style="max-width: 400px; margin: 100px auto; background: rgba(0, 0, 0, 0.6); padding: 40px; border-radius: 12px; border: 1px solid rgba(0, 168, 255, 0.3);">
                <h1 style="color: #00a8ff; margin-bottom: 30px; text-align: center;">Admin Login</h1>
                <form id="loginForm">
                    <div class="filter-group" style="margin-bottom: 20px;">
                        <label>Email</label>
                        <input type="email" id="loginEmail" required style="width: 100%; box-sizing: border-box;">
                    </div>
                    <div class="filter-group" style="margin-bottom: 20px;">
                        <label>Password</label>
                        <input type="password" id="loginPassword" required style="width: 100%; box-sizing: border-box;">
                    </div>
                    <div id="loginError" style="color: #ff4444; margin-bottom: 15px; display: none;"></div>
                    <button type="submit" class="btn btn-primary" style="width: 100%;">Sign In</button>
                </form>
                <p style="text-align: center; margin-top: 20px; color: #888;">
                    <a href="/" style="color: #00a8ff;">← Back to Home</a>
                </p>
            </div>
        </div>

        <!-- Admin Content (shown when authenticated) -->
        <div id="adminContent" style="display: none;">
        <div class="admin-header">
            <h1>Form Submissions</h1>
            <div class="header-actions">
                <a href="/" class="btn btn-secondary" style="text-decoration: none;">← Home</a>
                <button class="btn btn-primary" onclick="loadSubmissions()">Refresh</button>
                <button class="btn btn-secondary" onclick="handleLogout()">Logout</button>
            </div>
        </div>

        <div class="filters">
            <div class="filter-row">
                <div class="filter-group">
                    <label>Search</label>
                    <input type="text" id="searchFilter" placeholder="Name, email, organization..." oninput="applyFilters()">
                </div>
                <div class="filter-group">
                    <label>Interest</label>
                    <select id="interestFilter" onchange="applyFilters()">
                        <option value="">All</option>
                    </select>
                </div>
                <div class="filter-group">
                    <label>Organization Type</label>
                    <select id="orgTypeFilter" onchange="applyFilters()">
                        <option value="">All</option>
                    </select>
                </div>
                <div class="filter-group">
                    <label>Date From</label>
                    <input type="date" id="dateFromFilter" onchange="applyFilters()">
                </div>
                <div class="filter-group">
                    <label>Date To</label>
                    <input type="date" id="dateToFilter" onchange="applyFilters()">
                </div>
            </div>
            <div class="filter-actions">
                <button class="btn btn-secondary" onclick="clearFilters()">Clear Filters</button>
            </div>
        </div>

        <div class="bulk-actions" id="bulkActions">
            <div class="bulk-actions-left">
                <span id="selectedCount">0 selected</span>
            </div>
            <button class="btn btn-danger" id="deleteSelected" onclick="confirmDelete()" disabled>Delete Selected</button>
        </div>

        <div class="stats" id="statsContainer"></div>

        <div id="loading" class="loading">Loading submissions...</div>
        <div id="submissionsContainer" style="display: none;">
            <div class="submissions-table-wrap">
                <table class="submissions-table">
                    <thead>
                        <tr>
                            <th class="th-checkbox"><input type="checkbox" id="selectAllTable" onchange="toggleSelectAll()"></th>
                            <th class="th-expand"></th>
                            <th>Date</th>
                            <th>Type</th>
                            <th>Name</th>
                            <th>Email</th>
                            <th>Organization</th>
                            <th>Interest</th>
                            <th>Timeframe</th>
                        </tr>
                    </thead>
                    <tbody id="tableBody"></tbody>
                </table>
            </div>
        </div>
        <div id="emptyState" class="empty-state" style="display: none;">
            <h2>No submissions found</h2>
            <p>Try adjusting your filters or check back later.</p>
        </div>
    </div>

    <div class="modal" id="deleteModal">
        <div class="modal-content">
            <h2>Confirm Delete</h2>
            <p id="deleteMessage">Are you sure you want to delete the selected submissions? This action cannot be undone.</p>
            <div class="modal-actions">
                <button class="btn btn-secondary" onclick="closeDeleteModal()">Cancel</button>
                <button class="btn btn-danger" onclick="handleDeleteSubmissions()">Delete</button>
            </div>
        </div>
    </div>
        </div>

    <script is:inline src="https://cdn.jsdelivr.net/npm/@supabase/supabase-js@2"></script>
    <script is:inline src="/js/supabase-client.js"></script>
    <script is:inline>
        let allSubmissions = [];
        let filteredSubmissions = [];
        let selectedIds = new Set();

        // Auth state management
        async function checkAuth() {
            const session = await getSession();
            if (session) {
                document.getElementById('loginContainer').style.display = 'none';
                document.getElementById('adminContent').style.display = 'block';
                loadSubmissions();
            } else {
                document.getElementById('loginContainer').style.display = 'block';
                document.getElementById('adminContent').style.display = 'none';
            }
        }

        // Login form handler
        document.getElementById('loginForm').addEventListener('submit', async function(e) {
            e.preventDefault();
            const email = document.getElementById('loginEmail').value;
            const password = document.getElementById('loginPassword').value;
            const errorDiv = document.getElementById('loginError');

            try {
                await signIn(email, password);
                errorDiv.style.display = 'none';
                checkAuth();
            } catch (error) {
                errorDiv.textContent = error.message || 'Invalid email or password';
                errorDiv.style.display = 'block';
            }
        });

        // Logout handler
        async function handleLogout() {
            await signOut();
            checkAuth();
        }

        async function loadSubmissions() {
            document.getElementById('loading').style.display = 'block';
            document.getElementById('submissionsContainer').style.display = 'none';
            document.getElementById('emptyState').style.display = 'none';

            try {
                const submissions = await getSubmissions();
                document.getElementById('loading').style.display = 'none';

                // Transform to match old format for compatibility
                allSubmissions = submissions.map(sub => ({
                    id: sub.id,
                    timestamp: sub.created_at,
                    submission: {
                        name: sub.name,
                        email: sub.email,
                        organization: sub.organization,
                        role: sub.role,
                        orgType: sub.org_type,
                        interest: sub.interest,
                        timeframe: sub.timeframe,
                        message: sub.message
                    }
                }));

                selectedIds.clear();
                populateFilters(allSubmissions);
                applyFilters();
            } catch (error) {
                document.getElementById('loading').style.display = 'none';
                document.getElementById('emptyState').style.display = 'block';
                console.error('Error loading submissions:', error);
            }
        }

        function populateFilters(submissions) {
            const interests = new Set();
            const orgTypes = new Set();

            submissions.forEach(sub => {
                if (sub.submission.interest) interests.add(sub.submission.interest);
                if (sub.submission.orgType) orgTypes.add(sub.submission.orgType);
            });

            const interestFilter = document.getElementById('interestFilter');
            interestFilter.textContent = '';
            const allOption = document.createElement('option');
            allOption.value = '';
            allOption.textContent = 'All';
            interestFilter.appendChild(allOption);
            Array.from(interests).sort().forEach(interest => {
                const option = document.createElement('option');
                option.value = interest;
                option.textContent = interest.charAt(0).toUpperCase() + interest.slice(1);
                interestFilter.appendChild(option);
            });

            const orgTypeFilter = document.getElementById('orgTypeFilter');
            orgTypeFilter.textContent = '';
            const allOrgOption = document.createElement('option');
            allOrgOption.value = '';
            allOrgOption.textContent = 'All';
            orgTypeFilter.appendChild(allOrgOption);
            Array.from(orgTypes).sort().forEach(orgType => {
                const option = document.createElement('option');
                option.value = orgType;
                option.textContent = orgType.charAt(0).toUpperCase() + orgType.slice(1);
                orgTypeFilter.appendChild(option);
            });
        }

        function applyFilters() {
            const searchTerm = document.getElementById('searchFilter').value.toLowerCase();
            const interestFilter = document.getElementById('interestFilter').value;
            const orgTypeFilter = document.getElementById('orgTypeFilter').value;
            const dateFrom = document.getElementById('dateFromFilter').value;
            const dateTo = document.getElementById('dateToFilter').value;

            filteredSubmissions = allSubmissions.filter(sub => {
                // Search filter
                if (searchTerm) {
                    const searchableText = [
                        sub.submission.name,
                        sub.submission.email,
                        sub.submission.organization,
                        sub.submission.role,
                        sub.submission.message
                    ].join(' ').toLowerCase();

                    if (!searchableText.includes(searchTerm)) return false;
                }

                // Interest filter
                if (interestFilter && sub.submission.interest !== interestFilter) return false;

                // Org type filter
                if (orgTypeFilter && sub.submission.orgType !== orgTypeFilter) return false;

                // Date filters
                const subDate = new Date(sub.timestamp).toISOString().split('T')[0];
                if (dateFrom && subDate < dateFrom) return false;
                if (dateTo && subDate > dateTo) return false;

                return true;
            });

            displayStats(filteredSubmissions);
            displaySubmissions(filteredSubmissions);
            updateBulkActions();
        }

        function clearFilters() {
            document.getElementById('searchFilter').value = '';
            document.getElementById('interestFilter').value = '';
            document.getElementById('orgTypeFilter').value = '';
            document.getElementById('dateFromFilter').value = '';
            document.getElementById('dateToFilter').value = '';
            applyFilters();
        }

        function createStatCard(title, value) {
            const card = document.createElement('div');
            card.className = 'stat-card';

            const h3 = document.createElement('h3');
            h3.textContent = title;

            const valueDiv = document.createElement('div');
            valueDiv.className = 'value';
            valueDiv.textContent = value;

            card.appendChild(h3);
            card.appendChild(valueDiv);
            return card;
        }

        function displayStats(submissions) {
            const total = submissions.length;
            const byInterest = {};
            const byOrgType = {};

            submissions.forEach(sub => {
                const interest = sub.submission.interest || 'Not specified';
                const orgType = sub.submission.orgType || 'Not specified';

                byInterest[interest] = (byInterest[interest] || 0) + 1;
                byOrgType[orgType] = (byOrgType[orgType] || 0) + 1;
            });

            const topInterest = Object.entries(byInterest).sort((a, b) => b[1] - a[1])[0];
            const uniqueOrgs = new Set(submissions.map(s => s.submission.organization)).size;

            const statsContainer = document.getElementById('statsContainer');
            statsContainer.textContent = '';

            statsContainer.appendChild(createStatCard('Total Submissions', String(total)));
            statsContainer.appendChild(createStatCard('Filtered Results', String(submissions.length)));
            statsContainer.appendChild(createStatCard('Top Interest', topInterest ? topInterest[0] : 'N/A'));
            statsContainer.appendChild(createStatCard('Unique Organizations', String(uniqueOrgs)));
        }

        function formatDate(timestamp) {
            const date = new Date(timestamp);
            return date.toLocaleDateString('en-US', { month: 'short', day: 'numeric', year: 'numeric' });
        }

        function formatTime(timestamp) {
            const date = new Date(timestamp);
            return date.toLocaleTimeString('en-US', { hour: 'numeric', minute: '2-digit' });
        }

        function createDetailField(labelText, valueText) {
            const field = document.createElement('div');
            field.className = 'detail-field';
            const label = document.createElement('label');
            label.textContent = labelText;
            const value = document.createElement('div');
            value.className = 'detail-value';
            value.textContent = valueText;
            field.appendChild(label);
            field.appendChild(value);
            return field;
        }

        function toggleDetail(id) {
            const detail = document.getElementById('detail-' + id);
            const btn = document.getElementById('expand-' + id);
            if (detail) {
                detail.classList.toggle('open');
                btn.classList.toggle('open');
            }
        }

        function displaySubmissions(submissions) {
            const container = document.getElementById('submissionsContainer');
            const tbody = document.getElementById('tableBody');
            tbody.textContent = '';

            if (submissions.length === 0) {
                container.style.display = 'none';
                document.getElementById('emptyState').style.display = 'block';
                return;
            }

            document.getElementById('emptyState').style.display = 'none';

            // Sort by timestamp (newest first)
            submissions.sort((a, b) => new Date(b.timestamp) - new Date(a.timestamp));

            submissions.forEach(sub => {
                const isBundleRequest = sub.submission.interest === 'Custom Bundle Request';
                const hasDetails = sub.submission.message || sub.submission.role || sub.submission.orgType;

                // Main row
                const tr = document.createElement('tr');
                tr.dataset.id = sub.id;
                if (selectedIds.has(sub.id)) tr.classList.add('selected');

                // Checkbox
                const tdCheck = document.createElement('td');
                const checkbox = document.createElement('input');
                checkbox.type = 'checkbox';
                checkbox.checked = selectedIds.has(sub.id);
                checkbox.onchange = function() { toggleSelection(sub.id); };
                tdCheck.appendChild(checkbox);
                tr.appendChild(tdCheck);

                // Expand button
                const tdExpand = document.createElement('td');
                if (hasDetails) {
                    const expandBtn = document.createElement('button');
                    expandBtn.className = 'expand-btn';
                    expandBtn.id = 'expand-' + sub.id;
                    expandBtn.textContent = '\u25B6';
                    expandBtn.onclick = function() { toggleDetail(sub.id); };
                    tdExpand.appendChild(expandBtn);
                }
                tr.appendChild(tdExpand);

                // Date
                const tdDate = document.createElement('td');
                tdDate.className = 'td-date';
                tdDate.appendChild(document.createTextNode(formatDate(sub.timestamp)));
                tdDate.appendChild(document.createElement('br'));
                tdDate.appendChild(document.createTextNode(formatTime(sub.timestamp)));
                tr.appendChild(tdDate);

                // Type badge
                const tdType = document.createElement('td');
                const badge = document.createElement('span');
                badge.className = 'submission-badge ' + (isBundleRequest ? 'bundle' : 'contact');
                badge.textContent = isBundleRequest ? 'Bundle' : 'Contact';
                tdType.appendChild(badge);
                tr.appendChild(tdType);

                // Name
                const tdName = document.createElement('td');
                tdName.className = 'td-name';
                tdName.textContent = sub.submission.name || '\u2014';
                tr.appendChild(tdName);

                // Email
                const tdEmail = document.createElement('td');
                tdEmail.className = 'td-email';
                if (sub.submission.email) {
                    const link = document.createElement('a');
                    link.href = 'mailto:' + sub.submission.email;
                    link.textContent = sub.submission.email;
                    tdEmail.appendChild(link);
                } else {
                    tdEmail.textContent = '\u2014';
                }
                tr.appendChild(tdEmail);

                // Organization
                const tdOrg = document.createElement('td');
                tdOrg.textContent = sub.submission.organization || '\u2014';
                tr.appendChild(tdOrg);

                // Interest
                const tdInterest = document.createElement('td');
                tdInterest.textContent = isBundleRequest ? 'Custom Bundle' : (sub.submission.interest || '\u2014');
                tr.appendChild(tdInterest);

                // Timeframe
                const tdTime = document.createElement('td');
                tdTime.textContent = sub.submission.timeframe || '\u2014';
                tr.appendChild(tdTime);

                tbody.appendChild(tr);

                // Detail/expandable row
                if (hasDetails) {
                    const detailTr = document.createElement('tr');
                    detailTr.className = 'detail-row';
                    const detailTd = document.createElement('td');
                    detailTd.colSpan = 9;

                    const detailContent = document.createElement('div');
                    detailContent.className = 'detail-content';
                    detailContent.id = 'detail-' + sub.id;

                    // Extra fields grid
                    const hasExtraFields = sub.submission.role || sub.submission.orgType;
                    if (hasExtraFields) {
                        const grid = document.createElement('div');
                        grid.className = 'detail-grid';

                        if (sub.submission.role) {
                            grid.appendChild(createDetailField('Role / Title', sub.submission.role));
                        }
                        if (sub.submission.orgType) {
                            grid.appendChild(createDetailField(isBundleRequest ? 'Environment' : 'Org Type', sub.submission.orgType));
                        }
                        detailContent.appendChild(grid);
                    }

                    // Message
                    if (sub.submission.message) {
                        const msgLabel = document.createElement('div');
                        msgLabel.className = 'detail-message-label';
                        msgLabel.textContent = isBundleRequest ? 'Details' : 'Message';
                        detailContent.appendChild(msgLabel);

                        const msgDiv = document.createElement('div');
                        msgDiv.className = 'detail-message';
                        msgDiv.textContent = sub.submission.message;
                        detailContent.appendChild(msgDiv);
                    }

                    detailTd.appendChild(detailContent);
                    detailTr.appendChild(detailTd);
                    tbody.appendChild(detailTr);
                }
            });

            container.style.display = 'block';
        }

        function toggleSelection(id) {
            if (selectedIds.has(id)) {
                selectedIds.delete(id);
            } else {
                selectedIds.add(id);
            }
            updateBulkActions();

            // Update row styling
            const row = document.querySelector('tr[data-id="' + id + '"]');
            if (row) {
                const checkbox = row.querySelector('input[type="checkbox"]');
                if (checkbox) checkbox.checked = selectedIds.has(id);
                if (selectedIds.has(id)) {
                    row.classList.add('selected');
                } else {
                    row.classList.remove('selected');
                }
            }
        }

        function toggleSelectAll() {
            const selectAllEl = document.getElementById('selectAllTable');
            const isChecked = selectAllEl.checked;

            if (isChecked) {
                filteredSubmissions.forEach(sub => selectedIds.add(sub.id));
            } else {
                selectedIds.clear();
            }

            // Update all row checkboxes
            document.querySelectorAll('#tableBody tr[data-id] input[type="checkbox"]').forEach(cb => {
                cb.checked = isChecked;
            });

            // Update row styling
            document.querySelectorAll('#tableBody tr[data-id]').forEach(row => {
                if (isChecked) {
                    row.classList.add('selected');
                } else {
                    row.classList.remove('selected');
                }
            });

            updateBulkActions();
        }

        function updateBulkActions() {
            const count = selectedIds.size;
            const bulkActions = document.getElementById('bulkActions');
            const deleteBtn = document.getElementById('deleteSelected');
            const selectedCount = document.getElementById('selectedCount');
            const selectAllEl = document.getElementById('selectAllTable');

            if (count > 0) {
                bulkActions.classList.add('active');
                deleteBtn.disabled = false;
                selectedCount.textContent = count + ' selected';
                selectAllEl.checked = count === filteredSubmissions.length && filteredSubmissions.length > 0;
            } else {
                bulkActions.classList.remove('active');
                deleteBtn.disabled = true;
                selectedCount.textContent = '0 selected';
                selectAllEl.checked = false;
            }
        }

        function confirmDelete() {
            const count = selectedIds.size;
            document.getElementById('deleteMessage').textContent =
                'Are you sure you want to delete ' + count + ' submission' + (count === 1 ? '' : 's') + '? This action cannot be undone.';
            document.getElementById('deleteModal').classList.add('active');
        }

        function closeDeleteModal() {
            document.getElementById('deleteModal').classList.remove('active');
        }

        async function handleDeleteSubmissions() {
            const idsToDelete = Array.from(selectedIds);

            closeDeleteModal();
            document.getElementById('loading').style.display = 'block';
            document.getElementById('submissionsContainer').style.display = 'none';

            try {
                await deleteSubmissions(idsToDelete);
                selectedIds.clear();
                loadSubmissions();
            } catch (error) {
                alert('Error deleting submissions: ' + error.message);
                document.getElementById('loading').style.display = 'none';
                displaySubmissions(filteredSubmissions);
            }
        }

        // Check auth on page load
        checkAuth();

        // Auto-refresh every 30 seconds (only if authenticated and not selecting)
        setInterval(async () => {
            const session = await getSession();
            if (session && selectedIds.size === 0) {
                loadSubmissions();
            }
        }, 30000);
    </script>
</body>
</html>
