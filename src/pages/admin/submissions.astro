---
// Admin page - standalone layout without header/footer
---

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Form Submissions - Fighting Smart Cyber</title>
    <style>
        * {
            margin: 0;
            padding: 0;
            box-sizing: border-box;
        }
        body {
            font-family: 'Inter', -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, sans-serif;
            background: linear-gradient(135deg, #000000 0%, #0a2540 50%, #000000 100%);
            background-attachment: fixed;
            min-height: 100vh;
            color: #fff;
        }
        .admin-container {
            max-width: 1400px;
            margin: 0 auto;
            padding: 40px 20px;
        }

        .admin-header {
            display: flex;
            justify-content: space-between;
            align-items: center;
            margin-bottom: 30px;
            padding-bottom: 20px;
            border-bottom: 2px solid rgba(0, 168, 255, 0.3);
            flex-wrap: wrap;
            gap: 15px;
        }

        .admin-header h1 {
            color: #00a8ff;
            margin: 0;
        }

        .header-actions {
            display: flex;
            gap: 10px;
            align-items: center;
            flex-wrap: wrap;
        }

        .btn {
            padding: 10px 20px;
            border-radius: 6px;
            font-weight: 700;
            cursor: pointer;
            transition: all 0.2s;
            border: none;
            font-size: 14px;
        }

        .btn-primary {
            background: linear-gradient(135deg, #00a8ff 0%, #00d4ff 100%);
            color: #000;
        }

        .btn-primary:hover {
            transform: translateY(-2px);
        }

        .btn-danger {
            background: linear-gradient(135deg, #ff4444 0%, #ff6666 100%);
            color: #fff;
        }

        .btn-danger:hover {
            transform: translateY(-2px);
        }

        .btn-danger:disabled {
            opacity: 0.5;
            cursor: not-allowed;
        }

        .btn-secondary {
            background: transparent;
            color: #888;
            border: 1px solid rgba(0, 168, 255, 0.3);
        }

        .btn-secondary:hover {
            color: #00a8ff;
            border-color: #00a8ff;
        }

        .filters {
            background: rgba(0, 0, 0, 0.6);
            padding: 20px;
            border-radius: 8px;
            border: 1px solid rgba(0, 168, 255, 0.2);
            margin-bottom: 30px;
        }

        .filter-row {
            display: grid;
            grid-template-columns: repeat(auto-fit, minmax(200px, 1fr));
            gap: 15px;
            margin-bottom: 15px;
        }

        .filter-group {
            display: flex;
            flex-direction: column;
        }

        .filter-group label {
            color: #00a8ff;
            font-size: 12px;
            text-transform: uppercase;
            letter-spacing: 1px;
            margin-bottom: 8px;
        }

        .filter-group input,
        .filter-group select {
            padding: 10px;
            background: rgba(255, 255, 255, 0.1);
            border: 1px solid rgba(0, 168, 255, 0.3);
            border-radius: 6px;
            color: #fff;
            font-size: 14px;
        }

        .filter-group input:focus,
        .filter-group select:focus {
            outline: none;
            border-color: #00a8ff;
        }

        .filter-group select option {
            background: #0a2540;
            color: #fff;
        }

        .filter-actions {
            display: flex;
            gap: 10px;
            justify-content: flex-end;
            margin-top: 15px;
        }

        .stats {
            display: grid;
            grid-template-columns: repeat(auto-fit, minmax(200px, 1fr));
            gap: 20px;
            margin-bottom: 30px;
        }

        .stat-card {
            background: rgba(0, 0, 0, 0.6);
            padding: 20px;
            border-radius: 8px;
            border: 1px solid rgba(0, 168, 255, 0.2);
        }

        .stat-card h3 {
            color: #00a8ff;
            margin: 0 0 10px 0;
            font-size: 14px;
            text-transform: uppercase;
            letter-spacing: 1px;
        }

        .stat-card .value {
            font-size: 32px;
            font-weight: 700;
            color: #fff;
        }

        .bulk-actions {
            background: rgba(0, 0, 0, 0.6);
            padding: 15px 20px;
            border-radius: 8px;
            border: 1px solid rgba(0, 168, 255, 0.2);
            margin-bottom: 20px;
            display: none;
            align-items: center;
            justify-content: space-between;
        }

        .bulk-actions.active {
            display: flex;
        }

        .bulk-actions-left {
            display: flex;
            gap: 15px;
            align-items: center;
        }

        .submissions-list {
            display: flex;
            flex-direction: column;
            gap: 20px;
        }

        .submission-card {
            background: rgba(0, 0, 0, 0.6);
            border: 1px solid rgba(0, 168, 255, 0.2);
            border-radius: 12px;
            padding: 0;
            transition: all 0.3s;
            overflow: hidden;
        }

        .submission-card:hover {
            border-color: #00a8ff;
            box-shadow: 0 4px 20px rgba(0, 168, 255, 0.2);
        }

        .submission-card.selected {
            border-color: #00d4ff;
            background: rgba(0, 168, 255, 0.05);
        }

        .submission-card-inner {
            display: flex;
            gap: 20px;
            padding: 24px;
        }

        .submission-checkbox {
            display: flex;
            align-items: flex-start;
            padding-top: 2px;
            flex-shrink: 0;
        }

        .submission-checkbox input[type="checkbox"] {
            width: 20px;
            height: 20px;
            cursor: pointer;
            accent-color: #00a8ff;
        }

        .submission-content {
            flex: 1;
            min-width: 0;
        }

        .submission-header {
            display: flex;
            justify-content: space-between;
            align-items: center;
            margin-bottom: 20px;
            padding-bottom: 16px;
            border-bottom: 1px solid rgba(0, 168, 255, 0.15);
            flex-wrap: wrap;
            gap: 10px;
        }

        .submission-header-left {
            display: flex;
            align-items: center;
            gap: 12px;
            flex-wrap: wrap;
        }

        .submission-name {
            font-size: 18px;
            font-weight: 700;
            color: #fff;
        }

        .submission-badge {
            display: inline-block;
            padding: 3px 10px;
            border-radius: 20px;
            font-size: 11px;
            font-weight: 600;
            text-transform: uppercase;
            letter-spacing: 0.5px;
        }

        .submission-badge.contact {
            background: rgba(0, 168, 255, 0.15);
            color: #00a8ff;
            border: 1px solid rgba(0, 168, 255, 0.3);
        }

        .submission-badge.bundle {
            background: rgba(0, 212, 255, 0.15);
            color: #00d4ff;
            border: 1px solid rgba(0, 212, 255, 0.3);
        }

        .submission-timestamp {
            font-size: 13px;
            color: #666;
        }

        .submission-fields-grid {
            display: grid;
            grid-template-columns: repeat(auto-fit, minmax(200px, 1fr));
            gap: 16px 24px;
            margin-bottom: 16px;
        }

        .submission-field {
            margin-bottom: 0;
        }

        .submission-field label {
            display: block;
            color: #00a8ff;
            font-size: 11px;
            text-transform: uppercase;
            letter-spacing: 1px;
            margin-bottom: 4px;
            opacity: 0.8;
        }

        .submission-field .value {
            color: #fff;
            font-size: 15px;
            line-height: 1.4;
            word-break: break-word;
        }

        .submission-field .value.empty {
            color: #555;
            font-style: italic;
        }

        .submission-message {
            background: rgba(0, 168, 255, 0.08);
            padding: 16px;
            border-radius: 8px;
            border-left: 3px solid #00a8ff;
            margin-top: 4px;
            line-height: 1.6;
            font-size: 14px;
        }

        .loading {
            text-align: center;
            padding: 60px 20px;
            color: #00a8ff;
        }

        .empty-state {
            text-align: center;
            padding: 60px 20px;
            color: #888;
        }

        .modal {
            display: none;
            position: fixed;
            top: 0;
            left: 0;
            width: 100%;
            height: 100%;
            background: rgba(0, 0, 0, 0.8);
            z-index: 1000;
            align-items: center;
            justify-content: center;
        }

        .modal.active {
            display: flex;
        }

        .modal-content {
            background: #0a2540;
            padding: 30px;
            border-radius: 12px;
            border: 1px solid rgba(0, 168, 255, 0.3);
            max-width: 500px;
            width: 90%;
        }

        .modal-content h2 {
            color: #00a8ff;
            margin: 0 0 15px 0;
        }

        .modal-content p {
            color: #fff;
            margin-bottom: 20px;
        }

        .modal-actions {
            display: flex;
            gap: 10px;
            justify-content: flex-end;
        }

        /* Mobile Optimizations */
        @media (max-width: 768px) {
            .admin-container {
                padding: 20px 15px;
            }

            .admin-header {
                flex-direction: column;
                align-items: flex-start;
                gap: 15px;
            }

            .header-actions {
                width: 100%;
                justify-content: stretch;
            }

            .header-actions .btn {
                flex: 1;
                min-height: 48px;
            }

            .filter-row {
                grid-template-columns: 1fr !important;
            }

            .filter-group input,
            .filter-group select {
                padding: 14px;
                font-size: 16px;
                min-height: 48px;
            }

            .filter-group label {
                font-size: 14px;
            }

            .stats {
                grid-template-columns: repeat(2, 1fr);
            }

            .stat-card .value {
                font-size: 24px;
            }

            .submission-card-inner {
                flex-direction: column;
                gap: 15px;
            }

            .submission-fields-grid {
                grid-template-columns: 1fr !important;
            }

            .submission-checkbox input[type="checkbox"] {
                width: 24px;
                height: 24px;
            }

            .bulk-actions {
                flex-direction: column;
                align-items: stretch;
            }

            .bulk-actions-left {
                justify-content: space-between;
            }

            .btn-danger {
                width: 100%;
                min-height: 48px;
            }
        }

        @media (max-width: 480px) {
            .stats {
                grid-template-columns: 1fr;
            }

            .filter-actions {
                flex-direction: column;
            }

            .filter-actions .btn {
                width: 100%;
            }
        }
    </style>
</head>
<body>
    <div class="admin-container">
        <!-- Login Form (shown when not authenticated) -->
        <div id="loginContainer" style="display: none;">
            <div style="max-width: 400px; margin: 100px auto; background: rgba(0, 0, 0, 0.6); padding: 40px; border-radius: 12px; border: 1px solid rgba(0, 168, 255, 0.3);">
                <h1 style="color: #00a8ff; margin-bottom: 30px; text-align: center;">Admin Login</h1>
                <form id="loginForm">
                    <div class="filter-group" style="margin-bottom: 20px;">
                        <label>Email</label>
                        <input type="email" id="loginEmail" required style="width: 100%; box-sizing: border-box;">
                    </div>
                    <div class="filter-group" style="margin-bottom: 20px;">
                        <label>Password</label>
                        <input type="password" id="loginPassword" required style="width: 100%; box-sizing: border-box;">
                    </div>
                    <div id="loginError" style="color: #ff4444; margin-bottom: 15px; display: none;"></div>
                    <button type="submit" class="btn btn-primary" style="width: 100%;">Sign In</button>
                </form>
                <p style="text-align: center; margin-top: 20px; color: #888;">
                    <a href="/" style="color: #00a8ff;">← Back to Home</a>
                </p>
            </div>
        </div>

        <!-- Admin Content (shown when authenticated) -->
        <div id="adminContent" style="display: none;">
        <div class="admin-header">
            <h1>Form Submissions</h1>
            <div class="header-actions">
                <a href="/" class="btn btn-secondary" style="text-decoration: none;">← Home</a>
                <button class="btn btn-primary" onclick="loadSubmissions()">Refresh</button>
                <button class="btn btn-secondary" onclick="handleLogout()">Logout</button>
            </div>
        </div>

        <div class="filters">
            <div class="filter-row">
                <div class="filter-group">
                    <label>Search</label>
                    <input type="text" id="searchFilter" placeholder="Name, email, organization..." oninput="applyFilters()">
                </div>
                <div class="filter-group">
                    <label>Interest</label>
                    <select id="interestFilter" onchange="applyFilters()">
                        <option value="">All</option>
                    </select>
                </div>
                <div class="filter-group">
                    <label>Organization Type</label>
                    <select id="orgTypeFilter" onchange="applyFilters()">
                        <option value="">All</option>
                    </select>
                </div>
                <div class="filter-group">
                    <label>Date From</label>
                    <input type="date" id="dateFromFilter" onchange="applyFilters()">
                </div>
                <div class="filter-group">
                    <label>Date To</label>
                    <input type="date" id="dateToFilter" onchange="applyFilters()">
                </div>
            </div>
            <div class="filter-actions">
                <button class="btn btn-secondary" onclick="clearFilters()">Clear Filters</button>
            </div>
        </div>

        <div class="bulk-actions" id="bulkActions">
            <div class="bulk-actions-left">
                <input type="checkbox" id="selectAll" onchange="toggleSelectAll()">
                <span id="selectedCount">0 selected</span>
            </div>
            <button class="btn btn-danger" id="deleteSelected" onclick="confirmDelete()" disabled>Delete Selected</button>
        </div>

        <div class="stats" id="statsContainer"></div>

        <div id="loading" class="loading">Loading submissions...</div>
        <div id="submissionsContainer" class="submissions-list" style="display: none;"></div>
        <div id="emptyState" class="empty-state" style="display: none;">
            <h2>No submissions found</h2>
            <p>Try adjusting your filters or check back later.</p>
        </div>
    </div>

    <div class="modal" id="deleteModal">
        <div class="modal-content">
            <h2>Confirm Delete</h2>
            <p id="deleteMessage">Are you sure you want to delete the selected submissions? This action cannot be undone.</p>
            <div class="modal-actions">
                <button class="btn btn-secondary" onclick="closeDeleteModal()">Cancel</button>
                <button class="btn btn-danger" onclick="handleDeleteSubmissions()">Delete</button>
            </div>
        </div>
    </div>
        </div>

    <script is:inline src="https://cdn.jsdelivr.net/npm/@supabase/supabase-js@2"></script>
    <script is:inline src="/js/supabase-client.js"></script>
    <script is:inline>
        let allSubmissions = [];
        let filteredSubmissions = [];
        let selectedIds = new Set();

        // Auth state management
        async function checkAuth() {
            const session = await getSession();
            if (session) {
                document.getElementById('loginContainer').style.display = 'none';
                document.getElementById('adminContent').style.display = 'block';
                loadSubmissions();
            } else {
                document.getElementById('loginContainer').style.display = 'block';
                document.getElementById('adminContent').style.display = 'none';
            }
        }

        // Login form handler
        document.getElementById('loginForm').addEventListener('submit', async function(e) {
            e.preventDefault();
            const email = document.getElementById('loginEmail').value;
            const password = document.getElementById('loginPassword').value;
            const errorDiv = document.getElementById('loginError');

            try {
                await signIn(email, password);
                errorDiv.style.display = 'none';
                checkAuth();
            } catch (error) {
                errorDiv.textContent = error.message || 'Invalid email or password';
                errorDiv.style.display = 'block';
            }
        });

        // Logout handler
        async function handleLogout() {
            await signOut();
            checkAuth();
        }

        async function loadSubmissions() {
            document.getElementById('loading').style.display = 'block';
            document.getElementById('submissionsContainer').style.display = 'none';
            document.getElementById('emptyState').style.display = 'none';

            try {
                const submissions = await getSubmissions();
                document.getElementById('loading').style.display = 'none';

                // Transform to match old format for compatibility
                allSubmissions = submissions.map(sub => ({
                    id: sub.id,
                    timestamp: sub.created_at,
                    submission: {
                        name: sub.name,
                        email: sub.email,
                        organization: sub.organization,
                        role: sub.role,
                        orgType: sub.org_type,
                        interest: sub.interest,
                        timeframe: sub.timeframe,
                        message: sub.message
                    }
                }));

                selectedIds.clear();
                populateFilters(allSubmissions);
                applyFilters();
            } catch (error) {
                document.getElementById('loading').style.display = 'none';
                document.getElementById('emptyState').style.display = 'block';
                console.error('Error loading submissions:', error);
            }
        }

        function populateFilters(submissions) {
            const interests = new Set();
            const orgTypes = new Set();

            submissions.forEach(sub => {
                if (sub.submission.interest) interests.add(sub.submission.interest);
                if (sub.submission.orgType) orgTypes.add(sub.submission.orgType);
            });

            const interestFilter = document.getElementById('interestFilter');
            interestFilter.textContent = '';
            const allOption = document.createElement('option');
            allOption.value = '';
            allOption.textContent = 'All';
            interestFilter.appendChild(allOption);
            Array.from(interests).sort().forEach(interest => {
                const option = document.createElement('option');
                option.value = interest;
                option.textContent = interest.charAt(0).toUpperCase() + interest.slice(1);
                interestFilter.appendChild(option);
            });

            const orgTypeFilter = document.getElementById('orgTypeFilter');
            orgTypeFilter.textContent = '';
            const allOrgOption = document.createElement('option');
            allOrgOption.value = '';
            allOrgOption.textContent = 'All';
            orgTypeFilter.appendChild(allOrgOption);
            Array.from(orgTypes).sort().forEach(orgType => {
                const option = document.createElement('option');
                option.value = orgType;
                option.textContent = orgType.charAt(0).toUpperCase() + orgType.slice(1);
                orgTypeFilter.appendChild(option);
            });
        }

        function applyFilters() {
            const searchTerm = document.getElementById('searchFilter').value.toLowerCase();
            const interestFilter = document.getElementById('interestFilter').value;
            const orgTypeFilter = document.getElementById('orgTypeFilter').value;
            const dateFrom = document.getElementById('dateFromFilter').value;
            const dateTo = document.getElementById('dateToFilter').value;

            filteredSubmissions = allSubmissions.filter(sub => {
                // Search filter
                if (searchTerm) {
                    const searchableText = [
                        sub.submission.name,
                        sub.submission.email,
                        sub.submission.organization,
                        sub.submission.role,
                        sub.submission.message
                    ].join(' ').toLowerCase();

                    if (!searchableText.includes(searchTerm)) return false;
                }

                // Interest filter
                if (interestFilter && sub.submission.interest !== interestFilter) return false;

                // Org type filter
                if (orgTypeFilter && sub.submission.orgType !== orgTypeFilter) return false;

                // Date filters
                const subDate = new Date(sub.timestamp).toISOString().split('T')[0];
                if (dateFrom && subDate < dateFrom) return false;
                if (dateTo && subDate > dateTo) return false;

                return true;
            });

            displayStats(filteredSubmissions);
            displaySubmissions(filteredSubmissions);
            updateBulkActions();
        }

        function clearFilters() {
            document.getElementById('searchFilter').value = '';
            document.getElementById('interestFilter').value = '';
            document.getElementById('orgTypeFilter').value = '';
            document.getElementById('dateFromFilter').value = '';
            document.getElementById('dateToFilter').value = '';
            applyFilters();
        }

        function createStatCard(title, value) {
            const card = document.createElement('div');
            card.className = 'stat-card';

            const h3 = document.createElement('h3');
            h3.textContent = title;

            const valueDiv = document.createElement('div');
            valueDiv.className = 'value';
            valueDiv.textContent = value;

            card.appendChild(h3);
            card.appendChild(valueDiv);
            return card;
        }

        function displayStats(submissions) {
            const total = submissions.length;
            const byInterest = {};
            const byOrgType = {};

            submissions.forEach(sub => {
                const interest = sub.submission.interest || 'Not specified';
                const orgType = sub.submission.orgType || 'Not specified';

                byInterest[interest] = (byInterest[interest] || 0) + 1;
                byOrgType[orgType] = (byOrgType[orgType] || 0) + 1;
            });

            const topInterest = Object.entries(byInterest).sort((a, b) => b[1] - a[1])[0];
            const uniqueOrgs = new Set(submissions.map(s => s.submission.organization)).size;

            const statsContainer = document.getElementById('statsContainer');
            statsContainer.textContent = '';

            statsContainer.appendChild(createStatCard('Total Submissions', String(total)));
            statsContainer.appendChild(createStatCard('Filtered Results', String(submissions.length)));
            statsContainer.appendChild(createStatCard('Top Interest', topInterest ? topInterest[0] : 'N/A'));
            statsContainer.appendChild(createStatCard('Unique Organizations', String(uniqueOrgs)));
        }

        function createSubmissionField(labelText, valueText, isEmail, isMessage) {
            const field = document.createElement('div');
            field.className = 'submission-field';

            const label = document.createElement('label');
            label.textContent = labelText;
            field.appendChild(label);

            const valueDiv = document.createElement('div');
            valueDiv.className = 'value';

            if (isMessage) {
                valueDiv.className = 'submission-message value';
            }

            if (isEmail && valueText) {
                const link = document.createElement('a');
                link.href = 'mailto:' + valueText;
                link.style.color = '#00a8ff';
                link.textContent = valueText;
                valueDiv.appendChild(link);
            } else {
                // Handle line breaks for messages
                if (isMessage && valueText) {
                    const lines = valueText.split('\n');
                    lines.forEach((line, index) => {
                        valueDiv.appendChild(document.createTextNode(line));
                        if (index < lines.length - 1) {
                            valueDiv.appendChild(document.createElement('br'));
                        }
                    });
                } else {
                    valueDiv.textContent = valueText || 'Not provided';
                }
            }

            field.appendChild(valueDiv);
            return field;
        }

        function displaySubmissions(submissions) {
            const container = document.getElementById('submissionsContainer');
            container.textContent = '';

            if (submissions.length === 0) {
                document.getElementById('emptyState').style.display = 'block';
                return;
            }

            document.getElementById('emptyState').style.display = 'none';

            // Sort by timestamp (newest first)
            submissions.sort((a, b) => new Date(b.timestamp) - new Date(a.timestamp));

            submissions.forEach(sub => {
                const card = document.createElement('div');
                card.className = 'submission-card' + (selectedIds.has(sub.id) ? ' selected' : '');
                card.dataset.id = sub.id;

                const inner = document.createElement('div');
                inner.className = 'submission-card-inner';

                // Checkbox container
                const checkboxDiv = document.createElement('div');
                checkboxDiv.className = 'submission-checkbox';
                const checkbox = document.createElement('input');
                checkbox.type = 'checkbox';
                checkbox.checked = selectedIds.has(sub.id);
                checkbox.onchange = function() { toggleSelection(sub.id); };
                checkboxDiv.appendChild(checkbox);
                inner.appendChild(checkboxDiv);

                // Content container
                const content = document.createElement('div');
                content.className = 'submission-content';

                // Header with name, badge, and timestamp
                const header = document.createElement('div');
                header.className = 'submission-header';

                const headerLeft = document.createElement('div');
                headerLeft.className = 'submission-header-left';

                const nameSpan = document.createElement('span');
                nameSpan.className = 'submission-name';
                nameSpan.textContent = sub.submission.name || 'Anonymous';
                headerLeft.appendChild(nameSpan);

                // Badge for form type
                const isBundleRequest = sub.submission.interest === 'Custom Bundle Request';
                const badge = document.createElement('span');
                badge.className = 'submission-badge ' + (isBundleRequest ? 'bundle' : 'contact');
                badge.textContent = isBundleRequest ? 'Bundle Request' : 'Contact';
                headerLeft.appendChild(badge);

                header.appendChild(headerLeft);

                const timestampDiv = document.createElement('div');
                timestampDiv.className = 'submission-timestamp';
                const date = new Date(sub.timestamp);
                timestampDiv.textContent = date.toLocaleDateString('en-US', { month: 'short', day: 'numeric', year: 'numeric' }) + ' at ' + date.toLocaleTimeString('en-US', { hour: 'numeric', minute: '2-digit' });
                header.appendChild(timestampDiv);

                content.appendChild(header);

                // Fields in a grid layout
                const fieldsGrid = document.createElement('div');
                fieldsGrid.className = 'submission-fields-grid';

                fieldsGrid.appendChild(createSubmissionField('Email', sub.submission.email, true, false));

                if (sub.submission.organization) {
                    fieldsGrid.appendChild(createSubmissionField('Organization', sub.submission.organization, false, false));
                }
                if (sub.submission.role) {
                    fieldsGrid.appendChild(createSubmissionField('Role', sub.submission.role, false, false));
                }
                if (sub.submission.orgType) {
                    fieldsGrid.appendChild(createSubmissionField(isBundleRequest ? 'Environment' : 'Org Type', sub.submission.orgType, false, false));
                }
                if (sub.submission.interest && !isBundleRequest) {
                    fieldsGrid.appendChild(createSubmissionField('Interest', sub.submission.interest, false, false));
                }
                if (sub.submission.timeframe) {
                    fieldsGrid.appendChild(createSubmissionField('Timeframe', sub.submission.timeframe, false, false));
                }

                content.appendChild(fieldsGrid);

                // Message in its own full-width section
                if (sub.submission.message) {
                    content.appendChild(createSubmissionField(isBundleRequest ? 'Details' : 'Message', sub.submission.message, false, true));
                }

                inner.appendChild(content);
                card.appendChild(inner);
                container.appendChild(card);
            });

            container.style.display = 'flex';
        }

        function toggleSelection(id) {
            if (selectedIds.has(id)) {
                selectedIds.delete(id);
            } else {
                selectedIds.add(id);
            }
            updateBulkActions();

            // Update card styling
            const card = document.querySelector('.submission-card[data-id="' + id + '"]');
            if (card) {
                const checkbox = card.querySelector('input[type="checkbox"]');
                if (checkbox) checkbox.checked = selectedIds.has(id);
                if (selectedIds.has(id)) {
                    card.classList.add('selected');
                } else {
                    card.classList.remove('selected');
                }
            }
        }

        function toggleSelectAll() {
            const selectAll = document.getElementById('selectAll').checked;

            if (selectAll) {
                filteredSubmissions.forEach(sub => selectedIds.add(sub.id));
            } else {
                selectedIds.clear();
            }

            // Update checkboxes
            document.querySelectorAll('.submission-card input[type="checkbox"]').forEach(cb => {
                cb.checked = selectAll;
            });

            // Update card styling
            document.querySelectorAll('.submission-card').forEach(card => {
                if (selectAll) {
                    card.classList.add('selected');
                } else {
                    card.classList.remove('selected');
                }
            });

            updateBulkActions();
        }

        function updateBulkActions() {
            const count = selectedIds.size;
            const bulkActions = document.getElementById('bulkActions');
            const deleteBtn = document.getElementById('deleteSelected');
            const selectedCount = document.getElementById('selectedCount');
            const selectAll = document.getElementById('selectAll');

            if (count > 0) {
                bulkActions.classList.add('active');
                deleteBtn.disabled = false;
                selectedCount.textContent = count + ' selected';
                selectAll.checked = count === filteredSubmissions.length && filteredSubmissions.length > 0;
            } else {
                bulkActions.classList.remove('active');
                deleteBtn.disabled = true;
                selectedCount.textContent = '0 selected';
                selectAll.checked = false;
            }
        }

        function confirmDelete() {
            const count = selectedIds.size;
            document.getElementById('deleteMessage').textContent =
                'Are you sure you want to delete ' + count + ' submission' + (count === 1 ? '' : 's') + '? This action cannot be undone.';
            document.getElementById('deleteModal').classList.add('active');
        }

        function closeDeleteModal() {
            document.getElementById('deleteModal').classList.remove('active');
        }

        async function handleDeleteSubmissions() {
            const idsToDelete = Array.from(selectedIds);

            closeDeleteModal();
            document.getElementById('loading').style.display = 'block';
            document.getElementById('submissionsContainer').style.display = 'none';

            try {
                await deleteSubmissions(idsToDelete);
                selectedIds.clear();
                loadSubmissions();
            } catch (error) {
                alert('Error deleting submissions: ' + error.message);
                document.getElementById('loading').style.display = 'none';
                displaySubmissions(filteredSubmissions);
            }
        }

        // Check auth on page load
        checkAuth();

        // Auto-refresh every 30 seconds (only if authenticated and not selecting)
        setInterval(async () => {
            const session = await getSession();
            if (session && selectedIds.size === 0) {
                loadSubmissions();
            }
        }, 30000);
    </script>
</body>
</html>
