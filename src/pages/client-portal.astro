---
import ContentPageLayout from '../layouts/ContentPageLayout.astro';
import { siteConfig } from '../data/navigation';

const zohoPortalUrl = siteConfig.zohoPortalUrl;
const stripePortalLoginUrl = siteConfig.stripePortalLoginUrl;
const stripeSubscriptionsLive = !stripePortalLoginUrl.includes('REPLACE_ME');
---

<ContentPageLayout
  title="Client Portal | Fighting Smart Cyber"
  description="Sign in to your Fighting Smart Cyber client portal to view invoices, accept estimates, manage recurring payments, and pay securely."
  heroTitle='Client <span class="highlight">Portal</span>'
  heroSubtitle="View invoices, accept estimates, manage recurring payments, and pay securely."
>
  <!-- IBM Plex Mono for tactical labels / endpoint metadata. Inter is
       already loaded site-wide for body and display copy. -->
  <link slot="head" rel="preconnect" href="https://fonts.googleapis.com" />
  <link slot="head" rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link slot="head" href="https://fonts.googleapis.com/css2?family=IBM+Plex+Mono:wght@400;500;600&display=swap" rel="stylesheet" />

  <section class="content-section console-section">
    <div class="container">

      <!-- Two primary portal endpoints, side by side -->
      <div class="console-grid">

        <article class="console-card console-card--primary">
          <div class="console-card-glow console-card-glow--cyan" aria-hidden="true"></div>
          <div class="console-card-meta">
            <span class="console-route">ROUTE&nbsp;/&nbsp;01</span>
            <span class="console-status"><span class="console-status-dot"></span>LIVE</span>
          </div>

          <h2 class="console-card-title">Billing Portal</h2>
          <p class="console-card-lead">For invoices, estimates, statements, and one-off payments.</p>

          <ul class="console-pillset">
            <li>Invoices</li>
            <li>Estimates</li>
            <li>Statements</li>
            <li>ACH / Card</li>
          </ul>

          <dl class="console-endpoint">
            <dt>HOSTED&nbsp;BY</dt>
            <dd>Zoho Books</dd>
            <dt>ENDPOINT</dt>
            <dd><code>books.fightingsmartcyber.com</code></dd>
          </dl>

          <a href={zohoPortalUrl} class="console-cta" target="_blank" rel="noopener">
            <span class="console-cta-label">Sign In</span>
            <svg class="console-cta-icon" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><line x1="5" y1="12" x2="19" y2="12"/><polyline points="12 5 19 12 12 19"/></svg>
          </a>

          <p class="console-fineprint">Sign in with the email on your account. First-time users: check your invoice email for a portal invite.</p>
        </article>

        {stripeSubscriptionsLive && (
          <article class="console-card console-card--secondary">
            <div class="console-card-glow console-card-glow--blue" aria-hidden="true"></div>
            <div class="console-card-meta">
              <span class="console-route">ROUTE&nbsp;/&nbsp;02</span>
              <span class="console-status"><span class="console-status-dot"></span>LIVE</span>
            </div>

            <h2 class="console-card-title">Recurring Payments</h2>
            <p class="console-card-lead">For any monthly, quarterly, annual, or other recurring payment plan.</p>

            <ul class="console-pillset">
              <li>Monthly</li>
              <li>Quarterly</li>
              <li>Annual</li>
              <li>Card-on-file</li>
            </ul>

            <dl class="console-endpoint">
              <dt>HOSTED&nbsp;BY</dt>
              <dd>Stripe</dd>
              <dt>ENDPOINT</dt>
              <dd><code>portal.fightingsmartcyber.com</code></dd>
            </dl>

            <a href={stripePortalLoginUrl} class="console-cta" target="_blank" rel="noopener">
              <span class="console-cta-label">Open Portal</span>
              <svg class="console-cta-icon" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><line x1="5" y1="12" x2="19" y2="12"/><polyline points="12 5 19 12 12 19"/></svg>
            </a>

            <p class="console-fineprint">A one-time sign-in link is sent to your inbox. No password required.</p>
          </article>
        )}
      </div>

      <!-- Utility row: resend request -->
      <aside class="console-utility">
        <div class="console-utility-meta">
          <span class="console-route">UTILITY&nbsp;/&nbsp;RESEND</span>
        </div>
        <div class="console-utility-body">
          <div class="console-utility-text">
            <h3>Misplaced an invoice?</h3>
            <p>Drop your email and we'll resend the most recent invoice and Stripe payment link.</p>
          </div>
          <div class="console-utility-action">
            <button type="button" class="console-cta console-cta--ghost" id="resendToggle">
              <span class="console-cta-label">Request Resend</span>
              <svg class="console-cta-icon" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><line x1="5" y1="12" x2="19" y2="12"/><polyline points="12 5 19 12 12 19"/></svg>
            </button>
            <form id="resendForm" class="console-resend-form" hidden>
              <label for="resendEmail" class="visually-hidden">Your email address</label>
              <input type="email" id="resendEmail" name="email" placeholder="your@email.com" autocomplete="email" required />
              <button type="submit" class="console-cta" id="resendSubmit">
                <span class="console-cta-label">Send</span>
                <svg class="console-cta-icon" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><line x1="5" y1="12" x2="19" y2="12"/><polyline points="12 5 19 12 12 19"/></svg>
              </button>
            </form>
            <p class="console-resend-status" id="resendStatus" role="status" aria-live="polite"></p>
          </div>
        </div>
      </aside>

    </div>
  </section>

  <!-- ==================================================================
       Capabilities manifest — single panel with a numbered list of
       what the portal does. Less card-grid, more "spec sheet."
       ================================================================== -->
  <section class="content-section-alt manifest-section">
    <div class="container">
      <div class="manifest">
        <div class="manifest-header">
          <p class="manifest-eyebrow">CAPABILITIES / 06</p>
          <h2 class="manifest-title">Everything your portal does, in one place.</h2>
          <p class="manifest-lead">Self-service for the whole billing relationship. Each item below works the same way it would in any modern finance tool — just hosted on our domain, on our infrastructure.</p>
        </div>

        <ol class="manifest-list">
          <li class="manifest-item">
            <span class="manifest-num">01</span>
            <span class="manifest-icon" aria-hidden="true">
              <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round"><path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"/><polyline points="14 2 14 8 20 8"/><line x1="8" y1="13" x2="16" y2="13"/><line x1="8" y1="17" x2="13" y2="17"/></svg>
            </span>
            <div class="manifest-body">
              <h3>View every invoice</h3>
              <p>Open, paid, overdue — current balance and due dates at a glance.</p>
            </div>
          </li>
          <li class="manifest-item">
            <span class="manifest-num">02</span>
            <span class="manifest-icon" aria-hidden="true">
              <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round"><polyline points="20 6 9 17 4 12"/></svg>
            </span>
            <div class="manifest-body">
              <h3>Accept estimates online</h3>
              <p>Review proposed engagements and approve quotes. Acceptance converts directly to an invoice.</p>
            </div>
          </li>
          <li class="manifest-item">
            <span class="manifest-num">03</span>
            <span class="manifest-icon" aria-hidden="true">
              <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round"><rect x="2" y="6" width="20" height="13" rx="2"/><line x1="2" y1="11" x2="22" y2="11"/><line x1="6" y1="15" x2="9" y2="15"/></svg>
            </span>
            <div class="manifest-body">
              <h3>Pay by ACH or card</h3>
              <p>Stripe-powered checkout. Receipts auto-emailed and archived in the portal.</p>
            </div>
          </li>
          <li class="manifest-item">
            <span class="manifest-num">04</span>
            <span class="manifest-icon" aria-hidden="true">
              <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round"><path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"/><polyline points="7 10 12 15 17 10"/><line x1="12" y1="15" x2="12" y2="3"/></svg>
            </span>
            <div class="manifest-body">
              <h3>Download statements</h3>
              <p>Generate full account statements on demand for records, reconciliation, or audit.</p>
            </div>
          </li>
          <li class="manifest-item">
            <span class="manifest-num">05</span>
            <span class="manifest-icon" aria-hidden="true">
              <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round"><path d="M12 15a3 3 0 1 0 0-6 3 3 0 0 0 0 6z"/><path d="M19.4 15a1.65 1.65 0 0 0 .33 1.82l.06.06a2 2 0 1 1-2.83 2.83l-.06-.06a1.65 1.65 0 0 0-1.82-.33 1.65 1.65 0 0 0-1 1.51V21a2 2 0 1 1-4 0v-.09a1.65 1.65 0 0 0-1-1.51 1.65 1.65 0 0 0-1.82.33l-.06.06a2 2 0 1 1-2.83-2.83l.06-.06a1.65 1.65 0 0 0 .33-1.82 1.65 1.65 0 0 0-1.51-1H3a2 2 0 1 1 0-4h.09a1.65 1.65 0 0 0 1.51-1 1.65 1.65 0 0 0-.33-1.82l-.06-.06a2 2 0 1 1 2.83-2.83l.06.06a1.65 1.65 0 0 0 1.82.33H9a1.65 1.65 0 0 0 1-1.51V3a2 2 0 1 1 4 0v.09a1.65 1.65 0 0 0 1 1.51 1.65 1.65 0 0 0 1.82-.33l.06-.06a2 2 0 1 1 2.83 2.83l-.06.06a1.65 1.65 0 0 0-.33 1.82V9a1.65 1.65 0 0 0 1.51 1H21a2 2 0 1 1 0 4h-.09a1.65 1.65 0 0 0-1.51 1z"/></svg>
            </span>
            <div class="manifest-body">
              <h3>Keep your details current</h3>
              <p>Billing contact, business address, tax ID — changes apply to every future invoice.</p>
            </div>
          </li>
          <li class="manifest-item">
            <span class="manifest-num">06</span>
            <span class="manifest-icon" aria-hidden="true">
              <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="10"/><polyline points="12 6 12 12 16 14"/></svg>
            </span>
            <div class="manifest-body">
              <h3>24/7 self-service</h3>
              <p>From any device. No call queues, no email back-and-forth for routine billing tasks.</p>
            </div>
          </li>
        </ol>
      </div>
    </div>
  </section>

  <section class="content-section">
    <div class="container">
      <div class="portal-trust">
        <div class="portal-trust-icon">
          <svg width="32" height="32" viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg">
            <path d="M12 2L4 6v6c0 5 3.5 9.5 8 10 4.5-.5 8-5 8-10V6l-8-4z" stroke="currentColor" stroke-width="2" stroke-linejoin="round"/>
            <path d="M9 12l2 2 4-4" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/>
          </svg>
        </div>
        <div class="portal-trust-content">
          <h3>Hosted by Zoho. Payments by Stripe.</h3>
          <p>Your billing portal is hosted by <strong>Zoho Books</strong>, our system of record for invoices and statements. Payments are processed by <strong>Stripe</strong>, which is <strong>PCI-DSS Level 1</strong> certified — the highest level of payment-card security. FSC never sees or stores your card details.</p>
        </div>
      </div>
    </div>
  </section>
</ContentPageLayout>

<script is:inline>
  (function () {
    var toggle = document.getElementById('resendToggle');
    var form = document.getElementById('resendForm');
    var input = document.getElementById('resendEmail');
    var submitBtn = document.getElementById('resendSubmit');
    var submitLabel = submitBtn && submitBtn.querySelector('.console-cta-label');
    var status = document.getElementById('resendStatus');
    if (!toggle || !form || !input || !submitBtn || !submitLabel || !status) return;

    toggle.addEventListener('click', function () {
      toggle.hidden = true;
      form.hidden = false;
      input.focus();
    });

    form.addEventListener('submit', async function (e) {
      e.preventDefault();
      var email = (input.value || '').trim();
      if (!email) return;

      var originalLabel = submitLabel.textContent;
      submitBtn.disabled = true;
      submitLabel.textContent = 'Sending...';
      status.className = 'console-resend-status';
      status.textContent = '';

      try {
        var res = await fetch('/api/submit', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({ formType: 'invoice-resend', email: email })
        });
        if (!res.ok) {
          var detail = 'Sorry, something went wrong.';
          try {
            var body = await res.json();
            if (body && body.error) detail = body.error;
          } catch (_) {}
          throw new Error(detail);
        }
        form.hidden = true;
        status.className = 'console-resend-status success';
        status.textContent = '✓ Request received. Resending invoice to ' + email + '.';
      } catch (err) {
        status.className = 'console-resend-status error';
        status.textContent =
          (err && err.message) ||
          'Sorry, something went wrong. Please email team@fightingsmartcyber.com directly.';
        submitBtn.disabled = false;
        submitLabel.textContent = originalLabel;
      }
    });
  })();
</script>

<style>
  /* ==================================================================
     CLIENT PORTAL — "Operations Console" aesthetic
     ------------------------------------------------------------------
     Two primary portal endpoints in a console-card grid up top, plus a
     subordinate utility row beneath them for the resend request. Mono
     accents (IBM Plex Mono) for tactical labels, route IDs, and
     endpoint URLs. Each card has a unique corner glow + a subtle dot
     pattern for depth.
     ================================================================== */

  .console-section {
    --bg-card: #0a2540;
    --bg-card-2: #0d2e52;
    --ink: #ffffff;
    --ink-soft: rgba(255, 255, 255, 0.7);
    --ink-dim: rgba(255, 255, 255, 0.45);
    --rule: rgba(0, 168, 255, 0.18);
    --mono: 'IBM Plex Mono', ui-monospace, 'SF Mono', Menlo, Consolas, monospace;
  }

  .console-grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 24px;
  }

  @media (max-width: 820px) {
    .console-grid {
      grid-template-columns: 1fr;
    }
  }

  .console-card {
    position: relative;
    display: flex;
    flex-direction: column;
    background:
      radial-gradient(at 0% 0%, rgba(0, 212, 255, 0.06) 0%, transparent 45%),
      linear-gradient(160deg, var(--bg-card) 0%, var(--bg-card-2) 70%, #11375f 100%);
    color: var(--ink);
    border: 1px solid var(--rule);
    border-radius: 6px;
    padding: 32px 32px 28px 32px;
    overflow: hidden;
    isolation: isolate;
    transition: border-color 0.25s ease, transform 0.25s ease;
  }

  .console-card:hover {
    border-color: rgba(0, 212, 255, 0.45);
    transform: translateY(-2px);
  }

  /* Subtle dot-grid background — tactical "console" texture without
     screaming "tech background". 18px grid, very low opacity. */
  .console-card::before {
    content: '';
    position: absolute;
    inset: 0;
    background-image: radial-gradient(circle at 1px 1px, rgba(0, 212, 255, 0.08) 1px, transparent 0);
    background-size: 18px 18px;
    pointer-events: none;
    z-index: -1;
    -webkit-mask-image: linear-gradient(180deg, rgba(0, 0, 0, 0.9), rgba(0, 0, 0, 0.3) 70%, transparent);
            mask-image: linear-gradient(180deg, rgba(0, 0, 0, 0.9), rgba(0, 0, 0, 0.3) 70%, transparent);
  }

  /* Per-card corner glow — distinct positions so the two cards have
     different visual centers of gravity. */
  .console-card-glow {
    position: absolute;
    pointer-events: none;
    border-radius: 50%;
    filter: blur(60px);
    opacity: 0.55;
    z-index: -1;
  }

  .console-card-glow--cyan {
    top: -80px;
    right: -80px;
    width: 260px;
    height: 260px;
    background: radial-gradient(circle, var(--cyan) 0%, transparent 70%);
  }

  .console-card-glow--blue {
    bottom: -100px;
    left: -80px;
    width: 280px;
    height: 280px;
    background: radial-gradient(circle, var(--bright-blue) 0%, transparent 70%);
  }

  /* --- Card header strip (route + status) --------------------------- */

  .console-card-meta {
    display: flex;
    justify-content: space-between;
    align-items: center;
    padding-bottom: 18px;
    margin-bottom: 24px;
    border-bottom: 1px dashed var(--rule);
    font-family: var(--mono);
    font-size: 11px;
    font-weight: 500;
    letter-spacing: 0.5px;
  }

  .console-route {
    color: var(--cyan);
  }

  .console-status {
    display: inline-flex;
    align-items: center;
    gap: 7px;
    color: rgba(0, 255, 174, 0.85);
    text-transform: uppercase;
  }

  .console-status-dot {
    width: 7px;
    height: 7px;
    border-radius: 50%;
    background: #00ffae;
    box-shadow: 0 0 8px #00ffae;
    animation: console-pulse 2.4s ease-in-out infinite;
  }

  @keyframes console-pulse {
    0%, 100% { opacity: 0.7; transform: scale(1); }
    50% { opacity: 1; transform: scale(1.15); }
  }

  /* --- Typography --------------------------------------------------- */

  .console-card-title {
    margin: 0 0 10px 0;
    font-size: 32px;
    line-height: 1.05;
    font-weight: 800;
    letter-spacing: -0.7px;
    color: var(--ink);
  }

  .console-card-lead {
    margin: 0 0 22px 0;
    font-size: 15px;
    line-height: 1.55;
    color: var(--ink-soft);
    max-width: 38ch;
  }

  /* --- Pill list of capabilities ------------------------------------ */

  .console-pillset {
    list-style: none;
    margin: 0 0 22px 0;
    padding: 0;
    display: flex;
    flex-wrap: wrap;
    gap: 6px 8px;
  }

  .console-pillset li {
    font-family: var(--mono);
    font-size: 11.5px;
    letter-spacing: 0.3px;
    padding: 5px 10px;
    color: var(--cyan);
    background: rgba(0, 212, 255, 0.08);
    border: 1px solid rgba(0, 212, 255, 0.25);
    border-radius: 3px;
  }

  /* --- Endpoint metadata block -------------------------------------- */

  .console-endpoint {
    margin: 0 0 26px 0;
    padding: 14px 16px;
    border: 1px solid var(--rule);
    border-radius: 4px;
    background: rgba(0, 0, 0, 0.18);
    display: grid;
    grid-template-columns: max-content 1fr;
    gap: 4px 16px;
    font-family: var(--mono);
    font-size: 12px;
    line-height: 1.5;
  }

  .console-endpoint dt {
    color: var(--ink-dim);
    font-weight: 500;
    letter-spacing: 0.5px;
  }

  .console-endpoint dd {
    margin: 0;
    color: var(--ink);
    font-weight: 500;
  }

  .console-endpoint code {
    color: var(--cyan);
    background: transparent;
    padding: 0;
    font: inherit;
  }

  /* --- CTAs --------------------------------------------------------- */

  .console-cta {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 10px;
    margin-top: auto;
    margin-bottom: 14px;
    padding: 13px 22px;
    background: var(--bright-blue);
    color: var(--dark);
    font-family: var(--mono);
    font-size: 13px;
    font-weight: 600;
    letter-spacing: 1px;
    text-transform: uppercase;
    text-decoration: none;
    border: 1px solid var(--bright-blue);
    border-radius: 4px;
    cursor: pointer;
    transition: background 0.2s ease, transform 0.15s ease, box-shadow 0.2s ease;
  }

  .console-cta:hover {
    background: var(--cyan);
    border-color: var(--cyan);
    transform: translateY(-1px);
    box-shadow: 0 6px 20px rgba(0, 168, 255, 0.35);
  }

  .console-cta-icon {
    transition: transform 0.2s ease;
  }

  .console-cta:hover .console-cta-icon {
    transform: translateX(3px);
  }

  .console-cta--ghost {
    background: transparent;
    color: var(--cyan);
    border-color: rgba(0, 212, 255, 0.45);
  }

  .console-cta--ghost:hover {
    background: rgba(0, 212, 255, 0.1);
    color: var(--cyan);
    border-color: var(--cyan);
    box-shadow: 0 6px 18px rgba(0, 212, 255, 0.2);
  }

  /* --- Fineprint inside card ---------------------------------------- */

  .console-fineprint {
    margin: 0;
    font-size: 11.5px;
    line-height: 1.55;
    color: var(--ink-dim);
    font-family: var(--mono);
    letter-spacing: 0.2px;
  }

  /* ==================================================================
     UTILITY ROW (Resend request) — subordinate visual treatment
     ================================================================== */

  .console-utility {
    margin-top: 24px;
    padding: 24px 28px;
    background:
      radial-gradient(at 100% 100%, rgba(0, 168, 255, 0.06) 0%, transparent 50%),
      linear-gradient(180deg, rgba(10, 37, 64, 0.45) 0%, rgba(10, 37, 64, 0.7) 100%);
    border: 1px dashed var(--rule);
    border-radius: 6px;
    color: var(--ink);
    position: relative;
    overflow: hidden;
  }

  .console-utility-meta {
    font-family: var(--mono);
    font-size: 11px;
    font-weight: 500;
    letter-spacing: 0.5px;
    color: var(--bright-blue);
    margin-bottom: 14px;
  }

  .console-utility-body {
    display: grid;
    grid-template-columns: 1fr auto;
    gap: 32px;
    align-items: center;
  }

  @media (max-width: 720px) {
    .console-utility-body {
      grid-template-columns: 1fr;
      gap: 18px;
    }
  }

  .console-utility-text h3 {
    margin: 0 0 6px 0;
    font-size: 22px;
    font-weight: 700;
    letter-spacing: -0.3px;
    color: var(--ink);
  }

  .console-utility-text p {
    margin: 0;
    font-size: 14.5px;
    line-height: 1.55;
    color: var(--ink-soft);
    max-width: 56ch;
  }

  .console-utility-action {
    min-width: 280px;
  }

  @media (max-width: 720px) {
    .console-utility-action {
      width: 100%;
      min-width: 0;
    }
  }

  .console-utility [hidden] {
    display: none !important;
  }

  .console-utility .console-cta {
    margin-top: 0;
    margin-bottom: 0;
    width: 100%;
  }

  .console-resend-form {
    display: flex;
    flex-direction: column;
