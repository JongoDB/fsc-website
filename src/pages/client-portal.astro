---
import ContentPageLayout from '../layouts/ContentPageLayout.astro';
import SectionHeader from '../components/SectionHeader.astro';
import FeatureItem from '../components/FeatureItem.astro';
import { siteConfig } from '../data/navigation';

const zohoPortalUrl = siteConfig.zohoPortalUrl;
const stripePortalLoginUrl = siteConfig.stripePortalLoginUrl;
const stripeSubscriptionsLive = !stripePortalLoginUrl.includes('REPLACE_ME');
---

<ContentPageLayout
  title="Client Portal | Fighting Smart Cyber"
  description="Sign in to your Fighting Smart Cyber client portal to view invoices, accept estimates, download statements, and pay securely."
  heroTitle='Client <span class="highlight">Portal</span>'
  heroSubtitle="View invoices, accept estimates, download statements, and pay securely."
>
  <section class="content-section">
    <div class="container">
      <div class="portal-grid">
        <div class="portal-card portal-card-primary">
          <div class="portal-badge">Existing Customer</div>
          <h2>Sign in to your billing portal</h2>
          <p>View open and historical invoices, accept estimates, download statements, and pay securely. Your portal is hosted by Zoho Books on our custom <code>books.fightingsmartcyber.com</code> domain.</p>
          <a href={zohoPortalUrl} class="btn-primary portal-cta" target="_blank" rel="noopener">
            Sign In to Portal &rarr;
          </a>
          <p class="portal-fineprint">Sign in with the email on your account. First-time users: check your invoice email for a portal invite, or contact us and we'll resend it.</p>
        </div>

        <div class="portal-card">
          <div class="portal-badge portal-badge-alt">Have an Invoice?</div>
          <h2>Pay directly from your invoice email</h2>
          <p>Every invoice we send includes a secure Stripe payment link — pay by ACH or card without signing in to anything.</p>
          <p>If you've misplaced an invoice, <a href="/contact">contact us</a> and we'll resend it.</p>
          <a href="/contact" class="btn-secondary portal-cta-secondary">Request a Resend</a>
        </div>
      </div>
    </div>
  </section>

  <section class="content-section-alt">
    <div class="container">
      <SectionHeader
        title="What you can do in the portal"
        description="Your full billing relationship with FSC, accessible from any device."
      />
      <div class="feature-grid">
        <FeatureItem
          title="View All Invoices"
          description="See every invoice — open, paid, or overdue — with current balance and due dates at a glance."
        />
        <FeatureItem
          title="Accept Estimates"
          description="Review proposed engagements and approve quotes online. Acceptance converts directly to an invoice."
        />
        <FeatureItem
          title="Pay Securely"
          description="Pay invoices by ACH or card via our Stripe-powered checkout. Receipts are emailed and stored in the portal."
        />
        <FeatureItem
          title="Download Statements"
          description="Generate full account statements on demand for your records, reconciliation, or audit."
        />
        <FeatureItem
          title="Update Your Details"
          description="Keep your billing contact, business address, and tax ID current. Changes apply to all future invoices."
        />
        <FeatureItem
          title="Self-Serve, 24/7"
          description="Manage your billing from any device, anytime. No call queues, no email back-and-forth for routine requests."
        />
      </div>
      <p class="portal-roadmap">
        <strong>Coming soon:</strong> recurring subscription management — pause, change plans, and update payment methods — for SaaS and recurring training offerings, hosted at <code>portal.fightingsmartcyber.com</code>.
      </p>
    </div>
  </section>

  {stripeSubscriptionsLive && (
    <section class="content-section">
      <div class="container">
        <div class="portal-subs-card">
          <div class="portal-badge portal-badge-alt">Subscription Customers</div>
          <h2>Manage your recurring plan</h2>
          <p>If you're on a recurring SaaS, training, or managed-service plan, manage your subscription, change plans, or update your payment method at our Stripe-hosted portal.</p>
          <a href={stripePortalLoginUrl} class="btn-primary portal-cta" target="_blank" rel="noopener">
            Manage Subscription &rarr;
          </a>
          <p class="portal-fineprint-dark">A one-time sign-in link is sent to your billing email. No password required.</p>
        </div>
      </div>
    </section>
  )}

  <section class="content-section">
    <div class="container">
      <div class="portal-trust">
        <div class="portal-trust-icon">
          <svg width="32" height="32" viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg">
            <path d="M12 2L4 6v6c0 5 3.5 9.5 8 10 4.5-.5 8-5 8-10V6l-8-4z" stroke="currentColor" stroke-width="2" stroke-linejoin="round"/>
            <path d="M9 12l2 2 4-4" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/>
          </svg>
        </div>
        <div class="portal-trust-content">
          <h3>Hosted by Zoho. Payments by Stripe.</h3>
          <p>Your billing portal is hosted by <strong>Zoho Books</strong>, our system of record for invoices and statements. Payments are processed by <strong>Stripe</strong>, which is <strong>PCI-DSS Level 1</strong> certified — the highest level of payment-card security. FSC never sees or stores your card details.</p>
        </div>
      </div>
    </div>
  </section>
</ContentPageLayout>

<style>
  .portal-grid {
    display: grid;
    grid-template-columns: 1.4fr 1fr;
    gap: 32px;
    align-items: start;
  }

  @media (max-width: 860px) {
    .portal-grid {
      grid-template-columns: 1fr;
    }
  }

  .portal-card {
    background: var(--white);
    border: 1px solid var(--border);
    border-radius: 16px;
    padding: 40px;
    box-shadow: 0 4px 20px rgba(10, 37, 64, 0.05);
    position: relative;
  }

  .portal-card-primary {
    background: linear-gradient(135deg, #0a2540 0%, #1e4d7b 100%);
    color: var(--white);
    border-color: rgba(0, 168, 255, 0.25);
    box-shadow: 0 8px 32px rgba(10, 37, 64, 0.2);
  }

  .portal-card h2 {
    margin: 0 0 14px 0;
    font-size: 26px;
    color: var(--dark);
  }

  .portal-card-primary h2 {
    color: var(--white);
  }

  .portal-card p {
    color: var(--text-light);
    line-height: 1.7;
    margin: 0 0 16px 0;
  }

  .portal-card-primary p {
    color: rgba(255, 255, 255, 0.85);
  }

  .portal-card code {
    background: rgba(0, 168, 255, 0.12);
    color: var(--bright-blue);
    padding: 2px 7px;
    border-radius: 4px;
    font-size: 0.9em;
    font-family: ui-monospace, 'SF Mono', Menlo, Consolas, monospace;
  }

  .portal-card-primary code {
    background: rgba(0, 212, 255, 0.18);
    color: var(--cyan);
  }

  .portal-badge {
    display: inline-block;
    background: rgba(0, 168, 255, 0.15);
    color: var(--bright-blue);
    font-size: 11px;
    font-weight: 700;
    letter-spacing: 1.2px;
    text-transform: uppercase;
    padding: 5px 12px;
    border-radius: 20px;
    margin-bottom: 14px;
  }

  .portal-card-primary .portal-badge {
    background: rgba(0, 212, 255, 0.2);
    color: var(--cyan);
  }

  .portal-badge-alt {
    background: rgba(0, 102, 204, 0.1);
    color: var(--accent-blue);
  }

  .portal-cta {
    display: inline-block;
    margin-top: 14px;
    margin-bottom: 18px;
  }

  .portal-card-primary .portal-cta {
    background: var(--bright-blue);
    color: var(--dark) !important;
  }

  .portal-card-primary .portal-cta:hover {
    background: var(--cyan);
  }

  .portal-cta-secondary {
    margin-top: 8px;
  }

  /* .btn-secondary is white-on-transparent by default (designed for dark hero
     backgrounds); restyle when used inside the light "Have an Invoice?" card. */
  .portal-card:not(.portal-card-primary) .portal-cta-secondary {
    color: var(--accent-blue);
    border-color: var(--accent-blue);
  }

  .portal-card:not(.portal-card-primary) .portal-cta-secondary:hover {
    background: var(--accent-blue);
    color: var(--white);
    border-color: var(--accent-blue);
  }

  .portal-fineprint {
    font-size: 13px;
    color: rgba(255, 255, 255, 0.55) !important;
    margin: 0 !important;
    line-height: 1.5;
  }

  .portal-fineprint-dark {
    font-size: 13px;
    color: rgba(255, 255, 255, 0.65) !important;
    margin: 0 !important;
    line-height: 1.5;
  }

  .portal-roadmap {
    max-width: 820px;
    margin: 40px auto 0;
    padding: 18px 24px;
    background: rgba(0, 168, 255, 0.06);
    border-left: 4px solid var(--bright-blue);
    border-radius: 6px;
    color: var(--text-light);
    font-size: 14px;
    line-height: 1.6;
    text-align: left;
  }

  .portal-roadmap strong {
    color: var(--primary-blue);
  }

  .portal-roadmap code {
    background: rgba(0, 168, 255, 0.12);
    color: var(--accent-blue);
    padding: 2px 7px;
    border-radius: 4px;
    font-size: 0.92em;
    font-family: ui-monospace, 'SF Mono', Menlo, Consolas, monospace;
  }

  .portal-subs-card {
    max-width: 820px;
    margin: 0 auto;
    background: linear-gradient(135deg, #0a2540 0%, #1e4d7b 100%);
    color: var(--white);
    border: 1px solid rgba(0, 168, 255, 0.25);
    border-radius: 16px;
    padding: 36px 40px;
    box-shadow: 0 8px 32px rgba(10, 37, 64, 0.2);
  }

  .portal-subs-card h2 {
    color: var(--white);
    margin: 0 0 12px 0;
    font-size: 24px;
  }

  .portal-subs-card p {
    color: rgba(255, 255, 255, 0.85);
    line-height: 1.7;
    margin: 0 0 16px 0;
  }

  .portal-subs-card .portal-cta {
    background: var(--bright-blue);
    color: var(--dark) !important;
  }

  .portal-subs-card .portal-cta:hover {
    background: var(--cyan);
  }

  .portal-trust {
    display: grid;
    grid-template-columns: 60px 1fr;
    gap: 24px;
    align-items: start;
    max-width: 880px;
    margin: 0 auto;
    padding: 32px;
    background: rgba(0, 168, 255, 0.04);
    border: 1px solid rgba(0, 168, 255, 0.18);
    border-radius: 16px;
  }

  @media (max-width: 640px) {
    .portal-trust {
      grid-template-columns: 1fr;
      text-align: center;
      padding: 24px;
    }
  }

  .portal-trust-icon {
    width: 60px;
    height: 60px;
    background: rgba(0, 168, 255, 0.12);
    border-radius: 14px;
    display: flex;
    align-items: center;
    justify-content: center;
    color: var(--bright-blue);
  }

  @media (max-width: 640px) {
    .portal-trust-icon {
      margin: 0 auto;
    }
  }

  .portal-trust-content h3 {
    margin: 0 0 8px 0;
    font-size: 20px;
    color: var(--dark);
  }

  .portal-trust-content p {
    margin: 0;
    color: var(--text-light);
    line-height: 1.7;
  }

  .portal-trust-content code {
    background: rgba(0, 168, 255, 0.12);
    color: var(--bright-blue);
    padding: 2px 7px;
    border-radius: 4px;
    font-size: 0.9em;
    font-family: ui-monospace, 'SF Mono', Menlo, Consolas, monospace;
  }
</style>
