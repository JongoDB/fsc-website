---
import ContentPageLayout from '../layouts/ContentPageLayout.astro';
import { siteConfig } from '../data/navigation';

const zohoPortalUrl = siteConfig.zohoPortalUrl;
const stripePortalLoginUrl = siteConfig.stripePortalLoginUrl;
const stripeSubscriptionsLive = !stripePortalLoginUrl.includes('REPLACE_ME');
---

<ContentPageLayout
  title="Client Portal | Fighting Smart Cyber"
  description="Sign in to your Fighting Smart Cyber client portal to view invoices, accept estimates, manage recurring payments, and pay securely."
  heroTitle='Client <span class="highlight">Portal</span>'
  heroSubtitle="View invoices, accept estimates, manage recurring payments, and pay securely."
>
  <section class="content-section portal-section">
    <div class="container">

      <!-- Two primary portal options -->
      <div class="portal-grid">

        <article class="portal-card">
          <div class="portal-card-icon" aria-hidden="true">
            <svg width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round">
              <path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"/>
              <polyline points="14 2 14 8 20 8"/>
              <line x1="8" y1="13" x2="16" y2="13"/>
              <line x1="8" y1="17" x2="13" y2="17"/>
            </svg>
          </div>
          <h2>Client Portal</h2>
          <p>Sign in to view invoices, accept estimates, download statements, and pay securely. Hosted by <strong>Zoho Books</strong>.</p>
          <a href={zohoPortalUrl} class="portal-card-cta" target="_blank" rel="noopener">
            Open Client Portal
            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><line x1="5" y1="12" x2="19" y2="12"/><polyline points="12 5 19 12 12 19"/></svg>
          </a>
        </article>

        {stripeSubscriptionsLive && (
          <article class="portal-card">
            <div class="portal-card-icon portal-card-icon--alt" aria-hidden="true">
              <svg width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round">
                <polyline points="23 4 23 10 17 10"/>
                <polyline points="1 20 1 14 7 14"/>
                <path d="M3.51 9a9 9 0 0 1 14.85-3.36L23 10M1 14l4.64 4.36A9 9 0 0 0 20.49 15"/>
              </svg>
            </div>
            <h2>Subscription Portal</h2>
            <p>For monthly, quarterly, annual, or any other recurring plan — manage your subscription, view history, or update your card on file. Hosted by <strong>Stripe</strong>.</p>
            <a href={stripePortalLoginUrl} class="portal-card-cta" target="_blank" rel="noopener">
              Open Subscription Portal
              <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><line x1="5" y1="12" x2="19" y2="12"/><polyline points="12 5 19 12 12 19"/></svg>
            </a>
          </article>
        )}
      </div>

      <!-- Resend invoice request — slim bar treatment below the cards -->
      <div class="portal-resend">
        <div class="portal-resend-icon" aria-hidden="true">
          <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round">
            <rect x="2" y="4" width="20" height="16" rx="2"/>
            <polyline points="22 6 12 13 2 6"/>
          </svg>
        </div>
        <div class="portal-resend-text">
          <h3>Misplaced an invoice?</h3>
          <p>Drop your email and we'll resend the most recent invoice and Stripe payment link.</p>
        </div>
        <div class="portal-resend-action">
          <button type="button" class="portal-resend-toggle" id="resendToggle">
            Request Resend
            <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><line x1="5" y1="12" x2="19" y2="12"/><polyline points="12 5 19 12 12 19"/></svg>
          </button>
          <form id="resendForm" class="portal-resend-form" hidden>
            <label for="resendEmail" class="visually-hidden">Your email address</label>
            <input type="email" id="resendEmail" name="email" placeholder="your@email.com" autocomplete="email" required />
            <button type="submit" class="portal-resend-submit" id="resendSubmit">
              <span class="portal-resend-submit-label">Send</span>
              <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><line x1="5" y1="12" x2="19" y2="12"/><polyline points="12 5 19 12 12 19"/></svg>
            </button>
          </form>
          <p class="portal-resend-status" id="resendStatus" role="status" aria-live="polite"></p>
        </div>
      </div>

    </div>
  </section>

  <!-- ==================================================================
       Capabilities — single panel, numbered list, not a card grid.
       ================================================================== -->
  <section class="content-section-alt manifest-section">
    <div class="container">
      <div class="manifest">
        <div class="manifest-header">
          <p class="manifest-eyebrow">Capabilities</p>
          <h2 class="manifest-title">Everything your portal does, in one place.</h2>
          <p class="manifest-lead">Self-service for the whole billing relationship — invoices, payments, statements, account details — all from any device, anytime.</p>
        </div>

        <ol class="manifest-list">
          <li class="manifest-item">
            <span class="manifest-num">01</span>
            <span class="manifest-icon" aria-hidden="true">
              <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round"><path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"/><polyline points="14 2 14 8 20 8"/><line x1="8" y1="13" x2="16" y2="13"/><line x1="8" y1="17" x2="13" y2="17"/></svg>
            </span>
            <div class="manifest-body">
              <h3>View every invoice</h3>
              <p>Open, paid, overdue — current balance and due dates at a glance.</p>
            </div>
          </li>
          <li class="manifest-item">
            <span class="manifest-num">02</span>
            <span class="manifest-icon" aria-hidden="true">
              <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round"><polyline points="20 6 9 17 4 12"/></svg>
            </span>
            <div class="manifest-body">
              <h3>Accept estimates online</h3>
              <p>Review proposed engagements and approve quotes. Acceptance converts directly to an invoice.</p>
            </div>
          </li>
          <li class="manifest-item">
            <span class="manifest-num">03</span>
            <span class="manifest-icon" aria-hidden="true">
              <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round"><rect x="2" y="6" width="20" height="13" rx="2"/><line x1="2" y1="11" x2="22" y2="11"/><line x1="6" y1="15" x2="9" y2="15"/></svg>
            </span>
            <div class="manifest-body">
              <h3>Pay by ACH or card</h3>
              <p>Stripe-powered checkout. Receipts auto-emailed and archived in the portal.</p>
            </div>
          </li>
          <li class="manifest-item">
            <span class="manifest-num">04</span>
            <span class="manifest-icon" aria-hidden="true">
              <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round"><path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"/><polyline points="7 10 12 15 17 10"/><line x1="12" y1="15" x2="12" y2="3"/></svg>
            </span>
            <div class="manifest-body">
              <h3>Download statements</h3>
              <p>Generate full account statements on demand for records, reconciliation, or audit.</p>
            </div>
          </li>
          <li class="manifest-item">
            <span class="manifest-num">05</span>
            <span class="manifest-icon" aria-hidden="true">
              <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round"><path d="M12 15a3 3 0 1 0 0-6 3 3 0 0 0 0 6z"/><path d="M19.4 15a1.65 1.65 0 0 0 .33 1.82l.06.06a2 2 0 1 1-2.83 2.83l-.06-.06a1.65 1.65 0 0 0-1.82-.33 1.65 1.65 0 0 0-1 1.51V21a2 2 0 1 1-4 0v-.09a1.65 1.65 0 0 0-1-1.51 1.65 1.65 0 0 0-1.82.33l-.06.06a2 2 0 1 1-2.83-2.83l.06-.06a1.65 1.65 0 0 0 .33-1.82 1.65 1.65 0 0 0-1.51-1H3a2 2 0 1 1 0-4h.09a1.65 1.65 0 0 0 1.51-1 1.65 1.65 0 0 0-.33-1.82l-.06-.06a2 2 0 1 1 2.83-2.83l.06.06a1.65 1.65 0 0 0 1.82.33H9a1.65 1.65 0 0 0 1-1.51V3a2 2 0 1 1 4 0v.09a1.65 1.65 0 0 0 1 1.51 1.65 1.65 0 0 0 1.82-.33l.06-.06a2 2 0 1 1 2.83 2.83l-.06.06a1.65 1.65 0 0 0-.33 1.82V9a1.65 1.65 0 0 0 1.51 1H21a2 2 0 1 1 0 4h-.09a1.65 1.65 0 0 0-1.51 1z"/></svg>
            </span>
            <div class="manifest-body">
              <h3>Keep your details current</h3>
              <p>Billing contact, business address, tax ID — changes apply to every future invoice.</p>
            </div>
          </li>
          <li class="manifest-item">
            <span class="manifest-num">06</span>
            <span class="manifest-icon" aria-hidden="true">
              <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="10"/><polyline points="12 6 12 12 16 14"/></svg>
            </span>
            <div class="manifest-body">
              <h3>24/7 self-service</h3>
              <p>From any device. No call queues, no email back-and-forth for routine billing tasks.</p>
            </div>
          </li>
        </ol>
      </div>
    </div>
  </section>

  <section class="content-section">
    <div class="container">
      <div class="portal-trust">
        <div class="portal-trust-icon">
          <svg width="32" height="32" viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg">
            <path d="M12 2L4 6v6c0 5 3.5 9.5 8 10 4.5-.5 8-5 8-10V6l-8-4z" stroke="currentColor" stroke-width="2" stroke-linejoin="round"/>
            <path d="M9 12l2 2 4-4" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/>
          </svg>
        </div>
        <div class="portal-trust-content">
          <h3>Hosted by Zoho. Payments by Stripe.</h3>
          <p>Your billing portal is hosted by <strong>Zoho Books</strong>, our system of record for invoices and statements. Payments are processed by <strong>Stripe</strong>, which is <strong>PCI-DSS Level 1</strong> certified — the highest level of payment-card security. FSC never sees or stores your card details.</p>
        </div>
      </div>
    </div>
  </section>
</ContentPageLayout>

<script is:inline>
  (function () {
    var toggle = document.getElementById('resendToggle');
    var form = document.getElementById('resendForm');
    var input = document.getElementById('resendEmail');
    var submitBtn = document.getElementById('resendSubmit');
    var submitLabel = submitBtn && submitBtn.querySelector('.portal-resend-submit-label');
    var status = document.getElementById('resendStatus');
    if (!toggle || !form || !input || !submitBtn || !submitLabel || !status) return;

    toggle.addEventListener('click', function () {
      toggle.hidden = true;
      form.hidden = false;
      input.focus();
    });

    form.addEventListener('submit', async function (e) {
      e.preventDefault();
      var email = (input.value || '').trim();
      if (!email) return;

      var originalLabel = submitLabel.textContent;
      submitBtn.disabled = true;
      submitLabel.textContent = 'Sending...';
      status.className = 'portal-resend-status';
      status.textContent = '';

      try {
        var res = await fetch('/api/submit', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({ formType: 'invoice-resend', email: email })
        });
        if (!res.ok) {
          var detail = 'Sorry, something went wrong.';
          try {
            var body = await res.json();
            if (body && body.error) detail = body.error;
          } catch (_) {}
          throw new Error(detail);
        }
        form.hidden = true;
        status.className = 'portal-resend-status success';
        status.textContent = '✓ Request received. Resending invoice to ' + email + '.';
      } catch (err) {
        status.className = 'portal-resend-status error';
        status.textContent =
          (err && err.message) ||
          'Sorry, something went wrong. Please email team@fightingsmartcyber.com directly.';
        submitBtn.disabled = false;
        submitLabel.textContent = originalLabel;
      }
    });
  })();
</script>

<style>
  /* ==================================================================
     CLIENT PORTAL — clean & refined
     Two light cards on top, slim resend bar below, capabilities
     manifest, trust block. No dashboard chrome, no mono accent fonts,
     no tactical metadata. Just organized, pretty, intuitive.
     ================================================================== */

  /* --- Two portal cards --------------------------------------------- */

  .portal-grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 28px;
  }

  @media (max-width: 820px) {
    .portal-grid {
      grid-template-columns: 1fr;
    }
  }

  .portal-card {
    position: relative;
    display: flex;
    flex-direction: column;
    background: var(--white);
    border: 1px solid var(--border);
    border-radius: 14px;
    padding: 40px 36px 32px;
    box-shadow: 0 4px 24px rgba(10, 37, 64, 0.05);
    transition: transform 0.25s ease, box-shadow 0.25s ease, border-color 0.25s ease;
    overflow: hidden;
  }

  .portal-card::before {
    content: '';
    position: absolute;
    top: 0;
    left: 0;
    right: 0;
    height: 4px;
    background: linear-gradient(90deg, var(--bright-blue), var(--cyan));
    opacity: 0.85;
  }

  .portal-card:hover {
    transform: translateY(-4px);
    border-color: rgba(0, 168, 255, 0.4);
    box-shadow: 0 16px 40px rgba(0, 168, 255, 0.12);
  }

  .portal-card-icon {
    width: 56px;
    height: 56px;
    border-radius: 14px;
    background: linear-gradient(135deg, rgba(0, 212, 255, 0.12), rgba(0, 168, 255, 0.08));
    border: 1px solid rgba(0, 168, 255, 0.2);
    display: flex;
    align-items: center;
    justify-content: center;
    color: var(--accent-blue);
    margin-bottom: 22px;
  }

  .portal-card-icon--alt {
    background: linear-gradient(135deg, rgba(0, 102, 204, 0.1), rgba(0, 168, 255, 0.06));
    color: var(--bright-blue);
  }

  .portal-card h2 {
    margin: 0 0 12px 0;
    font-size: 26px;
    font-weight: 800;
    color: var(--primary-blue);
    letter-spacing: -0.5px;
    line-height: 1.2;
  }

  .portal-card p {
    margin: 0 0 28px 0;
    font-size: 15.5px;
    line-height: 1.65;
    color: var(--text-light);
    flex-grow: 1;
  }

  .portal-card p strong {
    color: var(--primary-blue);
    font-weight: 600;
  }

  .portal-card-cta {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 8px;
    padding: 14px 24px;
    background: var(--bright-blue);
    color: var(--dark);
    font-weight: 600;
    font-size: 15px;
    text-decoration: none;
    border-radius: 8px;
    transition: background 0.2s ease, transform 0.15s ease, box-shadow 0.2s ease;
    align-self: flex-start;
  }

  .portal-card-cta:hover {
    background: var(--cyan);
    transform: translateY(-1px);
    box-shadow: 0 6px 18px rgba(0, 168, 255, 0.3);
  }

  .portal-card-cta svg {
    transition: transform 0.2s ease;
  }

  .portal-card-cta:hover svg {
    transform: translateX(3px);
  }

  /* --- Resend bar (slim, sits beneath the two cards) ---------------- */

  .portal-resend {
    margin-top: 24px;
    display: grid;
    grid-template-columns: 44px 1fr auto;
    align-items: center;
    gap: 20px;
    padding: 22px 28px;
    background: linear-gradient(135deg, rgba(0, 168, 255, 0.05), rgba(0, 168, 255, 0.02));
    border: 1px solid rgba(0, 168, 255, 0.18);
    border-radius: 12px;
  }

  @media (max-width: 720px) {
    .portal-resend {
      grid-template-columns: 1fr;
      gap: 16px;
      padding: 22px;
      text-align: left;
    }
  }

  .portal-resend-icon {
    width: 44px;
    height: 44px;
    border-radius: 10px;
    background: rgba(0, 168, 255, 0.1);
    border: 1px solid rgba(0, 168, 255, 0.22);
    display: flex;
    align-items: center;
    justify-content: center;
    color: var(--accent-blue);
  }

  .portal-resend-text h3 {
    margin: 0 0 2px 0;
    font-size: 17px;
    font-weight: 700;
    color: var(--primary-blue);
    letter-spacing: -0.2px;
  }

  .portal-resend-text p {
    margin: 0;
    font-size: 14px;
    line-height: 1.5;
    color: var(--text-light);
  }

  .portal-resend-action {
    min-width: 240px;
  }

  @media (max-width: 720px) {
    .portal-resend-action {
      min-width: 0;
      width: 100%;
    }
  }

  .portal-resend [hidden] {
    display: none !important;
  }

  .portal-resend-toggle,
  .portal-resend-submit {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 8px;
    padding: 11px 20px;
    font-size: 14px;
    font-weight: 600;
    border-radius: 8px;
    cursor: pointer;
    transition: background 0.2s ease, border-color 0.2s ease, color 0.2s ease, transform 0.15s ease;
    font-family: inherit;
    width: 100%;
  }

  .portal-resend-toggle {
    background: transparent;
    border: 1px solid var(--accent-blue);
    color: var(--accent-blue);
  }

  .portal-resend-toggle:hover {
    background: var(--accent-blue);
    color: var(--white);
    border-color: var(--accent-blue);
    transform: translateY(-1px);
  }

  .portal-resend-toggle svg {
    transition: transform 0.2s ease;
  }

  .portal-resend-toggle:hover svg {
    transform: translateX(2px);
  }

  .portal-resend-form {
    display: flex;
    flex-direction: column;
    gap: 8px;
  }

  .portal-resend-form input {
    padding: 11px 14px;
    border-radius: 8px;
    border: 1px solid var(--border);
    background: var(--white);
    color: var(--text);
    font-size: 14px;
    font-family: inherit;
    width: 100%;
  }

  .portal-resend-form input::placeholder {
    color: #97a4b3;
  }

  .portal-resend-form input:focus {
    outline: none;
    border-color: var(--accent-blue);
    box-shadow: 0 0 0 3px rgba(0, 102, 204, 0.15);
  }

  .portal-resend-submit {
    background: var(--bright-blue);
    color: var(--dark);
    border: 1px solid var(--bright-blue);
  }

  .portal-resend-submit:hover {
    background: var(--cyan);
    border-color: var(--cyan);
  }

  .portal-resend-status {
    margin: 8px 0 0 0;
    font-size: 13px;
    line-height: 1.5;
    color: var(--text-light);
    min-height: 1em;
  }

  .portal-resend-status.success {
    color: #1a7f37;
    font-weight: 600;
  }

  .portal-resend-status.error {
    color: #d1242f;
    font-weight: 500;
  }

  .visually-hidden {
    position: absolute;
    width: 1px;
    height: 1px;
    padding: 0;
    margin: -1px;
    overflow: hidden;
    clip: rect(0, 0, 0, 0);
    border: 0;
  }

  /* ==================================================================
     CAPABILITIES MANIFEST — single panel, numbered list
     ================================================================== */

  .manifest {
    max-width: 980px;
    margin: 0 auto;
  }

  .manifest-header {
    margin-bottom: 44px;
    padding-bottom: 28px;
    border-bottom: 1px solid rgba(10, 37, 64, 0.1);
  }

  .manifest-eyebrow {
    margin: 0 0 10px 0;
    font-size: 13px;
    letter-spacing: 2px;
    text-transform: uppercase;
    color: var(--accent-blue);
    font-weight: 700;
  }

  .manifest-title {
    margin: 0;
    font-size: 36px;
    line-height: 1.15;
    letter-spacing: -0.8px;
    color: var(--primary-blue);
    font-weight: 800;
    max-width: 22ch;
  }

  .manifest-lead {
    margin: 14px 0 0 0;
    font-size: 16px;
    line-height: 1.65;
    color: var(--text-light);
    max-width: 60ch;
  }

  .manifest-list {
    list-style: none;
    padding: 0;
    margin: 0;
  }

  .manifest-item {
    display: grid;
    grid-template-columns: 56px 56px 1fr;
    align-items: center;
    gap: 22px;
    padding: 22px 6px;
    border-bottom: 1px solid rgba(10, 37, 64, 0.08);
    transition: background 0.2s ease, padding 0.2s ease;
  }

  .manifest-item:first-of-type {
    border-top: 1px solid rgba(10, 37, 64, 0.08);
  }

  .manifest-item:hover {
    background: rgba(0, 168, 255, 0.04);
    padding-left: 16px;
    padding-right: 16px;
  }

  .manifest-num {
    font-size: 18px;
    font-weight: 700;
    color: var(--accent-blue);
    opacity: 0.55;
    text-align: center;
    letter-spacing: 0.5px;
  }

  .manifest-icon {
    width: 52px;
    height: 52px;
    border-radius: 50%;
    background: linear-gradient(135deg, rgba(0, 168, 255, 0.1), rgba(0, 102, 204, 0.04));
    border: 1px solid rgba(0, 168, 255, 0.22);
    display: flex;
    align-items: center;
    justify-content: center;
    color: var(--accent-blue);
    transition: transform 0.2s ease, color 0.2s ease, border-color 0.2s ease;
    flex-shrink: 0;
  }

  .manifest-item:hover .manifest-icon {
    transform: scale(1.06);
    color: var(--bright-blue);
    border-color: var(--bright-blue);
  }

  .manifest-body h3 {
    margin: 0 0 4px 0;
    font-size: 19px;
    font-weight: 700;
    color: var(--primary-blue);
    letter-spacing: -0.2px;
  }

  .manifest-body p {
    margin: 0;
    font-size: 14.5px;
    line-height: 1.55;
    color: var(--text-light);
    max-width: 65ch;
