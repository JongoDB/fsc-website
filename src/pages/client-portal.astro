---
import ContentPageLayout from '../layouts/ContentPageLayout.astro';
import SectionHeader from '../components/SectionHeader.astro';
import FeatureItem from '../components/FeatureItem.astro';
import { siteConfig } from '../data/navigation';

const zohoPortalUrl = siteConfig.zohoPortalUrl;
const stripePortalLoginUrl = siteConfig.stripePortalLoginUrl;
const stripeSubscriptionsLive = !stripePortalLoginUrl.includes('REPLACE_ME');
---

<ContentPageLayout
  title="Client Portal | Fighting Smart Cyber"
  description="Sign in to your Fighting Smart Cyber client portal to view invoices, accept estimates, download statements, and pay securely."
  heroTitle='Client <span class="highlight">Portal</span>'
  heroSubtitle="View invoices, accept estimates, download statements, and pay securely."
>
  <section class="content-section">
    <div class="container">
      <div class={stripeSubscriptionsLive ? 'portal-grid portal-grid-three' : 'portal-grid'}>
        <div class="portal-card portal-card-primary">
          <div class="portal-badge">Existing Customer</div>
          <h2>Sign in to your billing portal</h2>
          <p>View open and historical invoices, accept estimates, download statements, and pay securely. Hosted by Zoho Books on our custom <code>books.fightingsmartcyber.com</code> domain.</p>
          <a href={zohoPortalUrl} class="btn-primary portal-cta" target="_blank" rel="noopener">
            Sign In to Portal &rarr;
          </a>
          <p class="portal-fineprint">Sign in with the email on your account. First-time users: check your invoice email for a portal invite.</p>
        </div>

        <div class="portal-card portal-card-resend">
          <div class="portal-badge portal-badge-alt">Have an Invoice?</div>
          <h2>Pay directly from your invoice email</h2>
          <p>Every invoice we send includes a secure Stripe payment link — pay by ACH or card without signing in to anything.</p>
          <p>Misplaced it? Click below and we'll resend it.</p>

          <button type="button" class="btn-secondary portal-cta-secondary" id="resendToggle">
            Request a Resend
          </button>

          <form id="resendForm" class="portal-resend-form" hidden>
            <label for="resendEmail" class="visually-hidden">Your email address</label>
            <input type="email" id="resendEmail" name="email" placeholder="your@email.com" autocomplete="email" required />
            <button type="submit" class="btn-primary portal-resend-submit" id="resendSubmit">Send Request</button>
          </form>

          <p class="portal-resend-status" id="resendStatus" role="status" aria-live="polite"></p>
        </div>

        {stripeSubscriptionsLive && (
          <div class="portal-card portal-card-primary portal-card-stripe">
            <div class="portal-badge">Subscriptions</div>
            <h2>Manage your subscription</h2>
            <p>For recurring SaaS, training, or managed-service plans — change plans, view subscription history, or update the card or bank account on file. Hosted by Stripe on <code>portal.fightingsmartcyber.com</code>.</p>
            <a href={stripePortalLoginUrl} class="btn-primary portal-cta" target="_blank" rel="noopener">
              Open Stripe Portal &rarr;
            </a>
            <p class="portal-fineprint">A one-time sign-in link is sent to your inbox. No password required.</p>
          </div>
        )}
      </div>
    </div>
  </section>

  <section class="content-section-alt">
    <div class="container">
      <SectionHeader
        title="What you can do in the portal"
        description="Your full billing relationship with FSC, accessible from any device."
      />
      <div class="feature-grid">
        <FeatureItem
          title="View All Invoices"
          description="See every invoice — open, paid, or overdue — with current balance and due dates at a glance."
        />
        <FeatureItem
          title="Accept Estimates"
          description="Review proposed engagements and approve quotes online. Acceptance converts directly to an invoice."
        />
        <FeatureItem
          title="Pay Securely"
          description="Pay invoices by ACH or card via our Stripe-powered checkout. Receipts are emailed and stored in the portal."
        />
        <FeatureItem
          title="Download Statements"
          description="Generate full account statements on demand for your records, reconciliation, or audit."
        />
        <FeatureItem
          title="Update Your Details"
          description="Keep your billing contact, business address, and tax ID current. Changes apply to all future invoices."
        />
        <FeatureItem
          title="Self-Serve, 24/7"
          description="Manage your billing from any device, anytime. No call queues, no email back-and-forth for routine requests."
        />
      </div>
    </div>
  </section>

  <section class="content-section">
    <div class="container">
      <div class="portal-trust">
        <div class="portal-trust-icon">
          <svg width="32" height="32" viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg">
            <path d="M12 2L4 6v6c0 5 3.5 9.5 8 10 4.5-.5 8-5 8-10V6l-8-4z" stroke="currentColor" stroke-width="2" stroke-linejoin="round"/>
            <path d="M9 12l2 2 4-4" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/>
          </svg>
        </div>
        <div class="portal-trust-content">
          <h3>Hosted by Zoho. Payments by Stripe.</h3>
          <p>Your billing portal is hosted by <strong>Zoho Books</strong>, our system of record for invoices and statements. Payments are processed by <strong>Stripe</strong>, which is <strong>PCI-DSS Level 1</strong> certified — the highest level of payment-card security. FSC never sees or stores your card details.</p>
        </div>
      </div>
    </div>
  </section>
</ContentPageLayout>

<script is:inline>
  (function () {
    var toggle = document.getElementById('resendToggle');
    var form = document.getElementById('resendForm');
    var input = document.getElementById('resendEmail');
    var submitBtn = document.getElementById('resendSubmit');
    var status = document.getElementById('resendStatus');
    if (!toggle || !form || !input || !submitBtn || !status) return;

    toggle.addEventListener('click', function () {
      toggle.hidden = true;
      form.hidden = false;
      input.focus();
    });

    form.addEventListener('submit', async function (e) {
      e.preventDefault();
      var email = (input.value || '').trim();
      if (!email) return;

      var originalLabel = submitBtn.textContent;
      submitBtn.disabled = true;
      submitBtn.textContent = 'Sending...';
      status.className = 'portal-resend-status';
      status.textContent = '';

      try {
        var res = await fetch('/api/submit', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({ formType: 'invoice-resend', email: email })
        });
        if (!res.ok) {
          var detail = 'Sorry, something went wrong.';
          try {
            var body = await res.json();
            if (body && body.error) detail = body.error;
          } catch (_) {}
          throw new Error(detail);
        }
        form.hidden = true;
        status.className = 'portal-resend-status success';
        status.textContent = '✓ Request received. We’ll resend your invoice to ' + email + ' shortly.';
      } catch (err) {
        status.className = 'portal-resend-status error';
        status.textContent =
          (err && err.message) ||
          'Sorry, something went wrong. Please email team@fightingsmartcyber.com directly.';
        submitBtn.disabled = false;
        submitBtn.textContent = originalLabel;
      }
    });
  })();
</script>

<style>
  .portal-grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 28px;
    align-items: stretch;
  }

  .portal-grid-three {
    grid-template-columns: 1fr 1fr 1fr;
  }

  @media (max-width: 1100px) {
    .portal-grid-three {
      grid-template-columns: 1fr 1fr;
    }
  }

  @media (max-width: 720px) {
    .portal-grid,
    .portal-grid-three {
      grid-template-columns: 1fr;
    }
  }

  .portal-card {
    background: var(--white);
    border: 1px solid var(--border);
    border-radius: 16px;
    padding: 32px;
    box-shadow: 0 4px 20px rgba(10, 37, 64, 0.05);
    position: relative;
    display: flex;
    flex-direction: column;
  }

  .portal-card-primary {
    background: linear-gradient(135deg, #0a2540 0%, #1e4d7b 100%);
    color: var(--white);
    border-color: rgba(0, 168, 255, 0.25);
    box-shadow: 0 8px 32px rgba(10, 37, 64, 0.2);
  }

  .portal-card h2 {
    margin: 0 0 12px 0;
    font-size: 22px;
    line-height: 1.25;
    color: var(--dark);
  }

  .portal-card-primary h2 {
    color: var(--white);
  }

  .portal-card p {
    color: var(--text-light);
    line-height: 1.65;
    margin: 0 0 14px 0;
    font-size: 15px;
  }

  .portal-card-primary p {
    color: rgba(255, 255, 255, 0.85);
  }

  .portal-card code {
    background: rgba(0, 168, 255, 0.12);
    color: var(--bright-blue);
    padding: 2px 7px;
    border-radius: 4px;
    font-size: 0.9em;
    font-family: ui-monospace, 'SF Mono', Menlo, Consolas, monospace;
  }

  .portal-card-primary code {
    background: rgba(0, 212, 255, 0.18);
    color: var(--cyan);
  }

  .portal-badge {
    display: inline-block;
    background: rgba(0, 168, 255, 0.15);
    color: var(--bright-blue);
    font-size: 11px;
    font-weight: 700;
    letter-spacing: 1.2px;
    text-transform: uppercase;
    padding: 5px 12px;
    border-radius: 20px;
    margin-bottom: 12px;
    align-self: flex-start;
  }

  .portal-card-primary .portal-badge {
    background: rgba(0, 212, 255, 0.2);
    color: var(--cyan);
  }

  .portal-badge-alt {
    background: rgba(0, 102, 204, 0.1);
    color: var(--accent-blue);
  }

  .portal-cta {
    display: inline-block;
    margin-top: auto;
    margin-bottom: 14px;
    padding: 14px 24px !important;
    font-size: 15px !important;
    text-align: center;
  }

  .portal-card-primary .portal-cta {
    background: var(--bright-blue);
    color: var(--dark) !important;
  }

  .portal-card-primary .portal-cta:hover {
    background: var(--cyan);
  }

  .portal-cta-secondary {
    margin-top: auto;
    padding: 12px 22px !important;
    font-size: 14px !important;
  }

  /* .btn-secondary is white-on-transparent by default (designed for dark
     hero backgrounds); restyle when used inside the light resend card. */
  .portal-card:not(.portal-card-primary) .portal-cta-secondary {
    color: var(--accent-blue);
    border-color: var(--accent-blue);
  }

  .portal-card:not(.portal-card-primary) .portal-cta-secondary:hover {
    background: var(--accent-blue);
    color: var(--white);
    border-color: var(--accent-blue);
  }

  .portal-fineprint {
    font-size: 12.5px;
    color: rgba(255, 255, 255, 0.55) !important;
    margin: 0 !important;
    line-height: 1.5;
  }

  /* HTML `hidden` attribute is overridden by .btn-secondary's inline-block
     display; force it for the resend toggle + form. */
  .portal-card-resend [hidden] {
    display: none !important;
  }

  /* Inline resend form (revealed when "Request a Resend" is clicked) */
  .portal-resend-form {
    margin-top: auto;
    display: flex;
    flex-direction: column;
    gap: 10px;
  }

  .portal-resend-form input {
    padding: 11px 14px;
    border-radius: 6px;
    border: 1px solid var(--border);
    font-size: 14px;
    width: 100%;
    font-family: inherit;
    color: var(--text);
    background: var(--white);
  }

  .portal-resend-form input:focus {
    outline: none;
    border-color: var(--accent-blue);
    box-shadow: 0 0 0 3px rgba(0, 102, 204, 0.15);
  }

  .portal-resend-submit {
    padding: 11px 18px !important;
    font-size: 14px !important;
  }

  .portal-resend-status {
    margin: 10px 0 0 0 !important;
    font-size: 13px;
    color: var(--text-light);
    line-height: 1.5;
    min-height: 1px;
  }

  .portal-resend-status.success {
    color: #1a7f37;
    font-weight: 600;
  }

  .portal-resend-status.error {
    color: #d1242f;
    font-weight: 500;
  }

  .visually-hidden {
    position: absolute;
    width: 1px;
    height: 1px;
    padding: 0;
    margin: -1px;
    overflow: hidden;
    clip: rect(0, 0, 0, 0);
    border: 0;
  }

  .portal-trust {
    display: grid;
    grid-template-columns: 60px 1fr;
    gap: 24px;
    align-items: start;
    max-width: 880px;
    margin: 0 auto;
    padding: 32px;
    background: rgba(0, 168, 255, 0.04);
    border: 1px solid rgba(0, 168, 255, 0.18);
    border-radius: 16px;
  }

  @media (max-width: 640px) {
    .portal-trust {
      grid-template-columns: 1fr;
      text-align: center;
      padding: 24px;
    }
  }

  .portal-trust-icon {
    width: 60px;
    height: 60px;
    background: rgba(0, 168, 255, 0.12);
    border-radius: 14px;
    display: flex;
    align-items: center;
    justify-content: center;
    color: var(--bright-blue);
  }

  @media (max-width: 640px) {
    .portal-trust-icon {
      margin: 0 auto;
    }
  }

  .portal-trust-content h3 {
    margin: 0 0 8px 0;
    font-size: 20px;
    color: var(--dark);
  }

  .portal-trust-content p {
    margin: 0;
    color: var(--text-light);
    line-height: 1.7;
  }

  .portal-trust-content code {
    background: rgba(0, 168, 255, 0.12);
    color: var(--bright-blue);
    padding: 2px 7px;
    border-radius: 4px;
    font-size: 0.9em;
    font-family: ui-monospace, 'SF Mono', Menlo, Consolas, monospace;
  }
</style>
