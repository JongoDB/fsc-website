---
import ContentPageLayout from '../layouts/ContentPageLayout.astro';
import SectionHeader from '../components/SectionHeader.astro';
import FeatureItem from '../components/FeatureItem.astro';
import { siteConfig } from '../data/navigation';

const zohoPortalUrl = siteConfig.zohoPortalUrl;
const stripePortalLoginUrl = siteConfig.stripePortalLoginUrl;
const stripeSubscriptionsLive = !stripePortalLoginUrl.includes('REPLACE_ME');
---

<ContentPageLayout
  title="Client Portal | Fighting Smart Cyber"
  description="Sign in to your Fighting Smart Cyber client portal to view invoices, accept estimates, manage recurring payments, and pay securely."
  heroTitle='Client <span class="highlight">Portal</span>'
  heroSubtitle="View invoices, accept estimates, manage recurring payments, and pay securely."
>
  <section class="content-section">
    <div class="container">

      <!-- Two portal sign-in tiles, side by side -->
      <div class="portal-grid">
        <div class="portal-card portal-card-billing">
          <div class="portal-icon">
            <svg width="26" height="26" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
              <path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"/>
              <polyline points="14 2 14 8 20 8"/>
              <line x1="8" y1="13" x2="16" y2="13"/>
              <line x1="8" y1="17" x2="13" y2="17"/>
            </svg>
          </div>
          <div class="portal-eyebrow">Existing Customer</div>
          <h2>Sign in to your billing portal</h2>
          <p>View open and historical invoices, accept estimates, download statements, and pay securely. Hosted by Zoho Books on <code>books.fightingsmartcyber.com</code>.</p>
          <a href={zohoPortalUrl} class="btn-primary portal-cta" target="_blank" rel="noopener">
            Sign In to Portal &rarr;
          </a>
          <p class="portal-fineprint">Sign in with the email on your account. First-time users: check your invoice email for a portal invite.</p>
        </div>

        {stripeSubscriptionsLive && (
          <div class="portal-card portal-card-recurring">
            <div class="portal-icon">
              <svg width="26" height="26" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                <polyline points="23 4 23 10 17 10"/>
                <polyline points="1 20 1 14 7 14"/>
                <path d="M3.51 9a9 9 0 0 1 14.85-3.36L23 10M1 14l4.64 4.36A9 9 0 0 0 20.49 15"/>
              </svg>
            </div>
            <div class="portal-eyebrow">Recurring Payments</div>
            <h2>Manage your recurring payments</h2>
            <p>For any monthly, quarterly, annual, or other recurring payment plan — change your subscription, view payment history, or update the card or bank account on file. Hosted by Stripe on <code>portal.fightingsmartcyber.com</code>.</p>
            <a href={stripePortalLoginUrl} class="btn-primary portal-cta" target="_blank" rel="noopener">
              Open Stripe Portal &rarr;
            </a>
            <p class="portal-fineprint">A one-time sign-in link is sent to your inbox. No password required.</p>
          </div>
        )}
      </div>

      <!-- Full-width "request a resend" tile beneath the portal tiles -->
      <div class="portal-card portal-card-resend">
        <div class="portal-resend-inner">
          <div class="portal-resend-text">
            <div class="portal-icon">
              <svg width="26" height="26" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                <rect x="2" y="4" width="20" height="16" rx="2"/>
                <polyline points="22 6 12 13 2 6"/>
              </svg>
            </div>
            <div class="portal-eyebrow">Have an Invoice?</div>
            <h2>Pay directly from your invoice email</h2>
            <p>Every invoice we send includes a secure Stripe payment link — pay by ACH or card without signing in to anything. Misplaced it? Drop your email and we'll resend it.</p>
          </div>
          <div class="portal-resend-action">
            <button type="button" class="btn-secondary portal-cta-secondary" id="resendToggle">
              Request a Resend
            </button>
            <form id="resendForm" class="portal-resend-form" hidden>
              <label for="resendEmail" class="visually-hidden">Your email address</label>
              <input type="email" id="resendEmail" name="email" placeholder="your@email.com" autocomplete="email" required />
              <button type="submit" class="btn-primary portal-resend-submit" id="resendSubmit">Send Request</button>
            </form>
            <p class="portal-resend-status" id="resendStatus" role="status" aria-live="polite"></p>
          </div>
        </div>
      </div>

    </div>
  </section>

  <section class="content-section-alt">
    <div class="container">
      <SectionHeader
        title="What you can do in the portal"
        description="Your full billing relationship with FSC, accessible from any device."
      />
      <div class="feature-grid">
        <FeatureItem
          title="View All Invoices"
          description="See every invoice — open, paid, or overdue — with current balance and due dates at a glance."
        />
        <FeatureItem
          title="Accept Estimates"
          description="Review proposed engagements and approve quotes online. Acceptance converts directly to an invoice."
        />
        <FeatureItem
          title="Pay Securely"
          description="Pay invoices by ACH or card via our Stripe-powered checkout. Receipts are emailed and stored in the portal."
        />
        <FeatureItem
          title="Download Statements"
          description="Generate full account statements on demand for your records, reconciliation, or audit."
        />
        <FeatureItem
          title="Update Your Details"
          description="Keep your billing contact, business address, and tax ID current. Changes apply to all future invoices."
        />
        <FeatureItem
          title="Self-Serve, 24/7"
          description="Manage your billing from any device, anytime. No call queues, no email back-and-forth for routine requests."
        />
      </div>
    </div>
  </section>

  <section class="content-section">
    <div class="container">
      <div class="portal-trust">
        <div class="portal-trust-icon">
          <svg width="32" height="32" viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg">
            <path d="M12 2L4 6v6c0 5 3.5 9.5 8 10 4.5-.5 8-5 8-10V6l-8-4z" stroke="currentColor" stroke-width="2" stroke-linejoin="round"/>
            <path d="M9 12l2 2 4-4" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/>
          </svg>
        </div>
        <div class="portal-trust-content">
          <h3>Hosted by Zoho. Payments by Stripe.</h3>
          <p>Your billing portal is hosted by <strong>Zoho Books</strong>, our system of record for invoices and statements. Payments are processed by <strong>Stripe</strong>, which is <strong>PCI-DSS Level 1</strong> certified — the highest level of payment-card security. FSC never sees or stores your card details.</p>
        </div>
      </div>
    </div>
  </section>
</ContentPageLayout>

<script is:inline>
  (function () {
    var toggle = document.getElementById('resendToggle');
    var form = document.getElementById('resendForm');
    var input = document.getElementById('resendEmail');
    var submitBtn = document.getElementById('resendSubmit');
    var status = document.getElementById('resendStatus');
    if (!toggle || !form || !input || !submitBtn || !status) return;

    toggle.addEventListener('click', function () {
      toggle.hidden = true;
      form.hidden = false;
      input.focus();
    });

    form.addEventListener('submit', async function (e) {
      e.preventDefault();
      var email = (input.value || '').trim();
      if (!email) return;

      var originalLabel = submitBtn.textContent;
      submitBtn.disabled = true;
      submitBtn.textContent = 'Sending...';
      status.className = 'portal-resend-status';
      status.textContent = '';

      try {
        var res = await fetch('/api/submit', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({ formType: 'invoice-resend', email: email })
        });
        if (!res.ok) {
          var detail = 'Sorry, something went wrong.';
          try {
            var body = await res.json();
            if (body && body.error) detail = body.error;
          } catch (_) {}
          throw new Error(detail);
        }
        form.hidden = true;
        status.className = 'portal-resend-status success';
        status.textContent = '✓ Request received. We’ll resend your invoice to ' + email + ' shortly.';
      } catch (err) {
        status.className = 'portal-resend-status error';
        status.textContent =
          (err && err.message) ||
          'Sorry, something went wrong. Please email team@fightingsmartcyber.com directly.';
        submitBtn.disabled = false;
        submitBtn.textContent = originalLabel;
      }
    });
  })();
</script>

<style>
  /* ------------------------------------------------------------------
     Two portal tiles on top (Billing · Recurring), one full-width
     resend tile below. All cards share the same dark navy brand base;
     differentiation comes from icons, eyebrow text, and a thin top
     accent stripe.
     ------------------------------------------------------------------ */

  .portal-grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 28px;
    align-items: stretch;
  }

  @media (max-width: 720px) {
    .portal-grid {
      grid-template-columns: 1fr;
    }
  }

  .portal-card {
    position: relative;
    display: flex;
    flex-direction: column;
    background: linear-gradient(155deg, #0a2540 0%, #0d2e52 55%, #1e4d7b 100%);
    color: var(--white);
    border: 1px solid rgba(0, 168, 255, 0.22);
    border-radius: 16px;
    padding: 32px;
    box-shadow: 0 10px 30px rgba(10, 37, 64, 0.28);
    overflow: hidden;
    transition: transform 0.25s ease, box-shadow 0.25s ease, border-color 0.25s ease;
  }

  .portal-card:hover {
    transform: translateY(-2px);
    border-color: rgba(0, 168, 255, 0.45);
    box-shadow: 0 16px 40px rgba(0, 168, 255, 0.18);
  }

  /* Resend card sits below the grid and spans full width */
  .portal-card-resend {
    margin-top: 28px;
  }

  /* Per-card top accent stripe — subtle differentiator. */
  .portal-card::before {
    content: '';
    position: absolute;
    top: 0;
    left: 0;
    right: 0;
    height: 3px;
    background: linear-gradient(90deg, var(--cyan) 0%, var(--bright-blue) 100%);
    opacity: 0.9;
  }

  .portal-card-recurring::before {
    background: linear-gradient(90deg, var(--accent-blue) 0%, var(--cyan) 100%);
  }

  .portal-card-resend::before {
    background: linear-gradient(90deg, var(--bright-blue) 0%, var(--accent-blue) 100%);
  }

  /* Icon block (top of card) */
  .portal-icon {
    width: 46px;
    height: 46px;
    border-radius: 12px;
    display: flex;
    align-items: center;
    justify-content: center;
    color: var(--cyan);
    background: rgba(0, 212, 255, 0.1);
    border: 1px solid rgba(0, 212, 255, 0.22);
    margin-bottom: 18px;
    flex-shrink: 0;
  }

  .portal-card-resend .portal-icon {
    color: var(--bright-blue);
    background: rgba(0, 168, 255, 0.12);
    border-color: rgba(0, 168, 255, 0.28);
  }

  .portal-card-recurring .portal-icon {
    color: var(--cyan);
    background: rgba(0, 212, 255, 0.08);
    border-color: rgba(0, 212, 255, 0.2);
  }

  /* Eyebrow label */
  .portal-eyebrow {
    font-size: 11px;
    font-weight: 700;
    letter-spacing: 1.4px;
    text-transform: uppercase;
    color: var(--cyan);
    margin-bottom: 8px;
  }

  .portal-card-resend .portal-eyebrow {
    color: var(--bright-blue);
  }

  /* Typography inside card */
  .portal-card h2 {
    margin: 0 0 12px 0;
    font-size: 22px;
    line-height: 1.25;
    color: var(--white);
    font-weight: 700;
    letter-spacing: -0.2px;
  }

  .portal-card p {
    color: rgba(255, 255, 255, 0.82);
    line-height: 1.65;
    margin: 0 0 14px 0;
    font-size: 15px;
  }

  .portal-card code {
    background: rgba(0, 212, 255, 0.16);
    color: var(--cyan);
    padding: 2px 7px;
    border-radius: 4px;
    font-size: 0.88em;
    font-family: ui-monospace, 'SF Mono', Menlo, Consolas, monospace;
  }

  /* CTAs */
  .portal-cta {
    display: inline-block;
    margin-top: auto;
    margin-bottom: 14px;
    padding: 13px 22px !important;
    font-size: 15px !important;
    text-align: center;
    background: var(--bright-blue) !important;
    color: var(--dark) !important;
    border-radius: 8px;
  }

  .portal-cta:hover {
    background: var(--cyan) !important;
  }

  /* Secondary toggle (Request a Resend) on dark card */
  .portal-cta-secondary {
    padding: 12px 22px !important;
    font-size: 14px !important;
    background: transparent !important;
    color: var(--cyan) !important;
    border: 1px solid rgba(0, 212, 255, 0.45) !important;
    width: 100%;
  }

  .portal-cta-secondary:hover {
    background: rgba(0, 212, 255, 0.1) !important;
    border-color: var(--cyan) !important;
    color: var(--cyan) !important;
  }

  .portal-fineprint {
    font-size: 12.5px;
    color: rgba(255, 255, 255, 0.55) !important;
    margin: 0 !important;
    line-height: 1.5;
  }

  /* ------------------------------------------------------------------
     Resend card internal layout — horizontal at desktop, stacked on
     narrow viewports.
     ------------------------------------------------------------------ */

  .portal-resend-inner {
    display: grid;
    grid-template-columns: 1fr 320px;
    gap: 40px;
    align-items: center;
  }

  .portal-resend-text {
    display: flex;
    flex-direction: column;
  }

  .portal-resend-text p {
    margin-bottom: 0;
    max-width: 620px;
  }

  .portal-resend-action {
    width: 100%;
  }

  @media (max-width: 860px) {
    .portal-resend-inner {
      grid-template-columns: 1fr;
      gap: 22px;
    }
    .portal-resend-text p {
      max-width: none;
    }
  }

  /* HTML `hidden` is overridden by btn display rules — force it for
     the resend toggle + form. */
  .portal-card-resend [hidden] {
    display: none !important;
  }

  /* Inline resend form (revealed when "Request a Resend" is clicked) */
  .portal-resend-form {
    display: flex;
    flex-direction: column;
    gap: 10px;
  }

  .portal-resend-form input {
    padding: 12px 14px;
    border-radius: 6px;
    border: 1px solid rgba(255, 255, 255, 0.18);
    background: rgba(255, 255, 255, 0.06);
    color: var(--white);
    font-size: 14px;
    width: 100%;
    font-family: inherit;
  }

  .portal-resend-form input::placeholder {
    color: rgba(255, 255, 255, 0.45);
  }

  .portal-resend-form input:focus {
    outline: none;
    border-color: var(--cyan);
    background: rgba(255, 255, 255, 0.1);
    box-shadow: 0 0 0 3px rgba(0, 212, 255, 0.18);
  }

  .portal-resend-submit {
    padding: 12px 18px !important;
    font-size: 14px !important;
    background: var(--bright-blue) !important;
    color: var(--dark) !important;
    width: 100%;
  }

  .portal-resend-submit:hover {
    background: var(--cyan) !important;
  }

  .portal-resend-status {
    margin: 12px 0 0 0 !important;
    font-size: 13px;
    color: rgba(255, 255, 255, 0.7);
    line-height: 1.5;
    min-height: 1px;
  }

  .portal-resend-status.success {
    color: var(--cyan);
    font-weight: 600;
  }

  .portal-resend-status.error {
    color: #ff6b6b;
    font-weight: 500;
  }

  .visually-hidden {
    position: absolute;
    width: 1px;
    height: 1px;
    padding: 0;
    margin: -1px;
    overflow: hidden;
    clip: rect(0, 0, 0, 0);
    border: 0;
  }

  /* ------------------------------------------------------------------
     Trust block (unchanged section)
     ------------------------------------------------------------------ */

  .portal-trust {
    display: grid;
    grid-template-columns: 60px 1fr;
    gap: 24px;
    align-items: start;
    max-width: 880px;
    margin: 0 auto;
    padding: 32px;
    background: rgba(0, 168, 255, 0.04);
    border: 1px solid rgba(0, 168, 255, 0.18);
    border-radius: 16px;
  }

  @media (max-width: 640px) {
    .portal-trust {
      grid-template-columns: 1fr;
      text-align: center;
      padding: 24px;
    }
  }

  .portal-trust-icon {
    width: 60px;
    height: 60px;
    background: rgba(0, 168, 255, 0.12);
    border-radius: 14px;
    display: flex;
    align-items: center;
    justify-content: center;
    color: var(--bright-blue);
  }

  @media (max-width: 640px) {
    .portal-trust-icon {
      margin: 0 auto;
    }
  }

  .portal-trust-content h3 {
    margin: 0 0 8px 0;
    font-size: 20px;
    color: var(--dark);
  }

  .portal-trust-content p {
    margin: 0;
    color: var(--text-light);
    line-height: 1.7;
  }

  .portal-trust-content code {
    background: rgba(0, 168, 255, 0.12);
    color: var(--bright-blue);
    padding: 2px 7px;
    border-radius: 4px;
    font-size: 0.9em;
    font-family: ui-monospace, 'SF Mono', Menlo, Consolas, monospace;
  }
</style>
