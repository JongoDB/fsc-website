---
import BaseLayout from './BaseLayout.astro';
import Hero from '../components/Hero.astro';
import CTASection from '../components/CTASection.astro';

interface Props {
  title: string;
  description: string;
  heroTitle: string;
  heroSubtitle: string;
  ctaTitle?: string;
  ctaDescription?: string;
  ctaPrimaryButton?: { text: string; href: string };
  ctaSecondaryButton?: { text: string; href: string };
}

const {
  title,
  description,
  heroTitle,
  heroSubtitle,
  ctaTitle,
  ctaDescription,
  ctaPrimaryButton,
  ctaSecondaryButton
} = Astro.props;
---

<BaseLayout title={title} description={description} includeAnimations={false}>
  <Hero title={heroTitle} subtitle={heroSubtitle} compact={true} />

  <slot />

  {ctaTitle && ctaDescription && (
    <CTASection
      title={ctaTitle}
      description={ctaDescription}
      primaryButton={ctaPrimaryButton}
      secondaryButton={ctaSecondaryButton}
    />
  )}
</BaseLayout>
